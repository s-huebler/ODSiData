# Choosing subsamples

-   Filter for ASV which appear in more than 10% of samples and in at least 2 studies

    ```{r}
    ps_01 <- filter_by_prevalence(0.1, ps)

    otu_mat <- as(otu_table(ps_01), "matrix")
    if (taxa_are_rows(ps_01)) otu_mat <- t(otu_mat)

    study <- as.character(sample_data(ps_01)$study)

    n_studies_per_asv <- apply(otu_mat > 0, 2, function(present){
      sum(tapply(present, study, any))
    })

    ps_02 <- prune_taxa(names(n_studies_per_asv)[n_studies_per_asv>=2], ps_01)
    ```

-   Filter for when agvhd is a known outcome

    ```{r}
    ps_03 <- subset_samples(ps_02, agvhd %in% c(0,1))
    ```

-   Choose all timepoints pre-graftment

    ```{r}
    ps_04 <- subset_samples(ps_03, timepoint %in% c("pre-conditioning", "transplant", "pre-engraftment", "conditioning"))
    ```

-   Clean

    ```{r}
    ps_filtered <- prune_taxa(taxa_sums(ps_04)>0, ps_04)
    ```

## Agglomerate to higher taxonomic ranks

Each rank is collapsed from the full unfiltered table `ps` and then put through the same filters as the ASV table. Collapsing `ps_filtered` instead would undercount every genus by the reads of its rare ASVs that the prevalence filter removed. A parent taxon is always at least as prevalent (and present in at least as many studies) as any of its members, so every ASV in `ps_filtered` keeps its genus, family, and so on through filtering, and the lineage join further down never hits a missing parent. Samples are restricted to those in `ps_filtered` so every rank is modeled on the identical analytic sample set.

```{r}
# Same steps as the bullets above, as a function so they can be applied per rank
analytic_filter <- function(x, keep_samples = NULL) {
  x <- filter_by_prevalence(0.1, x)

  m <- as(otu_table(x), "matrix")
  if (taxa_are_rows(x)) m <- t(m)
  st   <- as.character(sample_data(x)$study)
  n_st <- apply(m > 0, 2, function(p) sum(tapply(p, st, any)))
  x <- prune_taxa(names(n_st)[n_st >= 2], x)

  x <- subset_samples(x, agvhd %in% c(0, 1))
  x <- subset_samples(x, timepoint %in% c("pre-conditioning", "transplant",
                                          "pre-engraftment", "conditioning"))
  if (!is.null(keep_samples))
    x <- prune_samples(intersect(sample_names(x), keep_samples), x)
  prune_taxa(taxa_sums(x) > 0, x)
}

# Drift guard: the function must reproduce the ASV-level filtering exactly
stopifnot(setequal(taxa_names(analytic_filter(ps)), taxa_names(ps_filtered)))

ranks_to_test <- c("Species", "Genus", "Family", "Order", "Class", "Phylum")
rank_levels   <- c("ASV", ranks_to_test)

ps_by_rank <- c(
  list(ASV = ps_filtered),
  lapply(setNames(ranks_to_test, ranks_to_test), function(r)
    analytic_filter(agglomerate_rank(ps, r),
                    keep_samples = sample_names(ps_filtered)))
)

# ASV -> taxon label at every rank (labels match taxa_names(ps_by_rank[[r]]))
lineage <- lineage_labels(ps_filtered, ranks_to_test)

sapply(ps_by_rank, ntaxa)
sapply(ps_by_rank, nsamples)
```

```{r}
rm(ps, ps_01, ps_02, ps_03, ps_04)
gc()
```

