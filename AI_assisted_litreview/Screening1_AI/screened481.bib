	pages = {822-834},
	publisher = {Massachusetts Medical Society},
	doi = {10.1056/nejmoa1900623},
	pmid = {32101664},
	pmcid = {PMC7534690},
	url = {http://dx.doi.org/10.1056/nejmoa1900623},
	abstract = {Background Relationships between microbiota composition and clinical outcomes after allogeneic hematopoietic-cell transplantation have been described in single-center studies. Geographic v... Deleterious Alterations in the Microbiota in Allogeneic HCT In this study, the gastrointestinal microbiome was serially monitored in patients undergoing allogeneic hematopoietic-cell transplantatio...},
