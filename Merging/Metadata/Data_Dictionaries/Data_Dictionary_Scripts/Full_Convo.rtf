   library(readxl)                                                                \
   library(readr)\
   library(dplyr)                                                                 \
                                                                                \
   # Set working directory\
   setwd("/Users/sophiehuebler/Documents/ODSi/ODSiData")\
\
   cat(strrep("=", 80), "\\n")\
   cat("STEP 1: READ EXCEL DATA DICTIONARY SHEETS\\n")\
   cat(strrep("=", 80), "\\n\\n")\
\
   # Get sheet names\
   path <- "Merging/data_dictionaries.xlsx"\
   sheets <- excel_sheets(path)\
   cat("Available sheets:\\n")\
   print(sheets)\
   cat("\\n\\n")\
\
   # Define target sheets\
   target_sheets <- c("Artacho2024", "DAmico2019", "Liu2017", "Vallet2023")\
\
   # Keywords to search for\
   keywords <- c("Myelosuppression", "Mucositis", "BSI", "bos", "infection",\
   "bloodstream")\
\
   for (sheet_name in target_sheets) \{\
     cat("\\n", strrep("=", 80), "\\n")\
     cat("Sheet:", sheet_name, "\\n")\
     cat(strrep("=", 80), "\\n")\
\
     df <- read_excel(path, sheet = sheet_name)\
\
     # Create regex pattern (case-insensitive)\
     pattern <- paste(keywords, collapse = "|")\
\
     # Find matching rows\
     matches <- df %>%\
       filter(if_any(everything(), ~grepl(pattern, ., ignore.case = TRUE)))\
\
     if (nrow(matches) > 0) \{\
       cat("\\nMatching rows found:\\n")\
       print(as.data.frame(matches), row.names = TRUE)\
     \} else \{\
       cat("\\nNo matching rows found.\\n")\
     \}\
     cat("\\n")\
   \}\
\
   cat("\\n\\n")\
   cat(strrep("=", 80), "\\n")\
   cat("STEP 2: CROSS-TABULATE SOURCE COLUMNS\\n")\
   cat(strrep("=", 80), "\\n\\n")\
\
   # ARTACHO2024\
   cat("\\n### ARTACHO2024 ###\\n")\
   cat("File: Artacho2024/Metadata/artacho_meta_qiime.tsv\\n\\n")\
   artacho <- read_tsv("Artacho2024/Metadata/artacho_meta_qiime.tsv")\
\
   cat("table(Myelosuppression):\\n")\
   if ("Myelosuppression" %in% colnames(artacho)) \{\
     print(table(artacho$Myelosuppression, useNA = "always"))\
   \} else \{\
     cat("Column 'Myelosuppression' not found.\\n")\
     cat("Available columns:", paste(colnames(artacho), collapse = ", "), "\\n")\
   \}\
\
   cat("\\ntable(Mucositis):\\n")\
   if ("Mucositis" %in% colnames(artacho)) \{\
     print(table(artacho$Mucositis, useNA = "always"))\
   \} else \{\
     cat("Column 'Mucositis' not found.\\n")\
   \}\
\
   # DAMICO2019\
   cat("\\n\\n### DAMICO2019 ###\\n")\
   cat("File: DAmico2019/Metadata/damico_meta_qiime.tsv\\n\\n")\
   damico <- read_tsv("DAmico2019/Metadata/damico_meta_qiime.tsv")\
\
   cat("table(Mucositis_grade, useNA='always'):\\n")\
   if ("Mucositis_grade" %in% colnames(damico)) \{\
     print(table(damico$Mucositis_grade, useNA = "always"))\
   \} else \{\
     cat("Column 'Mucositis_grade' not found.\\n")\
     cat("Available columns:", paste(colnames(damico), collapse = ", "), "\\n")\
   \}\
\
   cat("\\ntable(is.na(BSI)):\\n")\
   if ("BSI" %in% colnames(damico)) \{\
     print(table(is.na(damico$BSI), useNA = "always"))\
     cat("\\nDistinct non-NA values of BSI:\\n")\
     non_na_values <- na.omit(damico$BSI)\
     if (length(non_na_values) > 0) \{\
       print(unique(non_na_values))\
     \} else \{\
       cat("All values are NA.\\n")\
     \}\
   \} else \{\
     cat("Column 'BSI' not found.\\n")\
   \}\
\
   # LIU2017\
   cat("\\n\\n### LIU2017 ###\\n")\
   cat("File: Liu2017/Metadata/liu_meta_qiime.tsv\\n\\n")\
   liu <- read_tsv("Liu2017/Metadata/liu_meta_qiime.tsv")\
\
   cat("Distinct values of infection_duringafter_transplant (donor_or_patient\
   == 'patient'):\\n")\
   if ("infection_duringafter_transplant" %in% colnames(liu) &&\
   "donor_or_patient" %in% colnames(liu)) \{\
     patients <- liu %>% filter(donor_or_patient == "patient")\
     distinct_vals <- patients %>%\
       select(infection_duringafter_transplant) %>%\
       table(useNA = "always")\
     print(distinct_vals)\
   \} else \{\
     cat("Required columns not found.\\n")\
   \}\
\
   cat("\\n\\nDistinct values of infection_details (donor_or_patient ==\
   'patient'):\\n")\
   if ("infection_details" %in% colnames(liu) && "donor_or_patient" %in%\
   colnames(liu)) \{\
     patients <- liu %>% filter(donor_or_patient == "patient")\
     distinct_vals <- patients %>%\
       select(infection_details) %>%\
       table(useNA = "always")\
     print(distinct_vals)\
   \} else \{\
     cat("Required columns not found.\\n")\
   \}\
\
   cat("\\n\\nCross-tabulation of infection_duringafter_transplant and\
   infection_details (recipients):\\n")\
   if ("infection_duringafter_transplant" %in% colnames(liu) &&\
   "infection_details" %in% colnames(liu) && "donor_or_patient" %in%\
   colnames(liu)) \{\
     patients <- liu %>% filter(donor_or_patient == "patient")\
\
     both_empty <- patients %>%\
       filter(is.na(infection_duringafter_transplant) &\
   is.na(infection_details)) %>%\
       nrow()\
\
     only_infection_during <- patients %>%\
       filter(!is.na(infection_duringafter_transplant) &\
   is.na(infection_details)) %>%\
       nrow()\
\
     only_infection_details <- patients %>%\
       filter(is.na(infection_duringafter_transplant) &\
   !is.na(infection_details)) %>%\
       nrow()\
\
     both_populated <- patients %>%\
       filter(!is.na(infection_duringafter_transplant) &\
   !is.na(infection_details)) %>%\
       nrow()\
\
     cat("Both empty/NA:", both_empty, "\\n")\
     cat("Only infection_duringafter_transplant populated:",\
   only_infection_during, "\\n")\
     cat("Only infection_details populated:", only_infection_details, "\\n")\
     cat("Both populated:", both_populated, "\\n")\
     cat("Total patient rows:", nrow(patients), "\\n")\
   \} else \{\
     cat("Required columns not found.\\n")\
   \}\
\
   # VALLET2023\
   cat("\\n\\n### VALLET2023 ###\\n")\
   cat("File: Vallet2023/Metadata/vallet_meta_qiime.tsv\\n\\n")\
   vallet <- read_tsv("Vallet2023/Metadata/vallet_meta_qiime.tsv")\
