   samp_na <- ig_samp[is.na(ig_samp\\$TBI), ]\
   cat('n samples:', nrow(samp_na), '\\n')\
   cat('Irrad distribution:\\n')\
   print(table(samp_na\\$Irrad, useNA='always'))\
\
   # Serotherapy\
   cat('\\n=== Ingham serotherapy (ATG or Ab) per patient ===\\n')\
   sero <- ig_pt\\$X197ATGmm == 1 | ig_pt\\$X10Ab == 1\
   print(table(sero, useNA='always'))\
   cat('\\nCross-tab ATG x Ab:\\n')\
   print(table(ATG=ig_pt\\$X197ATGmm, Ab=ig_pt\\$X10Ab, useNA='always'))\
\
   # Liu - check ATG parsing\
