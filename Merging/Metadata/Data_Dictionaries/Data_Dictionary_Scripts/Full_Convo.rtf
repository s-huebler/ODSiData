   cat("table(bos, useNA='always'):\\n")\
   if ("bos" %in% colnames(vallet)) \{\
     print(table(vallet$bos, useNA = "always"))\
   \} else \{\
     cat("Column 'bos' not found.\\n")\
     cat("Available columns:", paste(colnames(vallet), collapse = ", "), "\\n")\
   \}\
