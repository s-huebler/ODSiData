   Rscript -e "                                                                 \
   library(readr)\
   options(width=200)\
\
   # Ingham - build expected regimen strings per patient\
   ig <- read_tsv('Ingham2019/Metadata/ingham_meta_qiime.tsv',\
   show_col_types=FALSE, name_repair='minimal')\
   ig_pt <- ig[!duplicated(ig\\$patient) & !is.na(ig\\$patient), ]\
\
   # Drug presence per patient\
   bu  <- ig_pt\\$X233Bu %in% c(1,2)\
   cy  <- !is.na(ig_pt\\$X270Cyclo) & ig_pt\\$X270Cyclo == 1\
   flu <- !is.na(ig_pt[['X284.2Fludarab']]) & ig_pt[['X284.2Fludarab']] == 1\
   mel <- !is.na(ig_pt[['Total.dose.melphalan..mg.']]) &\
   as.numeric(ig_pt[['Total.dose.melphalan..mg.']]) > 0\
   vp  <- !is.na(ig_pt[['Total.dose.VP16..mg.']]) &\
   as.numeric(ig_pt[['Total.dose.VP16..mg.']]) > 0\
   thio<- !is.na(ig_pt[['Total.dose.thiotepa..mg.']]) &\
   as.numeric(ig_pt[['Total.dose.thiotepa..mg.']]) > 0\
\
   regimens <- mapply(function(b,c,f,m,v,t) \{\
     tokens <- c(if(b)'bu', if(c)'cy', if(f)'flu', if(m)'mel', if(v)'vp16',\
   if(t)'thio')\
     if(length(tokens)==0) return(NA_character_)\
     paste(sort(tokens), collapse='/')\
   \}, bu, cy, flu, mel, vp, thio)\
\
   cat('=== Ingham regimen distribution (by patient) ===\\n')\
   print(sort(table(regimens, useNA='always'), decreasing=TRUE))\
\
   cat('\\n=== Ingham TBI details (by patient) ===\\n')\
   tbi_vals <- ig_pt\\$TBI\
   irrad_vals <- ig_pt\\$Irrad\
   dose_tbi <- as.numeric(ig_pt[['Total.dose.of.TBI.in.cGy']])\
   frac <- ig_pt\\$FracTBI\
   cat('TBI x FracTBI x dose:\\n')\
   print(data.frame(patient=ig_pt\\$patient, Irrad=irrad_vals, TBI=tbi_vals,\
   dose_cGy=dose_tbi, FracTBI=frac)[!is.na(tbi_vals) & tbi_vals==1,])\
\
   cat('\\n=== Ingham TBI=NA rows (check Irrad) ===\\n')\
   na_rows <- ig_pt[is.na(ig_pt\\$TBI), ]\
   cat('n patients with TBI=NA:', nrow(na_rows), '\\n')\
   cat('Irrad for those patients:\\n')\
   print(table(na_rows\\$Irrad, useNA='always'))\
   " 2>/dev/null\
