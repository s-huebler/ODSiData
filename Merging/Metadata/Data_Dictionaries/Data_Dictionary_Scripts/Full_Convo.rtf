   # TBI recovery: TBI=NA but Irrad=0 \uc0\u8594  TBI must be 0\
   tbi_effective <- ig\\$TBI\
   tbi_effective[is.na(tbi_effective) & !is.na(ig\\$Irrad) & ig\\$Irrad == 0] <-\
   0\
   cat('\\nEffective TBI after recovery (samples):\\n')\
   print(table(tbi_effective, useNA='always'))\
\
   # Serotherapy per sample\
   sero <- (!is.na(ig\\$X197ATGmm) & ig\\$X197ATGmm==1) | (!is.na(ig\\$X10Ab) &\
   ig\\$X10Ab==1)\
   cat('\\nIngham serotherapy (samples):\\n')\
   print(table(sero, useNA='always'))\
\
   # The 3 low-TBI patients (200 cGy) \'97 what are their regimens?\
   cat('\\nIngham: 200 cGy TBI patients (P23, P25, P27) regimen check:\\n')\
   dose200 <- !is.na(ig[['Total.dose.of.TBI.in.cGy']]) &\
   ig[['Total.dose.of.TBI.in.cGy']] == 200\
   print(unique(data.frame(patient=ig\\$patient, regimen=regimens,\
     TBI_dose=ig[['Total.dose.of.TBI.in.cGy']], X270Cyclo=ig\\$X270Cyclo,\
     Myeloabl=ig\\$Myeloabl)[dose200 & !duplicated(ig\\$patient[dose200]), ]))\
   " 2>/dev/null\
