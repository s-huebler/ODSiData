   na_rows <- ig_pt[is.na(ig_pt\\$TBI), ]\
   cat('Patients with TBI=NA:\\n')\
   cat(paste(na_rows\\$patient, collapse=', '), '\\n')\
   cat('Irrad for all:\\n')\
   print(na_rows[, c('patient','Irrad','TBI','Myeloabl')])\
