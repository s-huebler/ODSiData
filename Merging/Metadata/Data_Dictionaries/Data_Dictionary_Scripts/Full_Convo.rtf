    name_repair='minimal')\
   cat('\\n=== Liu regimen x intensity (recipients only) ===\\n')\
   rec <- liu[tolower(liu\\$donor_or_patient)=='patient',]\
   print(table(rec\\$conditioning_intensity, rec\\$chemotherapy_regimen,\
   useNA='always'))\
   " 2>/dev/null\
