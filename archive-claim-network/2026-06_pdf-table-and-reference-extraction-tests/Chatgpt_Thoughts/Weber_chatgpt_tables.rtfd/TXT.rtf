def write_table_sheet(sheet_name, title, headers, rows, notes, table_name, page_range, widths, row_heights):\
    sheet = wb.worksheets.add(sheet_name)\
    last_col_index = len(headers) - 1\
    last_col_letter = chr(ord("A") + last_col_index)\
\
    # Title and source rows\
    sheet.merge_cells(f"A1:\{last_col_letter\}1")\
    sheet.get_range("A1").values = [[title]]\
    sheet.get_range(f"A1:\{last_col_letter\}1").format = TITLE_FORMAT\
    sheet.get_range(f"A1:\{last_col_letter\}1").format.row_height = 28\
\
    sheet.merge_cells(f"A2:\{last_col_letter\}2")\
    sheet.get_range("A2").values = [[f"Source: \{source_title\}; \{source_citation\}; \{source_doi\}; PDF pages \{page_range\}"]]\
    sheet.get_range(f"A2:\{last_col_letter\}2").format = SUBTITLE_FORMAT\
    sheet.get_range(f"A2:\{last_col_letter\}2").format.row_height = 22\
\
    # Header + rows\
    matrix = [headers] + rows\
    end_row = 3 + len(matrix) - 1\
    sheet.get_range_by_indexes(2, 0, len(matrix), len(headers)).values = matrix\
    sheet.get_range(f"A3:\{last_col_letter\}3").format = HEADER_FORMAT\
    sheet.get_range(f"A4:\{last_col_letter\}\{end_row\}").format = BODY_FORMAT\
\
    # Create Excel table object for filters/structured table behavior.\
    sheet.tables.add(f"A3:\{last_col_letter\}\{end_row\}", True, table_name)\
\
    # Column widths\
    for idx, width in enumerate(widths):\
        letter = chr(ord("A") + idx)\
        sheet.get_range(f"\{letter\}:\{letter\}").format.column_width = width\
\
    # Row heights\
    for excel_row, height in row_heights.items():\
        sheet.get_range(f"A\{excel_row\}:\{last_col_letter\}\{excel_row\}").format.row_height = height\
    # Header height\
    sheet.get_range(f"A3:\{last_col_letter\}3").format.row_height = 35\
\
    # Borders/light fill for data body\
    sheet.get_range(f"A3:\{last_col_letter\}\{end_row\}").format.borders = \{\
        "insideHorizontal": \{"style": "Continuous", "color": BORDER_COLOR, "weight": "Thin"\},\
        "insideVertical": \{"style": "Continuous", "color": BORDER_COLOR, "weight": "Thin"\},\
        "edgeTop": \{"style": "Continuous", "color": BORDER_COLOR, "weight": "Thin"\},\
        "edgeBottom": \{"style": "Continuous", "color": BORDER_COLOR, "weight": "Thin"\},\
        "edgeLeft": \{"style": "Continuous", "color": BORDER_COLOR, "weight": "Thin"\},\
        "edgeRight": \{"style": "Continuous", "color": BORDER_COLOR, "weight": "Thin"\},\
    \}\
\
    # Footnote / abbreviation row\
    note_row = end_row + 2\
    sheet.merge_cells(f"A\{note_row\}:\{last_col_letter\}\{note_row\}")\
    sheet.get_range(f"A\{note_row\}").values = [["Abbreviations/notes: " + notes]]\
    sheet.get_range(f"A\{note_row\}:\{last_col_letter\}\{note_row\}").format = NOTE_FORMAT\
    sheet.get_range(f"A\{note_row\}:\{last_col_letter\}\{note_row\}").format.row_height = 68\
\
    # Freeze title/source/header rows\
    sheet.freeze_panes.freeze_rows(3)\
    return sheet\
\
