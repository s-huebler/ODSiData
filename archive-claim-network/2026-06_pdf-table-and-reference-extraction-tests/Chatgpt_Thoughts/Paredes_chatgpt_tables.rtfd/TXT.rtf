def col_letter(idx_zero_based: int) -> str:\
    idx = idx_zero_based + 1\
    letters = ""\
    while idx:\
        idx, rem = divmod(idx - 1, 26)\
        letters = chr(65 + rem) + letters\
    return letters\
\
\
def wrapped_lines(text, col_width):\
    if text is None:\
        return 1\
    s = str(text)\
    if not s:\
        return 1\
    lines = 0\
    width = max(8, int(col_width * 0.95))\
    for part in s.split("\\n"):\
        lines += max(1, ceil(len(part) / width))\
    return lines\
\
\
def apply_table_sheet(wb, table):\
    sheet = wb.worksheets.add(table["sheet"])\
    ncols = len(table["columns"])\
    nrows = len(table["rows"])\
    last_col = col_letter(ncols - 1)\
    last_row = 4 + nrows\
\
    # Title and source rows\
    sheet.merge_cells(f"A1:\{last_col\}1")\
    sheet.merge_cells(f"A2:\{last_col\}2")\
    sheet.get_range("A1").values = [[f'\{table["sheet"]\}. \{table["caption"]\}']]\
    sheet.get_range("A2").values = [[f'Source page: \{table["page"]\} | DOI: https://doi.org/10.1016/j.critrevonc.2026.105229']]\
    sheet.get_range(f"A1:\{last_col\}1").format = title_format\
    sheet.get_range(f"A2:\{last_col\}2").format = source_format\
    sheet.get_range(f"A1:\{last_col\}1").format.row_height = 28\
    sheet.get_range(f"A2:\{last_col\}2").format.row_height = 20\
