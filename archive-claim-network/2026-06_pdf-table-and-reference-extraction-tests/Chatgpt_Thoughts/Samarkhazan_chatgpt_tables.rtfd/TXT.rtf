\cf5 \cb3 \strokec5 def col_letter(idx_zero_based):\
    idx = idx_zero_based + 1\
    letters = ""\
    while idx:\
        idx, rem = divmod(idx - 1, 26)\
        letters = chr(65 + rem) + letters\
    return letters\
\
\
def wrapped_lines(text, col_width):\
    s = "" if text is None else str(text)\
    if not s:\
        return 1\
    width = max(7, int(col_width * 1.05))\
    lines = 0\
    for part in s.split("\\n"):\
        words = part.split(" ")\
        current = 0\
        for word in words:\
            add = len(word) + (1 if current else 0)\
            if current + add > width:\
                lines += 1\
                current = len(word)\
            else:\
                current += add\
        lines += 1\
    return max(1, lines)\
\
\
def apply_table_sheet(wb, table):\
    sheet = wb.worksheets.add(table["sheet"])\
    ncols = len(table["columns"])\
    nrows = len(table["rows"])\
    last_col = col_letter(ncols - 1)\
    last_data_row = 4 + nrows\
    note_row = last_data_row + 2\
\
    sheet.merge_cells(f"A1:\{last_col\}1")\
    sheet.merge_cells(f"A2:\{last_col\}2")\
    sheet.get_range("A1").values = [[table["caption"]]]\
    sheet.get_range("A2").values = [[f"Source: \{ARTICLE_TITLE\} | \{table['pages']\} | DOI: \{DOI\}"]]\
    sheet.get_range(f"A1:\{last_col\}1").format = title_format\
    sheet.get_range(f"A2:\{last_col\}2").format = source_format\
    sheet.get_range(f"A1:\{last_col\}1").format.row_height = 36\
    sheet.get_range(f"A2:\{last_col\}2").format.row_height = 24\
\
    values = [table["columns"]] + table["rows"]\
    sheet.get_range(f"A4:\{last_col\}\{last_data_row\}").values = values\
    sheet.get_range(f"A4:\{last_col\}4").format = header_format\
    sheet.get_range(f"A5:\{last_col\}\{last_data_row\}").format = body_format\
    sheet.get_range(f"A4:\{last_col\}4").format.row_height = 40\
\
    for c, width in enumerate(table["widths"]):\
        col = col_letter(c)\
        sheet.get_range(f"\{col\}1:\{col\}\{note_row\}").format.column_width = width\
\
    for r_idx, row in enumerate(table["rows"], start=5):\
        max_lines = max(wrapped_lines(cell, table["widths"][c]) for c, cell in enumerate(row))\
        height = min(180, max(36, 14 * max_lines + 8))\
        sheet.get_range(f"A\{r_idx\}:\{last_col\}\{r_idx\}").format.row_height = height\
\
    sheet.merge_cells(f"A\{note_row\}:\{last_col\}\{note_row\}")\
    sheet.get_range(f"A\{note_row\}").values = [["Note: " + table["note"]]]\
    sheet.get_range(f"A\{note_row\}:\{last_col\}\{note_row\}").format = note_format\
    sheet.get_range(f"A\{note_row\}:\{last_col\}\{note_row\}").format.row_height = 120 if table["sheet"].startswith("Table 1") else 60\
\
    try:\
        sheet.tables.add(f"A4:\{last_col\}\{last_data_row\}", True, table["name"])\
    except Exception as exc:\
        print(f"Warning: could not add table object on \{table['sheet']\}: \{exc\}")\
    try:\
        sheet.freeze_panes.freeze_rows(4)\
    except Exception as exc:\
        print(f"Warning: could not freeze rows on \{table['sheet']\}: \{exc\}")\
\
\
def add_source_sheet(wb):\
    sheet = wb.worksheets.add("Source & Notes")\
    rows = [\
        ["Field", "Value"],\
        ["Source title", ARTICLE_TITLE],\
        ["Authors", AUTHORS],\
        ["Journal", JOURNAL],\
        ["DOI", DOI],\
        ["PDF filename", SOURCE_PDF],\
        ["Tables extracted", "Table 1 - Metabolites (pages 339-340; PDF pages 12-13); Table 2 - Trials (pages 341-343; PDF pages 14-16)"],\
        ["Workbook note", "Each table is placed on its own worksheet with wrapped text, filters, and a source note below the table."],\
        ["Table 1 note", TABLE1_NOTE],\
        ["Table 2 note", TABLE2_NOTE],\
    ]\
    end_row = len(rows)\
    sheet.get_range(f"A1:B\{end_row\}").values = rows\
    sheet.get_range("A1:B1").format = header_format\
    sheet.get_range(f"A2:B\{end_row\}").format = body_format\
    sheet.get_range(f"A1:B\{end_row\}").format.wrap_text = True\
    sheet.get_range(f"A1:B\{end_row\}").format.vertical_alignment = "top"\
    sheet.get_range(f"A1:A\{end_row\}").format.column_width = 24\
    sheet.get_range(f"B1:B\{end_row\}").format.column_width = 100\
    heights = \{1: 28, 2: 34, 3: 34, 4: 28, 5: 28, 6: 28, 7: 52, 8: 40, 9: 130, 10: 64\}\
    for r in range(1, end_row + 1):\
        sheet.get_range(f"A\{r\}:B\{r\}").format.row_height = heights.get(r, 36)\
    try:\
        sheet.tables.add(f"A1:B\{end_row\}", True, "SourceInfo")\
        sheet.freeze_panes.freeze_rows(1)\
    except Exception as exc:\
        print(f"Warning: source sheet table/freeze issue: \{exc\}")\
\
\
wb = Workbook.create()\
add_source_sheet(wb)\
for table in tables:\
    apply_table_sheet(wb, table)\
\
print(wb.inspect(\{"kind": "sheet", "include": "id,name"\}).ndjson)\
for table in tables:\
    last_col = col_letter(len(table["columns"]) - 1)\
    last_row = 4 + len(table["rows"])\
    print(wb.inspect(\{\
        "kind": "table",\
        "range": f"\{table['sheet']\}!A4:\{last_col\}\{last_row\}",\
        "include": "values",\
        "table_max_rows": 6,\
        "table_max_cols": 12,\
    \}).ndjson)\
errors = wb.inspect(\{\
    "kind": "match",\
    "search_term": "#REF!|#DIV/0!|#VALUE!|#NAME\\\\?|#N/A",\
    "options": \{"use_regex": True, "max_results": 100\},\
    "summary": "final formula error scan",\
\})\
print(errors.ndjson)\
\
# Render small previews for visual verification.\
for sheet_name, out_name in [("Source & Notes", "Paredes2026_Source_preview.png"), ("Table 1 - Metabolites", "Paredes2026_T1_preview.png"), ("Table 2 - Trials", "Paredes2026_T2_preview.png")]:\
    try:\
        blob = wb.render(\{"sheet_name": sheet_name, "range": "A1:H12" if sheet_name != "Table 2 - Trials" else "A1:L12", "scale": 1\})\
        blob.save(f"/mnt/data/\{out_name\}")\
        print(f"Saved preview /mnt/data/\{out_name\}")\
    except Exception as exc:\
        print(f"Warning: render preview failed for \{sheet_name\}: \{exc\}")\
\
SpreadsheetFile.export_xlsx(wb).save(OUTPUT)\
print(f"Saved \{OUTPUT\}")\
