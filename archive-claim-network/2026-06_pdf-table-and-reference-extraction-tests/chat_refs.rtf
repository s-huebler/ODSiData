import re, html, unicodedata, json\
import xml.etree.ElementTree as ET\
from pathlib import Path\
xml_path='/mnt/data/hsu_xml.xml'\
root=ET.parse(xml_path).getroot()\
\
# collect lines by page and column\
pages=\{\}\
for page in root.findall('page'):\
    p=int(page.attrib['number'])\
    items=[]\
    for t in page.findall('text'):\
        txt=''.join(t.itertext())\
        txt=html.unescape(txt)\
        txt=txt.replace('\\u00a0',' ')\
        if not txt.strip():\
            continue\
        top=int(t.attrib['top']); left=int(t.attrib['left'])\
        font=t.attrib.get('font')\
        items.append(\{'top':top,'left':left,'text':txt,'font':font\})\
    pages[p]=items\
\
# group items by top within tolerance for each column\
def make_lines(items, col_start, col_end, top_min=0, top_max=2000):\
    # select items within column, reasonable content rows\
    sel=[it for it in items if col_start-5 <= it['left'] < col_end and top_min <= it['top'] <= top_max]\
    # remove headers/page numbers not in y? top_min should handle mostly\
    sel.sort(key=lambda x:(x['top'], x['left']))\
    lines=[]\
    for it in sel:\
        placed=False\
        # combine accent marks or en dash with same line if top within 3? A very small accent might have different top 2.\
        for line in lines[-3:]:\
            if abs(line['top'] - it['top']) <= 3:\
                line['items'].append(it)\
                # weighted top? keep original\
                placed=True\
                break\
        if not placed:\
            lines.append(\{'top':it['top'], 'items':[it]\})\
    out=[]\
    for line in lines:\
        line['items'].sort(key=lambda x:(x['left'], x['top']))\
        # Skip page header/footer lines by top and known text if any\
        text=''.join(it['text'] for it in line['items'])\
        # Handle bizarre accent order? normalize at end.\
        text=re.sub(r'\\s+', ' ', text).strip()\
        if not text:\
            continue\
        min_left=min(it['left'] for it in line['items'])\
        out.append(\{'top':line['top'], 'left':min_left, 'text':unicodedata.normalize('NFC', text)\})\
    return out\
\
# collect reference column lines in reading order\
col_specs=[]\
# page 11 right column from after References title, top>590, excluding page footers\
