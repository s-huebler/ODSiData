def join_ref(lines):\
    out=''\
    for i,line in enumerate(lines):\
        line=line.strip()\
        if not out:\
            out=line\
        else:\
            if out.endswith('-') and line and re.match(r'^[a-z]', line):\
                out += line\
            else:\
                out += ' ' + line\
    out=re.sub(r'\\s+', ' ', out).strip()\
    # fix spaces before punctuation\
    out=re.sub(r'\\s+([,.;:)])', r'\\1', out)\
    out=re.sub(r'\\(\\s+', '(', out)\
    # normalize odd grave/accent spacing from XML\
    out=unicodedata.normalize('NFC', out)\
    \
    replacements=\{\
        'Daill`ere':'Daill\'e8re',\
        'Daille`ere':'Daill\'e8re',\
        'de Crecy-Lagard':'de Cr\'e9cy-Lagard',\
        'Jasinski':'Jasi\uc0\u324 ski',\
        'Bili\'b4nski':'Bili\uc0\u324 ski',\
        'Bili\uc0\u324 ski':'Bili\u324 ski',\
        'Lazarevi\'b4c':'Lazarevi\uc0\u263 ',\
        'Potgens':'P\'f6tgens',\
        'Rheuma':'Rheum.',\
        'Bmj':'BMJ',\
        'Nat. Med ':'Nat. Med. ',\
        'Nat. Genet ':'Nat. Genet. ',\
        'Comput. Biol. Med.':'Comput. Biol. Med.',\
    \}\
    for a,b in replacements.items():\
        out=out.replace(a,b)\
    # remove isolated accent/umlaut marks introduced by extraction\
    out=out.replace(' \'b4 ', ' ').replace(' \'a8 ', ' ')\
    out=re.sub(r'\\s+', ' ', out).strip()\
    return out\
