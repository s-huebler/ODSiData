import json\
import re\
from artifact_tool import Workbook, SpreadsheetFile\
\
refs_path = "/mnt/data/sohouli_refs_parsed.json"\
out_path = "/mnt/data/Sohouli2025_refs.xlsx"\
\
with open(refs_path, encoding="utf-8") as f:\
    refs = json.load(f)\
\
# Recompute abbreviated citations to avoid issue/volume numbers being mistaken for years.\
def get_year(citation: str) -> str:\
    years = re.findall(r"\\b(?:19|20)\\d\{2\}\\b", citation)\
    return years[0] if years else ""\
\
# Author parsing helpers.\
def parse_authors(citation: str):\
    head = citation.split(", ", 1)[0]\
    # Work off the full prefix before the title. Tokens with initials mark author segments.\
    parts = citation.split(", ")\
    authors = []\
    current = []\
    for part in parts:\
        stripped = part.strip()\
        if stripped.lower() == "et al.":\
            return authors, True\
        current.append(stripped)\
        # A conservative author boundary: surname token preceded by initials, e.g. "E.A. Copelan" or "J.-S. Diana".\
        if re.search(r"(?:^|\\s)(?:[A-Z]\\.|[A-Z]-[A-Z]\\.|[A-Z]\\.\\-[A-Z]\\.)", stripped) or re.match(r"^[A-Z](?:\\.|-)" , stripped):\
            # keep collecting until part ends with a likely surname (which the comma split gives us)\
            pass\
        # If next part starts the title (no initials early), stop after current assembled author.\
        # Most citation author chunks are one comma-separated piece each.\
        authors.append(stripped)\
        next_index = len(authors)\
        if next_index < len(parts):\
            nxt = parts[next_index].strip()\
            if nxt.lower() == "et al.":\
                return authors, True\
            # If the next item does not look like an author initials+surname, it is likely the title.\
            if not re.search(r"(?:^|\\s)(?:[A-Z]\\.|[A-Z]-[A-Z]\\.)(?:\\s|$)", nxt):\
                return authors, False\
    return authors, False\
\
# More direct author counting for the citations in this paper.\
def split_authors(citation: str):\
    parts = citation.split(", ")\
    authors = []\
    for p in parts:\
        p = p.strip()\
        if p.lower() == "et al.":\
            return authors, True\
        if re.match(r"^[A-Z](?:\\.|\\.-|-[A-Z]\\.|\\.[A-Z]|\\.)(?:.*\\.)?\\s+", p) or re.match(r"^[A-Z]\\.[A-Z]\\.\\s+", p) or re.match(r"^[A-Z]\\.-[A-Z]\\.\\s+", p) or re.match(r"^[A-Z]-[A-Z]\\.\\s+", p):\
            authors.append(p)\
        else:\
            return authors, False\
    return authors, False\
\
def surname(author: str) -> str:\
    # Remove initials/prefixes and punctuation while preserving multiword surnames.\
    author = author.strip()\
    author = re.sub(r"^(?:[A-Z]\\.|[A-Z]\\.-[A-Z]\\.|[A-Z]-[A-Z]\\.)(?:\\s+|)", "", author).strip()\
    author = re.sub(r"^(?:[A-Z]\\.)\{1,4\}\\s+", "", author).strip()\
    author = author.replace("\'92", "").replace("'", "").replace("-", "")\
    author = re.sub(r"[^A-Za-z\'c0-\'d6\'d8-\'f6\'f8-\'ff ]+", "", author)\
    return author.replace(" ", "")\
\
def abbreviated(citation: str) -> str:\
    year = get_year(citation)\
    authors, has_et_al = split_authors(citation)\
    if len(authors) == 2 and not has_et_al:\
        return f"\{surname(authors[0])\}&\{surname(authors[1])\}_\{year\}"\
    if authors:\
        return f"\{surname(authors[0])\}_\{year\}"\
    return f"_\{year\}"\
