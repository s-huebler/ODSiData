\cf5 \cb3 import json, re, zipfile, posixpath\
from xml.etree import ElementTree as ET\
from difflib import SequenceMatcher\
from pathlib import Path\
\
def read_xlsx_rows(path):\
    ns=\{'main':'http://schemas.openxmlformats.org/spreadsheetml/2006/main'\}\
    with zipfile.ZipFile(path) as z:\
        sst=[]\
        if 'xl/sharedStrings.xml' in z.namelist():\
            root=ET.fromstring(z.read('xl/sharedStrings.xml'))\
            for si in root.findall('main:si', ns):\
                texts=[t.text or '' for t in si.iter('\{http://schemas.openxmlformats.org/spreadsheetml/2006/main\}t')]\
                sst.append(''.join(texts))\
        wb=ET.fromstring(z.read('xl/workbook.xml'))\
        rels=ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))\
        rid_to_target=\{r.attrib['Id']:r.attrib['Target'] for r in rels\}\
        sheet=wb.find('main:sheets', ns)[0]\
        rid=sheet.attrib['\{http://schemas.openxmlformats.org/officeDocument/2006/relationships\}id']\
        tgt=rid_to_target[rid]\
        target=tgt.lstrip('/') if tgt.startswith('/') else posixpath.normpath(posixpath.join('xl',tgt))\
        root=ET.fromstring(z.read(target))\
        rows=[]\
        for row in root.findall('.//main:sheetData/main:row', ns):\
            vals=[]\
            last_col=0\
            for c in row.findall('main:c', ns):\
                # account for missing cells\
                ref=c.attrib.get('r','A1')\
                m=re.match(r'([A-Z]+)',ref)\
                col=0\
                for ch in m.group(1): col=col*26+ord(ch)-64\
                while last_col<col-1:\
                    vals.append(''); last_col+=1\
                t=c.attrib.get('t')\
                v=c.find('main:v', ns)\
                if v is None:\
                    if t=='inlineStr':\
                        vals.append(''.join(tt.text or '' for tt in c.iter('\{http://schemas.openxmlformats.org/spreadsheetml/2006/main\}t')))\
                    else:\
                        vals.append('')\
                elif t=='s': vals.append(sst[int(v.text)])\
                else: vals.append(v.text)\
                last_col=col\
            rows.append(vals)\
        return rows\
\
def norm(s):\
    s=s.lower()\
    s=re.sub(r'[^a-z0-9]+',' ',s)\
    return ' '.join(s.split())\
\
def titleish(c):\
    # Return a normalized title-ish segment, tolerant across formats.\
    c=c.replace('\'96','-')\
    # If citation uses year. title. journal\
    m=re.search(r'\\b(?:19|20)\\d\{2\}\\.?\\s+(.+)', c)\
    if m:\
        rest=m.group(1)\
        # title is before a known journal-ish abbrev; use first sentence(s) until common journal indicators.\
        # The title often ends before journal name, which contains abbreviated words with capitals.\
        parts=re.split(r'\\.\\s+(?=[A-Z][A-Za-z. ]\{0,30\}\\b(?:J|Nat|Science|Blood|Front|Clin|Proc|N|Cell|Gut|Transpl|Biol|Microbiome|Haematologica|Med|Pharm|Immunol|Comput|Sci|Cancers|Lancet|BMJ|Bmc|BMC|Embo|Jama|JAMA|npj|Mol|Expert|Ther|Visc|Cancer|Antioxid|EBioMedicine|iScience))', rest, maxsplit=1)\
        return norm(parts[0])\
    # Other formats: after authors until journal.\
    return norm(c)\
\
hsu=json.loads(Path('/mnt/data/hsu_refs_parsed.json').read_text())\
prev=[]\
for path in ['/mnt/data/Godefroy2025_refs.xlsx','/mnt/data/Samarkhazan2025_refs.xlsx','/mnt/data/Sohouli2025_refs.xlsx','/mnt/data/parsed_references_with_doi.xlsx']:\
    try: rows=read_xlsx_rows(path)\
    except Exception as e:\
        print('ERR',path,e); continue\
    hdr=[h.strip() for h in rows[0]]\
    try:\
        ic=hdr.index('full_citation'); idoi=hdr.index('doi')\
    except ValueError:\
        continue\
    for row in rows[1:]:\
        if len(row)>max(ic,idoi) and row[idoi]:\
            prev.append(\{'citation':row[ic], 'doi':row[idoi], 'key':titleish(row[ic]), 'path':path\})\
\
out=[]\
for r in hsu:\
    key=titleish(r['full_citation'])\
    best=None; bestscore=0\
    for p in prev:\
        # token overlap + sequence ratio\
        a=set(key.split()); b=set(p['key'].split())\
        if not a or not b: score=0\
        else:\
            j=len(a&b)/len(a|b)\
            sm=SequenceMatcher(None, key, p['key']).ratio()\
            score=0.6*j+0.4*sm\
        if score>bestscore:\
            bestscore=score; best=p\
    if bestscore>=0.78:\
        out.append((r['number'], bestscore, best['doi'], r['full_citation'][:80], best['citation'][:80], best['path']))\
\
print('matches',len(out),'of',len(hsu))\
for row in out[:100]: print(row)\
Path('/mnt/data/hsu_prev_doi_matches.json').write_text(json.dumps([\{'number':n,'score':s,'doi':d,'source':src\} for n,s,d,_,__,src in out], indent=2), encoding='utf-8')\
