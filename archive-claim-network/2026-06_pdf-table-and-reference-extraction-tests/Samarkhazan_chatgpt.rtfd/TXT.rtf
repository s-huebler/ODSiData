\cf5 \cb3 import fitz, re, json, unicodedata\
from pathlib import Path\
pdf='/mnt/data/The microbiome in graft-versus-host disease_ a tale of two ecosystems (1).pdf'\
doc=fitz.open(pdf)\
\
def line_text_from_words(words):\
    # group into lines by y midpoint with tolerance\
    lines=[]\
    for w in sorted(words, key=lambda w:(w[1], w[0])):\
        x0,y0,x1,y1,text,*rest=w\
        if not text.strip():\
            continue\
        ymid=(y0+y1)/2\
        placed=False\
        for line in lines:\
            if abs(line['ymid']-ymid) < 3.5:\
                line['words'].append((x0,text))\
                # average y maybe\
                line['ymid']=(line['ymid']*line['n']+ymid)/(line['n']+1)\
                line['n']+=1\
                placed=True\
                break\
        if not placed:\
            lines.append(\{'ymid':ymid,'n':1,'words':[(x0,text)]\})\
    out=[]\
    for line in sorted(lines, key=lambda l:l['ymid']):\
        words_sorted=[t for x,t in sorted(line['words'])]\
        out.append(' '.join(words_sorted))\
    return out\
\
def join_lines(lines):\
    text=''\
    prev_break=None  # None, 'soft', or 'hard_hyphen'\
    for raw in lines:\
        raw=raw.strip()\
        if not raw:\
            continue\
        cur_soft = raw.endswith('\\xad')\
        cur_hard = raw.endswith('-') or raw.endswith('\uc0\u8208 ') or raw.endswith('\u8209 ')\
        line=raw.replace('\\xad','')\
        if not text:\
            text=line\
        else:\
            if prev_break == 'soft':\
                text += line\
            elif prev_break == 'hard_hyphen':\
                text += line\
            else:\
                text += ' ' + line\
        prev_break = 'soft' if cur_soft else ('hard_hyphen' if cur_hard else None)\
    text = text.replace('\uc0\u8208 ','-').replace('\u8209 ','-')\
    text = re.sub(r'\\s+', ' ', text).strip()\
    return text\
\
\
columns=[]\
for pno in [11,12,13,14]:\
    page=doc[pno]\
    words=page.get_text('words')\
    # filter refs region: remove header and non-reference text\
    if pno==11: # page 12, right column only lower area\
        specs=[('p12_right', 300, 550, 580, 735)]\
    elif pno in [12,13]:\
        specs=[(f'p\{pno+1\}_left', 40, 70, 300, 730), (f'p\{pno+1\}_right', 300, 70, 560, 730)]\
    else: # page 15 left top only\
        specs=[('p15_left', 40, 70, 300, 150)]\
    for name,xmin,ymin,xmax,ymax in specs:\
        sel=[w for w in words if w[0]>=xmin and w[2]<=xmax and w[1]>=ymin and w[3]<=ymax]\
        lines=line_text_from_words(sel)\
        # remove header References line from page 12 separately? Keep, then remove below\
        columns.append((name,lines,join_lines(lines)))\
\
full=''\
for name,lines,txt in columns:\
    # remove References heading\
    txt=re.sub(r'^References\\s*', '', txt).strip()\
    print('\\n--',name,'--')\
    print(txt[:1000])\
    full += (' ' if full else '') + txt\
full = re.sub(r'\\s+', ' ', full).strip()\
# split into references at occurrences like number. Need ensure number from volume/issue not matched: use ref number followed by dot and space and capital author; citations are numbered sequentially.\
# We can use positions of r'(?<!\\d)(\\d\{1,3\})\\.\\s+' and select only sequence 1..108.\
pattern=re.compile(r'(?<!\\d)(\\d\{1,3\})\\.\\s+(?=[A-Za-z\'c0-\'d6\'d8-\'f6\'f8-\'ff])')\
matches=list(pattern.finditer(full))\
# filter to matches with seq 1..108 by order. Some periods with years? But numbers followed by dot maybe page? likely not.\
# Let's find sequential positions greedily.\
refs=[]\
idx=0\
expected=1\
for m in matches:\
    n=int(m.group(1))\
    if n==expected:\
        if refs:\
            refs[-1]['end']=m.start()\
        refs.append(\{'number':n,'start':m.end(),'num_start':m.start()\})\
        expected+=1\
    if expected>108:\
        break\
if refs:\
    refs[-1]['end']=len(full)\
out=[]\
for r in refs:\
    citation=full[r['start']:r['end']].strip()\
    # cleanup spaces before punctuation maybe\
    citation=re.sub(r'\\s+([,.;:)])', r'\\1', citation)\
    citation=re.sub(r'\\( ', '(', citation)\
    citation=re.sub(r'\\s+', ' ', citation)\
    out.append(\{'number':r['number'], 'full_citation':citation\})\
print('\\nFound refs',len(out),'expected next',expected)\
for r in out[:10]+out[-5:]:\
    print(r['number'], r['full_citation'][:200])\
Path('/mnt/data/sam_refs_extracted.json').write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding='utf-8')\
\
