\cf5 \cb3 import re\
from pathlib import Path\
import fitz\
from artifact_tool import Workbook, SpreadsheetFile\
\
PDF_PATH = Path('/mnt/data/login.ezproxy.lib.utah.edu 5_7_2026, 1_01_16 PM (3).pdf')\
OUT_PATH = Path('/mnt/data/parsed_references.xlsx')\
\
\
def extract_reference_blocks(pdf_path: Path) -> str:\
    doc = fitz.open(str(pdf_path))\
    # References start in the right column of page 19 (0-based 18) and continue through page 22.\
    chunks = []\
    for pno in [18, 19, 20, 21]:\
        blocks = []\
        for b in doc[pno].get_text('blocks'):\
            x0, y0, x1, y1, text, *_ = b\
            # Exclude page headers/footers and non-reference body content.\
            if y0 < 100 or y0 > 750:\
                continue\
            if pno == 18:\
                if x0 > 300:  # right column only on the first references page\
                    blocks.append((x0, y0, text))\
            else:\
                # Whole page is references; keep left then right column.\
                blocks.append((x0, y0, text))\
        blocks = sorted(blocks, key=lambda t: (0 if t[0] < 300 else 1, t[1]))\
        chunks.extend(t for _, _, t in blocks)\
    raw = '\\n'.join(chunks)\
    raw = re.sub(r'^\\s*References\\s*\\n', '', raw)\
    return raw\
\
\
def clean_reference_text(text: str) -> str:\
    # Join line-broken hyphenated words/compounds without inserting spaces.\
    text = re.sub(r'([A-Za-z])-\\s*\\n\\s*([A-Za-z])', r'\\1-\\2', text)\
    # Convert all other line breaks to single spaces.\
    text = re.sub(r'\\s*\\n\\s*', ' ', text)\
    text = re.sub(r'\\s+', ' ', text).strip()\
    # Remove review-article annotation blurbs that follow selected cited works.\
    m = re.search(r'\\(\\d\{4\}\\)\\.', text)\
    if m:\
        text = text[:m.end()].strip()\
    # Repair line-break spaces inside ClinicalTrials.gov URLs.\
    def repair_url(m):\
        prefix, url_tail, year = m.groups()\
        return prefix + re.sub(r'\\s+', '', url_tail) + ' ' + year\
    text = re.sub(\
        r'(https://clinicaltrials\\.gov/study/)(.*?)(\\(\\d\{4\}\\)\\.)',\
        repair_url,\
        text,\
    )\
    return text\
\
\
def parse_references(raw: str):\
    # Require whitespace after the reference number period to avoid false splits on page ranges like 548.e1.\
    parts = re.split(r'(?m)^\\s*(\\d\{1,3\})\\.\\s+', raw)\
    refs = []\
    for i in range(1, len(parts), 2):\
        num = int(parts[i])\
        if not 1 <= num <= 197:\
            continue\
        citation = clean_reference_text(parts[i + 1])\
        refs.append((num, citation))\
    refs = sorted(refs, key=lambda x: x[0])\
    nums = [n for n, _ in refs]\
    if nums != list(range(1, 198)):\
        missing = [n for n in range(1, 198) if n not in nums]\
        dupes = sorted(\{n for n in nums if nums.count(n) > 1\})\
        raise ValueError(f'Reference parsing failed. Missing=\{missing\}; duplicates=\{dupes\}; parsed=\{len(refs)\}')\
    return refs\
\
\
def parse_authors(citation: str):\
    s = citation.strip()\
    authors = []\
    pos = 0\
    etal = False\
    while True:\
        while pos < len(s) and s[pos].isspace():\
            pos += 1\
        # Author tokens are styled as: Lastname, A. B.\
        # Lastname can include spaces, hyphens, accents and lowercase particles.\
        m = re.match(r'([^,&]+?),\\s+((?:[A-Z]\\.?\\s*)+)', s[pos:])\
        if not m:\
            break\
        authors.append(m.group(1).strip())\
        pos += m.end()\
        rest = s[pos:].lstrip()\
        pos = len(s) - len(rest)\
        if rest.startswith('et al.'):\
            etal = True\
            break\
        if rest.startswith(','):\
            pos += 1\
            continue\
        if rest.startswith('&'):\
            pos += 1\
            continue\
        break\
    return authors, etal\
\
\
def label_part(name: str) -> str:\
    # Remove spaces and punctuation so labels are easy to use in filenames/keys.\
    return ''.join(ch for ch in name.strip() if ch.isalnum())\
\
\
def abbreviated_label(citation: str) -> str:\
    y = re.search(r'\\((\\d\{4\})\\)\\.', citation)\
    year = y.group(1) if y else ''\
    authors, etal = parse_authors(citation)\
    if not authors:\
        # Organizational authors, e.g., US National Library of Medicine.\
        org = citation.split('.')[0].strip()\
        base = label_part(org)\
        return f'\{base\}_\{year\}' if year else base\
    if len(authors) == 2 and not etal:\
        return f'\{label_part(authors[0])\}&\{label_part(authors[1])\}_\{year\}'\
    return f'\{label_part(authors[0])\}_\{year\}' if year else label_part(authors[0])\
\
\
raw = extract_reference_blocks(PDF_PATH)\
refs = parse_references(raw)\
rows = [[num, citation, abbreviated_label(citation)] for num, citation in refs]\
\
# Build workbook\
wb = Workbook.create()\
refs_sheet = wb.worksheets.add('References')\
source_sheet = wb.worksheets.add('Source')\
\
headers = [['Number', 'Full citation', 'Abbreviated reference']]\
last_row = len(rows) + 1\
refs_sheet.get_range(f'A1:C\{last_row\}').values = headers + rows\
\
# Style References sheet\
header_fmt = \{\
    'fill': '#1F4E78',\
    'font': \{'bold': True, 'color': '#FFFFFF'\},\
    'horizontal_alignment': 'center',\
    'vertical_alignment': 'center',\
    'wrap_text': True,\
\}\
refs_sheet.get_range('A1:C1').format = header_fmt\
refs_sheet.get_range(f'A1:C\{last_row\}').format.vertical_alignment = 'top'\
