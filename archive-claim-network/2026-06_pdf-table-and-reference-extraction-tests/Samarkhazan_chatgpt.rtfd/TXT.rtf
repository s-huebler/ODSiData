\
def label_part(name: str) -> str:\
    # Keep letters/numbers, remove spaces and punctuation to match compact Lastname_year labels.\
    return ''.join(ch for ch in name.strip() if ch.isalnum())\
\
\
def surname_from_author(author: str) -> str:\
    author = author.strip().replace('\\u00a0', ' ')\
    author = re.sub(r'\\s+', ' ', author)\
    # Remove any stray et al text.\
    author = re.sub(r'\\bet\\s+al\\.?$', '', author, flags=re.I).strip(' ,.;')\
    pieces = author.split()\
    while pieces:\
        candidate = pieces[-1].replace('.', '').replace('-', '')\
        if re.fullmatch(r'[A-Z]\{1,6\}', candidate):\
            pieces.pop()\
        else:\
            break\
    return ' '.join(pieces).strip() or author.strip()\
\
\
def author_segment(citation: str) -> str:\
    # Author lists end before the article title. For this PDF's Vancouver-style refs,\
    # the first period-space marks that boundary; et al. is stripped to avoid truncation issues.\
    first = citation.split('. ', 1)[0]\
    return first.strip().rstrip('.')\
\
\
def abbreviated_label(citation: str) -> str:\
    year_match = re.search(r'\\b(19|20)\\d\{2\}\\b', citation)\
    year = year_match.group(0) if year_match else ''\
    seg = author_segment(citation)\
    etal = bool(re.search(r'\\bet\\s+al\\.?', seg, flags=re.I))\
    parts = [p.strip() for p in seg.split(',') if p.strip()]\
    clean_parts = [re.sub(r'\\bet\\s+al\\.?', '', p, flags=re.I).strip(' ,.;') for p in parts]\
    clean_parts = [p for p in clean_parts if p]\
    if not clean_parts:\
        base = label_part(seg)\
    elif len(clean_parts) == 2 and not etal:\
        base = f'\{label_part(surname_from_author(clean_parts[0]))\}&\{label_part(surname_from_author(clean_parts[1]))\}'\
    else:\
        base = label_part(surname_from_author(clean_parts[0]))\
    return f'\{base\}_\{year\}' if year else base\
\
