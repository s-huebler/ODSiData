def get_year(citation: str) -> str:\
    # Prefer the first four-digit year in the reference. The paper uses one publication year per citation.\
    m = re.search(r'\\b(19|20)\\d\{2\}\\b', citation)\
    return m.group(0) if m else ''\
\
\
def author_segment(citation: str) -> str:\
    # Citations use initials without periods; the first ". " therefore ends the author block.\
    # For entries that include "et al.", include that marker in the author block.\
    if ' et al. ' in citation:\
        return citation.split(' et al. ', 1)[0] + ' et al.'\
    return citation.split('. ', 1)[0]\
\
\
def split_authors(segment: str):\
    cleaned = re.sub(r'\\bet al\\.?', '', segment, flags=re.IGNORECASE).strip().strip(',')\
    return [p.strip() for p in cleaned.split(',') if p.strip()]\
\
\
def surname_from_author(author: str) -> str:\
    author = re.sub(r'\\bet al\\.?', '', author, flags=re.IGNORECASE)\
    author = author.strip().strip(',')\
    tokens = author.split()\
    # Remove trailing initials/initial groups (e.g., ALC, JR, KP, YF, D-Q-H).\
    while tokens:\
        simple = re.sub(r'[.\\-]', '', tokens[-1])\
        if simple.isupper() and 1 <= len(simple) <= 5:\
            tokens.pop()\
        else:\
            break\
    return ' '.join(tokens) if tokens else author\
\
\
def abbrev(citation: str) -> str:\
    year = get_year(citation)\
    segment = author_segment(citation)\
    authors = split_authors(segment)\
    has_etal = bool(re.search(r'\\bet al\\.?', segment, flags=re.IGNORECASE))\
    if not authors:\
        name = 'Unknown'\
    elif (not has_etal) and len(authors) == 2:\
        name = f"\{surname_from_author(authors[0])\}&\{surname_from_author(authors[1])\}"\
    else:\
        name = surname_from_author(authors[0])\
    return f"\{name\}_\{year\}" if year else name\
\
