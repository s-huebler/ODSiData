@article{Marmont_1991,
  title = {T-Cell Depletion of {{HLA-identical}} Transplants in Leukemia},
  author = {Marmont, Am and Horowitz, Mm and Gale, Rp and Sobocinski, K and Ash, Rc and Van Bekkum, Dw and Champlin, Re and Dicke, Ka and Goldman, Jm and Good, Ra},
