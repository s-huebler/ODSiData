@article{DiMattia_2024,
  title = {Hypoxic {{Functional Regulation Pathways}} in the {{GI Tract}}: {{Focus}} on the {{HIF-1$\alpha$}} and {{Microbiota}}'s {{Crosstalk}}},
  shorttitle = {Hypoxic {{Functional Regulation Pathways}} in the {{GI Tract}}},
  author = {Di Mattia, Miriam and Sallese, Michele and Neri, Matteo and Lopetuso, Loris Riccardo},
  year = 2024,
  month = aug,
  journal = {Inflammatory Bowel Diseases},
  volume = {30},
  number = {8},
  pages = {1406--1418},
  issn = {1078-0998, 1536-4844},
  doi = {10.1093/ibd/izae046},
  urldate = {2026-07-13},
  abstract = {Abstract             Hypoxia is an essential gastrointestinal (GI) tract phenomenon that influences both physiologic and pathologic states. Hypoxia-inducible factors (HIFs), the primary drivers of cell adaptation to low-oxygen environments, have been identified as critical regulators of gut homeostasis: directly, through the induction of different proteins linked to intestinal barrier stabilization (ie, adherent proteins, tight junctions, mucins, integrins, intestinal trefoil factor, and adenosine); and indirectly, through the regulation of several immune cell types and the modulation of autophagy and inflammatory processes. Furthermore, hypoxia and HIF-related sensing pathways influence the delicate relationship existing between bacteria and mammalian host cells. In turn, gut commensals establish and maintain the physiologic hypoxia of the GI tract and HIF-{$\alpha$} expression. Based on this premise, the goals of this review are to (1) highlight hypoxic molecular pathways in the GI tract, both in physiologic and pathophysiologic settings, such as inflammatory bowel disease; and (2) discuss a potential strategy for ameliorating gut-related disorders, by targeting HIF signaling, which can alleviate inflammatory processes, restore autophagy correct mechanisms, and benefit the host-microbiota equilibrium.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/6TII9QKD/Di Mattia et al. - 2024 - Hypoxic Functional Regulation Pathways in the GI Tract Focus on the HIF-1α and Microbiota’s Crossta.pdf}
}

