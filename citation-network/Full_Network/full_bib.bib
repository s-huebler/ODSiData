  title = {Intermittent {{Fasting Confers Protection}} in {{CNS Autoimmunity}} by {{Altering}} the {{Gut Microbiota}}},
  author = {Cignarella, Francesca and Cantoni, Claudia and Ghezzi, Laura and Salter, Amber and Dorsett, Yair and Chen, Lei and Phillips, Daniel and Weinstock, George M. and Fontana, Luigi and Cross, Anne H. and Zhou, Yanjiao and Piccio, Laura},
