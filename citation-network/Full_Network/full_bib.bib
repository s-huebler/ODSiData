@article{Wall_2018,
  title = {Complement-Mediated Thrombotic Microangiopathy as a Link between Endothelial Damage and Steroid-Refractory {{GVHD}}},
  author = {Wall, Sarah A. and Zhao, Qiuhong and Yearsley, Martha and Blower, Luke and Agyeman, Akwasi and Ranganathan, Parvathi and Yang, Shangbin and Wu, Haiwa and Bostic, Matthew and Jaglowski, Samantha and Brammer, Jonathan E. and William, Basem and Choe, Hannah and Mims, Alice S. and Penza, Sam and Efebera, Yvonne and Devine, Steven and Cataland, Spero and Davies, Stella M. and Vasu, Sumithira},
  year = 2018,
  month = oct,
  journal = {Blood Advances},
  volume = {2},
  number = {20},
  pages = {2619--2628},
  issn = {2473-9529, 2473-9537},
  doi = {10.1182/bloodadvances.2018020321},
  urldate = {2026-07-13},
  abstract = {Abstract             Transplant-associated thrombotic microangiopathy (TA-TMA), a complication of hematopoietic cell transplant (HCT), is associated with significant morbidity and mortality. The pathophysiology and overlap of TA-TMA with other posttransplant complications such as graft-versus-host disease (GVHD) is poorly understood. We retrospectively identified cases of TA-TMA among patients with grade 3/4 gastrointestinal (GI) GVHD, reviewed intestinal biopsy specimens, and performed correlative testing of biomarkers associated with TA-TMA. TA-TMA was more common in patients with steroid-refractory GVHD compared with steroid-responsive GVHD (79.3\% vs 42.1\%; P = .001). Among patients surviving 100 days post-HCT, 1-year survival from day 100 was significantly better for patients who had not developed TA-TMA in the first 100 days (69.5\% vs 36.7\%; P \&lt; .001). Only 1 of 7 proposed TA-TMA histology criteria (mucosal hemorrhage) differed significantly based on GVHD steroid response. In multivariable modeling, steroid-refractory GVHD was a risk factor for development of TA-TMA (hazard ratio, 3.09; 95\% confidence interval, 1.68-5.67; P \&lt; .001). There were no differences in complement activation at GVHD onset; however, 2 to 6 weeks later, patients with TA-TMA had higher levels of BBPlus and C5b-9, markers of alternative and terminal pathway activation (BBPlus: median, 600 vs 209.3 ng/mL; P = .0045) (C5b-9: median, 425.9 vs 258.4 ng/mL; P = .029). TA-TMA is associated with poor overall survival (OS) following HCT and may be detected early by histologic findings and may be differentiated from GVHD by measurement of alternative and terminal complement pathway activation. It is unknown whether treatment of TA-TMA will improve survival in steroid-refractory GVHD.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/UGKYX8SL/Wall et al. - 2018 - Complement-mediated thrombotic microangiopathy as a link between endothelial damage and steroid-refr.pdf}
}

