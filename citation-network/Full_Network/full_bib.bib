@article{Louie_2023,
  title = {{{VE303}}, a {{Defined Bacterial Consortium}}, for {{Prevention}} of {{Recurrent}} {{{\emph{Clostridioides}}}}{\emph{ Difficile}} {{Infection}}: {{A Randomized Clinical Trial}}},
  shorttitle = {{{VE303}}, a {{Defined Bacterial Consortium}}, for {{Prevention}} of {{Recurrent}} {{{\emph{Clostridioides}}}}{\emph{ Difficile}} {{Infection}}},
  author = {Louie, Thomas and Golan, Yoav and Khanna, Sahil and Bobilev, Dmitri and Erpelding, Nathalie and Fratazzi, Candida and Carini, Meg and Menon, Rajita and Ruisi, Mary and Norman, Jason M. and Faith, Jeremiah J. and Olle, Bernat and Li, Minran and Silber, Jeffrey L. and Pardi, Darrell S.},
  year = 2023,
  month = apr,
  journal = {JAMA},
  volume = {329},
  number = {16},
  pages = {1356},
  issn = {0098-7484},
  doi = {10.1001/jama.2023.4314},
  urldate = {2026-07-13},
  abstract = {Importance                                The effect of rationally defined nonpathogenic, nontoxigenic, commensal strains of Clostridia on prevention of                 Clostridioides difficile                 infection (CDI) is unknown.                                                        Objective               To determine the efficacy of VE303, a defined bacterial consortium of 8 strains of commensal Clostridia, in adults at high risk for CDI recurrence. The primary objective was to determine the recommended VE303 dosing for a phase 3 trial.                                         Design, Setting, and Participants                                Phase 2, randomized, double-blind, placebo-controlled, dose-ranging study conducted from February 2019 to September 2021 at 27 sites in the US and Canada. The study included 79 participants aged 18 years or older who were diagnosed with laboratory-confirmed CDI with 1 or more prior CDI episodes in the last 6 months and those with primary CDI at high risk for recurrence (defined as aged {$\geq$}75 years or {$\geq$}65 years with {$\geq$}1 risk factors: creatinine clearance \&amp;lt;60 mL/min/1.73 m                 2                 , proton pump inhibitor use, remote [\&amp;gt;6 months earlier] CDI history).                                                        Interventions                                Participants were randomly assigned to high-dose VE303 (8.0\,\texttimes\,10                 9                 colony-forming units [CFUs]) (n\,=\,30), low-dose VE303 (1.6\,\texttimes\,10                 9                 CFUs) (n\,=\,27), or placebo capsules (n\,=\,22) orally once daily for 14 days.                                                        Main Outcomes and Measures               The primary efficacy end point was the proportion of participants with CDI recurrence at 8 weeks using a combined clinical and laboratory definition. The primary efficacy end point was analyzed in 3 prespecified analyses, using successively broader definitions for an on-study CDI recurrence: (1) diarrhea consistent with CDI plus a toxin-positive stool sample; (2) diarrhea consistent with CDI plus a toxin-positive, polymerase chain reaction--positive, or toxigenic culture--positive stool sample; and (3) diarrhea consistent with CDI plus laboratory confirmation or (in the absence of a stool sample) treatment with a CDI-targeted antibiotic.                                         Results                                Baseline characteristics were similar across the high-dose VE303 (n\,=\,29; 1 additional participant excluded from efficacy analysis), low-dose VE303 (n\,=\,27), and placebo (n\,=\,22) groups. The participants' median age was 63.5 years (range, 24-96); 70.5\% were female; and 1.3\% were Asian, 1.3\% Black, 2.6\% Hispanic, and 96.2\% White. CDI recurrence rates through week 8 (using the efficacy analysis 3 definition) were 13.8\% (4/29) for high-dose VE303, 37.0\% (10/27) for low-dose VE303, and 45.5\% (10/22) for placebo (                 P                 \,=\,.006, high-dose VE303 vs placebo).                                                        Conclusions and Relevance               Among adults with laboratory-confirmed CDI with 1 or more prior CDI episodes in the last 6 months and those with primary CDI at high risk for recurrence, high-dose VE303 prevented recurrent CDI compared with placebo. A larger, phase 3 study is needed to confirm these findings.                                         Trial Registration                                ClinicalTrials.gov Identifier:                 NCT03788434},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/U4I233CB/Louie et al. - 2023 - VE303, a Defined Bacterial Consortium, for Prevention of Recurrent Clostridioides difficile I.pdf}
}

@article{Louis_2017,
  title = {Formation of Propionate and Butyrate by the Human Colonic Microbiota},
  author = {Louis, Petra and Flint, Harry J.},
  year = 2017,
  month = jan,
  journal = {Environmental Microbiology},
  volume = {19},
  number = {1},
  pages = {29--41},
  issn = {1462-2912, 1462-2920},
  doi = {10.1111/1462-2920.13589},
  urldate = {2026-07-13},
  abstract = {Summary             The human gut microbiota ferments dietary non-digestible carbohydrates into short-chain fatty acids (SCFA). These microbial products are utilized by the host and propionate and butyrate in particular exert a range of health-promoting functions. Here an overview of the metabolic pathways utilized by gut microbes to produce these two SCFA from dietary carbohydrates and from amino acids resulting from protein breakdown is provided. This overview emphasizes the important role played by cross-feeding of intermediary metabolites (in particular lactate, succinate and 1,2-propanediol) between different gut bacteria. The ecophysiology, including growth requirements and responses to environmental factors, of major propionate and butyrate producing bacteria are discussed in relation to dietary modulation of these metabolites. A detailed understanding of SCFA metabolism by the gut microbiota is necessary to underpin effective strategies to optimize SCFA supply to the host.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/VYEDD2EH/Louis and Flint - 2017 - Formation of propionate and butyrate by the human colonic microbiota.pdf}
}

