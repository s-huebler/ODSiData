@article{Kim_2021,
  title = {Control of Lymphocyte Functions by Gut Microbiota-Derived Short-Chain Fatty Acids},
  author = {Kim, Chang H.},
  year = 2021,
  month = may,
  journal = {Cellular \& Molecular Immunology},
  volume = {18},
  number = {5},
  pages = {1161--1171},
  issn = {1672-7681, 2042-0226},
  doi = {10.1038/s41423-020-00625-0},
  urldate = {2026-07-13},
  abstract = {Abstract             A mounting body of evidence indicates that dietary fiber (DF) metabolites produced by commensal bacteria play essential roles in balancing the immune system. DF, considered nonessential nutrients in the past, is now considered to be necessary to maintain adequate levels of immunity and suppress inflammatory and allergic responses. Short-chain fatty acids (SCFAs), such as acetate, propionate, and butyrate, are the major DF metabolites and mostly produced by specialized commensal bacteria that are capable of breaking down DF into simpler saccharides and further metabolizing the saccharides into SCFAs. SCFAs act on many cell types to regulate a number of important biological processes, including host metabolism, intestinal functions, and immunity system. This review specifically highlights the regulatory functions of DF and SCFAs in the immune system with a focus on major innate and adaptive lymphocytes. Current information regarding how SCFAs regulate innate lymphoid cells, T helper cells, cytotoxic T cells, and B cells and how these functions impact immunity, inflammation, and allergic responses are discussed.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/P5PSTVSK/Kim - 2021 - Control of lymphocyte functions by gut microbiota-derived short-chain fatty acids.pdf}
}

