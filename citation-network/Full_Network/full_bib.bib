@article{Llorente_2017,
  title = {Gastric Acid Suppression Promotes Alcoholic Liver Disease by Inducing Overgrowth of Intestinal {{Enterococcus}}},
  author = {Llorente, Cristina and Jepsen, Peter and Inamine, Tatsuo and Wang, Lirui and Bluemel, Sena and Wang, Hui J. and Loomba, Rohit and Bajaj, Jasmohan S. and Schubert, Mitchell L. and Sikaroodi, Masoumeh and Gillevet, Patrick M. and Xu, Jun and Kisseleva, Tatiana and Ho, Samuel B. and DePew, Jessica and Du, Xin and S{\o}rensen, Henrik T. and Vilstrup, Hendrik and Nelson, Karen E. and Brenner, David A. and Fouts, Derrick E. and Schnabl, Bernd},
  year = 2017,
  month = oct,
  journal = {Nature Communications},
  volume = {8},
  number = {1},
  pages = {837},
  issn = {2041-1723},
  doi = {10.1038/s41467-017-00796-x},
  urldate = {2026-07-13},
  abstract = {Abstract                            Chronic liver disease is rising in western countries and liver cirrhosis is the 12th leading cause of death worldwide. Simultaneously, use of gastric acid suppressive medications is increasing. Here, we show that proton pump inhibitors promote progression of alcoholic liver disease, non-alcoholic fatty liver disease, and non-alcoholic steatohepatitis in mice by increasing numbers of intestinal               Enterococcus               spp. Translocating enterococci lead to hepatic inflammation and hepatocyte death. Expansion of intestinal               Enterococcus faecalis               is sufficient to exacerbate ethanol-induced liver disease in mice. Proton pump inhibitor use increases the risk of developing alcoholic liver disease among alcohol-dependent patients. Reduction of gastric acid secretion therefore appears to promote overgrowth of intestinal               Enterococcus               , which promotes liver disease, based on data from mouse models and humans. Recent increases in the use of gastric acid-suppressive medications might contribute to the increasing incidence of chronic liver disease.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/579X259K/Llorente et al. - 2017 - Gastric acid suppression promotes alcoholic liver disease by inducing overgrowth of intestinal Enter.pdf}
}

