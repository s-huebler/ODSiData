  journal = {Science},
  volume = {334},
  number = {6052},
  pages = {105--108},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.1208344},
  urldate = {2026-07-13},
  abstract = {The basic composition of the human gut microbiome is influenced by long-term diet: high fat and protein versus high fiber.           ,                             Diet strongly affects human health, partly by modulating gut microbiome composition. We used diet inventories and 16               S               rDNA sequencing to characterize fecal samples from 98 individuals. Fecal communities clustered into enterotypes distinguished primarily by levels of               Bacteroides               and               Prevotella               . Enterotypes were strongly associated with long-term diets, particularly protein and animal fat (               Bacteroides               ) versus carbohydrates (               Prevotella               ). A controlled-feeding study of 10 subjects showed that microbiome composition changed detectably within 24 hours of initiating a high-fat/low-fiber or low-fat/high-fiber diet, but that enterotype identity remained stable during the 10-day study. Thus, alternative enterotype states are associated with long-term diet.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/29VGEKEB/Wu et al. - 2011 - Linking Long-Term Dietary Patterns with Gut Microbial Enterotypes.pdf}
}

