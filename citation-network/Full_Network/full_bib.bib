@article{Zheng_2017,
  title = {Role of {{Autophagy}} in {{Tumor Necrosis Factor-$\alpha$-Induced Apoptosis}} of {{Osteoblast Cells}}},
  author = {Zheng, Liwen and Wang, Wanchun and Ni, Jiangdong and Mao, Xinzhan and Song, Deye and Liu, Tang and Wei, Jianwei and Zhou, Huaying},
  year = 2017,
  month = aug,
  journal = {Journal of Investigative Medicine},
  volume = {65},
  number = {6},
  pages = {1014--1020},
  issn = {1081-5589, 1708-8267},
  doi = {10.1136/jim-2017-000426},
  urldate = {2026-07-13},
  abstract = {The aim of this study is to investigate the role of tumor necrosis factor-{$\alpha$} (TNF-{$\alpha$}) in apoptosis and autophagy of mouse osteoblast MC3T3-E1 cells, as well as the crosstalk between autophagy and apoptosis. Mouse osteoblast MC3T3-E1 cells were cultured in vitro and treated with 5-fluorouracil (5-FU), rapamycin, 3-methyl adenine (3-MA) and TNF-{$\alpha$} either alone or in combination, respectively. MTT assays were used to monitor the cell viability upon different treatments. Annexin-V-FITC/propidium iodide (PI) staining was used to detect the apoptotic rate of osteoblasts. Autophagic structure and apoptotic bodies were visualized by transmission electron microscopy (TEM). Western blot analysis was performed to detect the autophagic marker LC3-II/I, p62 and apoptotic marker cleaved caspase-3. TNF-{$\alpha$} inhibits MC3T3-E1 cell viability in a dose-dependent and time-dependent manner. Annexin-V-FITC/PI staining, coupled with TEM, showed that TNF-{$\alpha$} induced cell apoptosis and autophagy in MC3T3-E1 cells. The autophagy inducer rapamycin ameliorated TNF-{$\alpha$}-induced apoptosis. In contrast, 3-MA, which is an autophagy inhibitor, caused an exaggerated induction of TNF-{$\alpha$}-induced apoptosis. TNF-{$\alpha$} upregulated autophagy marker LC3-II/I, but downregulated p62 in osteoblasts. Combined treatment of rapamycin and TNF-{$\alpha$} further exaggerated this effect, whereas co-treatment of 3-MA and TNF-{$\alpha$} decreased LC3-II/I, but increased p62 compared with TNF-{$\alpha$} alone. In addition, TNF-{$\alpha$} caused an induction of apoptotic marker cleaved caspase-3. TNF-{$\alpha$}-mediated induction of cleaved caspase-3 was downregulated by rapamycin, but upregulated by 3-MA, respectively. TNF-{$\alpha$} induced both autophagy and apoptosis in osteoblasts, and upregulated autophagy protects the cell by reducing TNF-{$\alpha$}-induced apoptosis.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/DUFU2LNX/Zheng et al. - 2017 - Role of Autophagy in Tumor Necrosis Factor-α-Induced Apoptosis of Osteoblast Cells.pdf}
}

@article{Zheng_2018,
  title = {Role of {{Vitamin A}} in {{Modulating Graft-versus-Host Disease}}},
  author = {Zheng, Jianwei and Taylor, Brian and Chen, Xiao},
  year = 2018,
  journal = {Journal of Immunology Research and Therapy},
  volume = {3},
  number = {1},
  pages = {124--128},
  issn = {2472-727X},
  abstract = {Vitamin A is an essential micronutrient that participates in a wide range of biological processes. Retinoic acid (RA) is an active metabolite of vitamin A that functions as an immune regulator. Graft-versus-host disease (GVHD) is a major complication of allogeneic hematopoietic stem cell transplantation (HSCT). It is characterized by extensive inflammation arising from an alloimmune response involving various host and donor immune cells. Since vitamin A affects different immune cell lineages and regulates an array of immune responses, vitamin A, and more specifically retinoic acid, is likely to influence the incidence and/or severity of GVHD. Indeed, recent preclinical and clinical data support this concept. In this review, we briefly summarize recent advances in our understanding of the potential role of vitamin A in modulating GVHD risk after allogeneic HSCT.},
  langid = {english},
  pmcid = {PMC6086377},
  pmid = {30101210},
  keywords = {Allogeneic hematopoietic stem cell transplantation,Graft-versus-host disease,Retinoic acid,Vitamin A}
}

@article{Zheng_2020,
  title = {Interaction between Microbiota and Immunity in Health and Disease},
  author = {Zheng, Danping and Liwinski, Timur and Elinav, Eran},
  year = 2020,
  month = jun,
  journal = {Cell Research},
  volume = {30},
  number = {6},
  pages = {492--506},
  issn = {1001-0602, 1748-7838},
  doi = {10.1038/s41422-020-0332-7},
  urldate = {2026-07-13},
  abstract = {Abstract             The interplay between the commensal microbiota and the mammalian immune system development and function includes multifold interactions in homeostasis and disease. The microbiome plays critical roles in the training and development of major components of the host's innate and adaptive immune system, while the immune system orchestrates the maintenance of key features of host-microbe symbiosis. In a genetically susceptible host, imbalances in microbiota-immunity interactions under defined environmental contexts are believed to contribute to the pathogenesis of a multitude of immune-mediated disorders. Here, we review features of microbiome-immunity crosstalk and their roles in health and disease, while providing examples of molecular mechanisms orchestrating these interactions in the intestine and extra-intestinal organs. We highlight aspects of the current knowledge, challenges and limitations in achieving causal understanding of host immune-microbiome interactions, as well as their impact on immune-mediated diseases, and discuss how these insights may translate towards future development of microbiome-targeted therapeutic interventions.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/XKZX5ZVG/Zheng et al. - 2020 - Interaction between microbiota and immunity in health and disease.pdf}
}

