@article{Miltiadous_2022,
  title = {Early Intestinal Microbial Features Are Associated with {{CD4 T-cell}} Recovery after Allogeneic Hematopoietic Transplant},
  author = {Miltiadous, Oriana and Waters, Nicholas R. and Andrlov{\'a}, Hana and Dai, Anqi and Nguyen, Chi L. and Burgos Da Silva, Marina and Lindner, Sarah and Slingerland, John and Giardina, Paul and Clurman, Annelie and Armijo, Gabriel K. and Gomes, Antonio L. C. and Lakkaraja, Madhavi and Maslak, Peter and Scordo, Michael and Shouval, Roni and Staffas, Anna and O'Reilly, Richard and Taur, Ying and Prockop, Susan and Boelens, Jaap Jan and Giralt, Sergio and Perales, Miguel-Angel and Devlin, Sean M. and Peled, Jonathan U. and Markey, Kate A. and Van Den Brink, Marcel R. M.},
  year = 2022,
  month = may,
  journal = {Blood},
  volume = {139},
  number = {18},
  pages = {2758--2769},
  issn = {0006-4971, 1528-0020},
  doi = {10.1182/blood.2021014255},
  urldate = {2026-07-13},
  abstract = {Abstract             Low intestinal microbial diversity is associated with poor outcomes after allogeneic hematopoietic cell transplantation (HCT). Using 16S rRNA sequencing of 2067 stool samples and flow cytometry data from 2370 peripheral blood samples drawn from 894 patients who underwent allogeneic HCT, we have linked features of the early post-HCT microbiome with subsequent immune cell recovery. We examined lymphocyte recovery and microbiota features in recipients of both unmodified and CD34-selected allografts. We observed that fecal microbial diversity was an independent predictor of CD4 T-cell count 3 months after HCT in recipients of a CD34-selected allograft, who are dependent on de novo lymphopoiesis for their immune recovery. In multivariate models using clinical factors and microbiota features, we consistently observed that increased fecal relative abundance of genus Staphylococcus during the early posttransplant period was associated with worse CD4 T-cell recovery. Our observations suggest that the intestinal bacteria, or the factors they produce, can affect early lymphopoiesis and the homeostasis of allograft-derived T cells after transplantation.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/VEPZHEV6/Miltiadous et al. - 2022 - Early intestinal microbial features are associated with CD4 T-cell recovery after allogeneic hematop.pdf}
}

