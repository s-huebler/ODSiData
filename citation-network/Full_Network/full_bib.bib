@article{Liu_2012a,
  title = {Phosphoketolase {{Pathway}} for {{Xylose Catabolism}} in {{Clostridium}} Acetobutylicum {{Revealed}} By{\textsuperscript{13}} {{C Metabolic Flux Analysis}}},
  author = {Liu, Lixia and Zhang, Lei and Tang, Wei and Gu, Yang and Hua, Qiang and Yang, Sheng and Jiang, Weihong and Yang, Chen},
  year = 2012,
  month = oct,
  journal = {Journal of Bacteriology},
  volume = {194},
  number = {19},
  pages = {5413--5422},
  issn = {0021-9193, 1098-5530},
  doi = {10.1128/JB.00713-12},
  urldate = {2026-07-13},
  abstract = {ABSTRACT                            Solvent-producing clostridia are capable of utilizing pentose sugars, including xylose and arabinose; however, little is known about how pentose sugars are catabolized through the metabolic pathways in clostridia. In this study, we identified the xylose catabolic pathways and quantified their fluxes in               Clostridium acetobutylicum               based on [1-               13               C]xylose labeling experiments. The phosphoketolase pathway was found to be active, which contributed up to 40\% of the xylose catabolic flux in               C. acetobutylicum               . The split ratio of the phosphoketolase pathway to the pentose phosphate pathway was markedly increased when the xylose concentration in the culture medium was increased from 10 to 20 g liter               -1               . To our knowledge, this is the first time that the               in vivo               activity of the phosphoketolase pathway in clostridia has been revealed. A phosphoketolase from               C. acetobutylicum               was purified and characterized, and its activity with xylulose-5-P was verified. The phosphoketolase was overexpressed in               C. acetobutylicum               , which resulted in slightly increased xylose consumption rates during the exponential growth phase and a high level of acetate accumulation.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/UIQU6XY7/Liu et al. - 2012 - Phosphoketolase Pathway for Xylose Catabolism in Clostridium acetobutylicum Revealed by13.pdf}
}

@article{Liu_2012b,
  title = {Targeted Genes and Interacting Proteins of Hypoxia Inducible Factor-1},
  author = {Liu, Wei and Shen, Shao-Ming and Zhao, Xu-Yun and Chen, Guo-Qiang},
  year = 2012,
  journal = {International Journal of Biochemistry and Molecular Biology},
  volume = {3},
  number = {2},
  pages = {165--178},
  issn = {2152-4114},
  abstract = {Heterodimeric transcription factor hypoxia inducible factor-1 (HIF-1) functions as a master regulator of oxygen homeostasis in almost all nucleated mammalian cells. The fundamental process adapted to cellular oxygen alteration largely depends on the refined regulation on its alpha subunit, HIF-1{$\alpha$}. Recent studies have unraveled expanding and critical roles of HIF-1{$\alpha$}, involving in a multitude of developmental, physiological, and pathophysiological processes. This review will focus on the current knowledge of HIF-1{$\alpha$}-targeting genes and its interacting proteins, as well as the concomitant functional relationships between them.},
  langid = {english},
  pmcid = {PMC3388736},
  pmid = {22773957},
  keywords = {Hypoxia inducible factor-1alpha,interacting protein,targeting gene}
}

@article{Liu_2015,
  title = {Cutting {{Edge}}: {{Hematopoietic Stem Cell Expansion}} and {{Common Lymphoid Progenitor Depletion Require Hematopoietic-Derived}}, {{Cell-Autonomous TLR4}} in a {{Model}} of {{Chronic Endotoxin}}},
  shorttitle = {Cutting {{Edge}}},
  author = {Liu, Ailing and Wang, Yujuan and Ding, Ying and Baez, Ineavely and Payne, Kimberly J and Borghesi, Lisa},
  year = 2015,
  month = sep,
  journal = {The Journal of Immunology},
  volume = {195},
  number = {6},
  pages = {2524--2528},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.1501231},
  urldate = {2026-07-13},
  abstract = {Abstract             Hematopoietic stem and progenitors cells (HSPCs) are activated through TLR4 in vitro. However, it remains unclear whether in vivo TLR4 sensing by HSPCs occurs directly or via other cell intermediates. In this study, we examined the cellular mechanisms underlying murine hematopoietic stem cell (HSC) expansion and common lymphoid progenitor (CLP) depletion in a model of chronic low-dose LPS. Using adoptive-transfer approaches, we show that HSC and CLP sensitivity to chronic LPS depends on hematopoietic-derived, cell subset--autonomous TLR4. Like murine progenitors, human HSPCs are activated by TLR4 in vitro. Using humanized mice, a preclinical model relevant to human physiology, we show that persistent endotoxin increases the frequency of Ki-67+ HSCs and severely depletes CLPs and B precursors. Together, our findings show that murine HSPCs directly respond to endotoxin in vivo and that persistent LPS, a feature of several diseases of global health significance, impairs human lymphopoiesis.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

