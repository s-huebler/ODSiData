@article{Ziegler_2019,
  title = {Impact of {{Levofloxacin}} for the {{Prophylaxis}} of {{Bloodstream Infection}} on the {{Gut Microbiome}} in {{Patients With Hematologic Malignancy}}},
  author = {Ziegler, Matthew and Han, Jennifer H and Landsburg, Daniel and Pegues, David and Reesey, Emily and Gilmar, Cheryl and Gorman, Theresa and Bink, Kristen and Moore, Amy and Kelly, Brendan J and CDC Prevention Epicenters Program},
  year = 2019,
  month = jul,
  journal = {Open Forum Infectious Diseases},
  volume = {6},
  number = {7},
  pages = {ofz252},
  issn = {2328-8957},
  doi = {10.1093/ofid/ofz252},
  urldate = {2026-07-13},
  abstract = {Abstract                            Background               We evaluated the differential impact of levofloxacin administered for the prophylaxis of bloodstream infections compared with broad-spectrum beta-lactam (BSBL) antibiotics used for the treatment of neutropenic fever on the gut microbiome in patients with hematologic malignancy.                                         Methods               Stool specimens were collected from patients admitted for chemotherapy or stem cell transplant in the setting of the evaluation of diarrhea from February 2017 until November 2017. Microbiome characteristics were compared among those exposed to levofloxacin prophylaxis vs those who received BSBL antibiotics.                                         Results               Sixty patients were included, most with acute myeloid leukemia (42\%) or multiple myeloma (37\%). The gut microbiome of patients with BSBL exposure had significantly reduced Shannon's alpha diversity compared with those without (median [interquartile range \textbraceleft IQR\textbraceright ], 3.28 [1.73 to 3.71] vs 3.73 [3.14 to 4.31]; P = .01). However, those with levofloxacin exposure had increased alpha diversity compared with those without (median [IQR], 3.83 [3.32 to 4.36] vs 3.32 [2.35 to 4.02]; P = .03). Levofloxacin exposure was also associated with a trend toward lower risk of dominance of non-Bacteroidetes genera compared with those without levofloxacin exposure (3 [14\%] vs 15 [38\%]; P = .051).                                         Conclusions               The impact of antibiotics on the gut microbiome varies by class, and levofloxacin may disrupt the gut microbiome less than BSBLs in this patient population.},
  copyright = {http://creativecommons.org/licenses/by-nc-nd/4.0/},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/URHN48BE/Ziegler et al. - 2019 - Impact of Levofloxacin for the Prophylaxis of Bloodstream Infection on the Gut Microbiome in Patient.pdf}
}

