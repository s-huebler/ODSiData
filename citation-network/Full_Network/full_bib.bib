  journal = {Nature Biotechnology},
  volume = {39},
  number = {1},
  pages = {105--114},
  issn = {1087-0156, 1546-1696},
  doi = {10.1038/s41587-020-0603-3},
  urldate = {2026-07-13},
  abstract = {Abstract             Comprehensive, high-quality reference genomes are required for functional characterization and taxonomic assignment of the human gut microbiota. We present the Unified Human Gastrointestinal Genome (UHGG) collection, comprising 204,938 nonredundant genomes from 4,644 gut prokaryotes. These genomes encode {$>$}170 million protein sequences, which we collated in the Unified Human Gastrointestinal Protein (UHGP) catalog. The UHGP more than doubles the number of gut proteins in comparison to those present in the Integrated Gene Catalog. More than 70\% of the UHGG species lack cultured representatives, and 40\% of the UHGP lack functional annotations. Intraspecies genomic variation analyses revealed a large reservoir of accessory genes and single-nucleotide variants, many of which are specific to individual human populations. The UHGG and UHGP collections will enable studies linking genotypes to phenotypes in the human gut microbiome.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/AHQFTTWV/Almeida et al. - 2021 - A unified catalog of 204,938 reference genomes from the human gut microbiome.pdf}
}

