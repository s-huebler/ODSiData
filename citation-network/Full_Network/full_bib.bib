@article{Gao_2016a,
  title = {Phase {{II Multicenter}}, {{Randomized}}, {{Double-Blind Controlled Study}} of {{Efficacy}} and {{Safety}} of {{Umbilical Cord}}--{{Derived Mesenchymal Stromal Cells}} in the {{Prophylaxis}} of {{Chronic Graft-Versus-Host Disease After HLA-Haploidentical Stem-Cell Transplantation}}},
  author = {Gao, Lei and Zhang, Yanqi and Hu, Baoyang and Liu, Jia and Kong, Peiyan and Lou, Shifeng and Su, Yi and Yang, Tonghua and Li, Huimin and Liu, Yao and Zhang, Cheng and Gao, Li and Zhu, Lidan and Wen, Qin and Wang, Ping and Chen, Xinghua and Zhong, Jiangfan and Zhang, Xi},
  year = 2016,
  month = aug,
  journal = {Journal of Clinical Oncology},
  volume = {34},
  number = {24},
  pages = {2843--2850},
  issn = {0732-183X, 1527-7755},
  doi = {10.1200/JCO.2015.65.3642},
  urldate = {2026-07-13},
  abstract = {Purpose               Although mesenchymal stromal cells (MSCs) possess immunomodulatory properties and exhibit promising efficacy against chronic graft-versus-host disease (cGVHD), little is known about the efficacy of MSCs in the prophylaxis of cGVHD after HLA-haploidentical hematopoietic stem-cell transplantation (HLA-haplo HSCT).                                         Patients and Methods               In this multicenter, double-blind, randomized controlled trial, we investigated the incidence and severity of cGVHD among patients, and the changes in T, B, and natural killer (NK) cells after the repeated infusion of MSCs.                                         Results               The 2-year cumulative incidence of cGVHD in the MSCs group was 27.4\% (95\% CI, 16.2\% to 38.6\%), compared with 49.0\% (95\% CI, 36.5\% to 61.5\%) in the non-MSCs control group (P = .021). Seven patients in the non-MSCs control group had severe lung cGVHD, but no patients in the MSCs group developed typical lung cGVHD (P = .047). After the MSC infusions, increasing memory B lymphocytes and regulatory T cells, as well as the ratio of type 1 T helper to type 2 T helper cells, were observed, whereas the number of NK cells decreased.                                         Conclusion               Our findings suggest that the repeated infusion of MSCs might inhibit cGVHD symptoms in patients after HLA-haplo HSCT, accompanied by changes in the numbers and subtypes of T, B, and NK cells, leading to the acquisition of immune tolerance.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

