@article{Gao_2016,
  title = {Mesenchymal Stem Cells and Immunomodulation: Current Status and Future Prospects},
  shorttitle = {Mesenchymal Stem Cells and Immunomodulation},
  author = {Gao, F and Chiu, S M and Motan, D A L and Zhang, Z and Chen, L and Ji, H-L and Tse, H-F and Fu, Q-L and Lian, Q},
