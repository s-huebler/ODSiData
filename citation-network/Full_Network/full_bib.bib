@article{Josefowicz_2012,
  title = {Regulatory {{T Cells}}: {{Mechanisms}} of {{Differentiation}} and {{Function}}},
  shorttitle = {Regulatory {{T Cells}}},
  author = {Josefowicz, Steven Z. and Lu, Li-Fan and Rudensky, Alexander Y.},
