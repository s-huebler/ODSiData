@article{Brailey_2020,
  title = {{{NKT}} Cells and the Regulation of Intestinal Immunity: A Two-way Street},
  shorttitle = {{{NKT}} Cells and the Regulation of Intestinal Immunity},
  author = {Brailey, Phillip M. and Lebrusant-Fernandez, Marta and Barral, Patricia},
  year = 2020,
  month = may,
  journal = {The FEBS Journal},
  volume = {287},
  number = {9},
  pages = {1686--1699},
  issn = {1742-464X, 1742-4658},
  doi = {10.1111/febs.15238},
  urldate = {2026-07-13},
  abstract = {The mammalian gastrointestinal compartment is colonised by millions of microorganisms that have a central influence on human health. Intestinal homeostasis requires a continuous dialogue between the commensal bacteria and intestinal immune cells. While interactions between host and commensal bacteria are normally beneficial, allowing training and functional tuning of immune cells, dysregulated immune system--microbiota crosstalk can favour the development of chronic inflammatory diseases, as it is the case for inflammatory bowel disease (IBD). Natural killer T (NKT) cells, which recognise CD1-restricted microbial and self-lipids, contribute to the regulation of mucosal immunity by controlling intestinal homeostasis and participating in the development of IBD. Here, we provide an overview of the recently identified pathways underlying the crosstalk between commensal bacteria and NKT cells and discuss the effect of these interactions in intestinal health and disease.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/MSZR9J2V/Brailey et al. - 2020 - NKT cells and the regulation of intestinal immunity a two‐way street.pdf}
}

