  author = {Kim, Kyung-Ah and Kakitani, Makoto and Zhao, Jingsong and Oshima, Takeshi and Tang, Tom and Binnerts, Minke and Liu, Yi and Boyle, Bryan and Park, Emily and Emtage, Peter and Funk, Walter D. and Tomizuka, Kazuma},
