@article{Avery_2022,
  title = {Maribavir for {{Refractory Cytomegalovirus Infections With}} or {{Without Resistance Post-Transplant}}: {{Results From}} a {{Phase}} 3 {{Randomized Clinical Trial}}},
  shorttitle = {Maribavir for {{Refractory Cytomegalovirus Infections With}} or {{Without Resistance Post-Transplant}}},
  author = {Avery, Robin K and Alain, Sophie and Alexander, Barbara D and Blumberg, Emily A and Chemaly, Roy F and Cordonnier, Catherine and Duarte, Rafael F and Florescu, Diana F and Kamar, Nassim and Kumar, Deepali and Maertens, Johan and Marty, Francisco M and Papanicolaou, Genovefa A and Silveira, Fernanda P and Witzke, Oliver and Wu, Jingyang and Sundberg, Aimee K and Fournier, Martha and SOLSTICE Trial Investigators},
  year = 2022,
  month = sep,
  journal = {Clinical Infectious Diseases},
  volume = {75},
  number = {4},
  pages = {690--701},
  issn = {1058-4838, 1537-6591},
  doi = {10.1093/cid/ciab988},
  urldate = {2026-07-13},
  abstract = {Abstract                            Background               Therapies for refractory cytomegalovirus infections (with or without resistance [R/R]) in transplant recipients are limited by toxicities. Maribavir has multimodal anti-cytomegalovirus activity through the inhibition of UL97 protein kinase.                                         Methods               In this phase 3, open-label study, hematopoietic-cell and solid-organ transplant recipients with R/R cytomegalovirus were randomized 2:1 to maribavir 400~mg twice daily or investigator-assigned therapy (IAT; valganciclovir/ganciclovir, foscarnet, or cidofovir) for 8 weeks, with 12 weeks of follow-up. The primary endpoint was confirmed cytomegalovirus clearance at end of week 8. The key secondary endpoint was achievement of cytomegalovirus clearance and symptom control at end of week 8, maintained through week 16.                                         Results               352 patients were randomized (235 maribavir; 117 IAT). Significantly more patients in the maribavir versus IAT group achieved the primary endpoint (55.7\% vs 23.9\%; adjusted difference [95\% confidence interval (CI)]: 32.8\% [22.80--42.74]; P\>\&lt;\>.001) and key secondary endpoint (18.7\% vs 10.3\%; adjusted difference [95\% CI]: 9.5\% [2.02--16.88]; P\>=\>.01). Rates of treatment-emergent adverse events (TEAEs) were similar between groups (maribavir, 97.4\%; IAT, 91.4\%). Maribavir was associated with less acute kidney injury versus foscarnet (8.5\% vs 21.3\%) and neutropenia versus valganciclovir/ganciclovir (9.4\% vs 33.9\%). Fewer patients discontinued treatment due to TEAEs with maribavir (13.2\%) than IAT (31.9\%). One patient per group had fatal treatment-related TEAEs.                                         Conclusions               Maribavir was superior to IAT for cytomegalovirus viremia clearance and viremia clearance plus symptom control maintained post-therapy in transplant recipients with R/R cytomegalovirus. Maribavir had fewer treatment discontinuations due to TEAEs than IAT.               Clinical Trials Registration. NCT02931539 (SOLSTICE).},
  copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0/},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/C5KCY2FF/Avery et al. - 2022 - Maribavir for Refractory Cytomegalovirus Infections With or Without Resistance Post-Transplant Resu.pdf}
}

