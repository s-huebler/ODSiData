  author = {Joo, Erina and Yamane, Shunsuke and Hamasaki, Akihiro and Harada, Norio and Matsunaga, Tetsuro and Muraoka, Atsushi and Suzuki, Kazuyo and Nasteska, Daniela and Fukushima, Toru and Hayashi, Tatsuya and Tsuji, Hidemi and Shide, Kenichiro and Tsuda, Kinsuke and Inagaki, Nobuya},
  year = 2013,
