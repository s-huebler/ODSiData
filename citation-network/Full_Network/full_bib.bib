  journal = {The Journal of Immunology},
  volume = {190},
  number = {10},
  pages = {5306--5312},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.1300016},
  urldate = {2026-07-13},
  abstract = {Abstract             IL-22 is a good candidate to play a critical role in regulating gut microbiota because it is an important inducer of antimicrobial peptides and mucins in the gut. However, whether IL-22 participates in immune homeostasis by way of modulating gut microbiota remains to be elucidated. In this study, we find, through 16S rRNA gene-pyrosequencing analysis, that healthy IL-22--deficient mice had altered colonic microbiota, notably with decreased abundance of some genera, including Lactobacillus, and increased levels of others. Mice harboring this altered microbiota exhibited more severe disease during experimentally induced colitis. Interestingly, this altered gut microbiota can be transmitted to cohoused wild-type animals along with the increased susceptibility to this colitis, indicating an important role for IL-22 in shaping the homeostatic balance between immunity and colonic microbiota for host health.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/ULTRNFEV/Zenewicz et al. - 2013 - IL-22 Deficiency Alters Colonic Microbiota To Be Transmissible and Colitogenic.pdf}
}

