@article{Ball_2013,
  title = {Multiple Infusions of Mesenchymal Stromal Cells Induce Sustained Remission in Children with Steroid-refractory, Grade {{{\textsc{III}}}} -- {{{\textsc{IV}}}} Acute Graft-versus-host Disease},
  shorttitle = {Multiple Infusions of Mesenchymal Stromal Cells Induce Sustained Remission in Children with Steroid-refractory, Grade},
  author = {Ball, Lynne M. and Bernardo, Maria E. and Roelofs, Helene and Van Tol, Maarten J. D. and Contoli, Benedetta and Zwaginga, Jaap Jan and Avanzini, Maria Antonia and Conforti, Antonella and Bertaina, Alice and Giorgiani, Giovanna and Jol-van Der Zijde, Cornelia M. and Zecca, Marco and Le Blanc, Katarina and Frassoni, Francesco and Egeler, Rudolph Maarten and Fibbe, Willem E. and Lankester, Arjan C. and Locatelli, Franco},
  year = 2013,
  month = nov,
  journal = {British Journal of Haematology},
  volume = {163},
  number = {4},
  pages = {501--509},
  issn = {0007-1048, 1365-2141},
  doi = {10.1111/bjh.12545},
  urldate = {2026-07-13},
  abstract = {Summary                            Mesenchymal stromal cell (               MSC               ) infusions have been reported to be effective in patients with steroid-refractory, acute graft-versus-host disease (a               G               v               HD               ) but comprehensive data on paediatric patients are limited. We retrospectively analysed a cohort of 37 children (aged 3~months-17~years) treated with               MSC               s for steroid-refractory grade               III               --               IV               a               G               v               HD               . All patients but three received multiple               MSC               infusions. Complete response (               CR               ) was observed in 24 children (65\%), while 13 children had either partial (               n~               =~8) or no response (               n~               =~5). Cumulative incidence of transplantation-related mortality (               TRM               ) in patients who did or did not achieve               CR               was 17\% and 69\%, respectively (               P~               =~0{$\cdot$}001). After a median follow-up of 2{$\cdot$}9~years, overall survival (               OS               ) was 37\%; it was 65\% vs. 0\% in patients who did or did not achieve               CR               , respectively (               P~               =~0{$\cdot$}001). The median time from starting steroids for               G               v               HD               treatment to first               MSC               infusion was 13~d (range 5--85). Children treated between 5 and 12~d after steroid initiation showed a trend for better               OS               (56\%) and lower               TRM               (17\%) as compared with patients receiving               MSC               s 13--85~d after steroids (25\% and 53\%, respectively;               P~               =~0{$\cdot$}22 and 0{$\cdot$}06, respectively). Multiple               MSC               infusions are safe and effective for children with steroid-refractory a               G               v               HD               , especially when employed early in the disease course.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/8ZKXLLGP/Ball et al. - 2013 - Multiple infusions of mesenchymal stromal cells induce sustained remission in children with steroid‐.pdf}
}

