@article{Johansson_1993,
  title = {Administration of Different {{Lactobacillus}} Strains in Fermented Oatmeal Soup: In Vivo Colonization of Human Intestinal Mucosa and Effect on the Indigenous Flora},
  shorttitle = {Administration of Different {{Lactobacillus}} Strains in Fermented Oatmeal Soup},
  author = {Johansson, M L and Molin, G and Jeppsson, B and Nobaek, S and Ahrn{\'e}, S and Bengmark, S},
  year = 1993,
