@article{Bloushtain_2004,
  title = {Membrane-{{Associated Heparan Sulfate Proteoglycans Are Involved}} in the {{Recognition}} of {{Cellular Targets}} by {{NKp30}} and {{NKp46}}},
  author = {Bloushtain, Noga and Qimron, Udi and {Bar-Ilan}, Ahuva and Hershkovitz, Oren and Gazit, Roi and Fima, Eyal and Korc, Murray and Vlodavsky, Israel and Bovin, Nicolai V and Porgador, Angel},
  year = 2004,
  month = aug,
  journal = {The Journal of Immunology},
  volume = {173},
  number = {4},
  pages = {2392--2401},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.173.4.2392},
  urldate = {2026-07-13},
  abstract = {Abstract             Lysis of virus-infected and tumor cells by NK cells is mediated via natural cytotoxicity receptors (NCRs). We have recently shown that the NKp44 and NKp46 NCRs, but not the NKp30, recognize viral hemagglutinins. In this study we explored the nature of the cellular ligands recognized by the NKp30 and NKp46 NCRs. We demonstrate that target cell surface heparan sulfate proteoglycans (HSPGs) are recognized by NKp30 and NKp46 and that 6-O-sulfation and N-acetylation state of the glucose building unit affect this recognition and lysis by NK cells. Tumor cells expressing cell surface heparanase, CHO cells lacking membranal heparan sulfate and glypican-1-suppressed pancreatic cancer cells manifest reduced recognition by NKp30 and NKp46 and are lysed to a lesser extent by NK cells. Our results are the first clue for the identity of the ligands for NKp30 and NKp46. Whether the ligands are particular HSPGs, unusual heparan sulfate epitopes, or a complex of HSPGs and either other protein or lipid moieties remains to be further explored.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

