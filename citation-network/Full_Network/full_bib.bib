@article{Goloshchapov_2020,
  title = {Fecal Microbiota Transplantation for Graft-versus-Host Disease in Children and Adults: Methods, Clinical Effects, Safety},
  shorttitle = {Fecal Microbiota Transplantation for Graft-versus-Host Disease in Children and Adults},
  author = {Goloshchapov, O. V. and Chukhlovin, A. B. and Bakin, E. A. and Stanevich, O. V. and Klementeva, R. V. and Shcherbakov, A. A. and Shvetsov, A. N. and Suvorova, M. A. and Bondarenko, S. N. and Kucher, M. A. and Kulagin, A. D. and Zubarovskaya, L. S. and Moiseev, I. S.},
  year = 2020,
  month = sep,
  journal = {Terapevticheskii arkhiv},
  volume = {92},
  number = {7},
  pages = {43--54},
  issn = {2309-5342, 0040-3660},
  doi = {10.26442/00403660.2020.07.000773},
  urldate = {2026-07-13},
  abstract = {Aim.Was to evaluate clinical efficacy, adverse events and changes in the gut microbiome after fecal microbiota transplantation (FMT) in patients with gastrointestinal (GI) form of graft-versus-host disease (GVHD). Materials and methods.The prospective single-center study in R.M. Gorbacheva institute included 27 patients with GI GVHD after allogeneic stem cell transplantation. 19 patients received FMT, 8 patients received placebo. Clinical scales for GI autoimmune diseases were used to evaluate response. Microbiome alterations were assessed with multiplex PCR. Results.After FMT higher overall bacterial mass (\cyrchar\cyrr =0.00088), higher bacterial numbers ofBifidobacteriumspp. (\cyrchar\cyrr =0.021),Escherichia coli(\cyrchar\cyrr =0.049) andBacteroides fragilisgr. (\cyrchar\cyrr =0.000043) compared to placebo group. Also higher bacterial mass was observed in patients with clinical response (\cyrchar\cyrr =0.0057). The bacterial mass after procedure in non-responders was compared to the placebo group (\cyrchar\cyrr =0.31). Partial response of GVHD was achieved faster in the FMT group compared to placebo (median 4 days vs 48 days,p=0.014). Complete response was observed in 8 (42\%), 14 (74\%) and 16 (84\%) at 30, 60 and 90 days respectively, while in the placebo group only 0\%, 1 (13\%) and 4 (50\%) achieved complete response at the same time points. The incidence and severity of adverse events was comparable between FMT and the placebo group. Conclusion.FMT in patients with refractory GI GVHD was associated with favorable clinical outcomes and recovery in certain marker bacterial populations. Multiplex PCR can be used to assess an engraftment of a donor microbiota. FMT in GI GVHD was not associated with life-threatening adverse events, but further studies are required to validate clinical efficacy.},
  copyright = {https://creativecommons.org/licenses/by-nc-sa/4.0},
  keywords = {CrossRef Failed},
  file = {/Users/sophiehuebler/Zotero/storage/W8N6JMQG/Goloshchapov et al. - 2020 - Fecal microbiota transplantation for graft-versus-host disease in children and adults methods, clin.pdf}
}

