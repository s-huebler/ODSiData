@article{Ponce_2023,
  title = {A Phase 2 Study of Interleukin-22 and Systemic Corticosteroids as Initial Treatment for Acute {{GVHD}} of the Lower {{GI}} Tract},
  author = {Ponce, Doris M. and Alousi, Amin M. and Nakamura, Ryotaro and Slingerland, John and Calafiore, Marco and Sandhu, Karamjeet S. and Barker, Juliet N. and Devlin, Sean and Shia, Jinru and Giralt, Sergio and Perales, Miguel-Angel and Moore, Gillian and Fatmi, Samira and Soto, Cristina and Gomes, Antonio and Giardina, Paul and Marcello, LeeAnn and Yan, Xiaoqiang and Tang, Tom and Dreyer, Kevin and Chen, Jianmin and Daley, William L. and Peled, Jonathan U. and Van Den Brink, Marcel R. M. and Hanash, Alan M.},
  year = 2023,
  month = mar,
  journal = {Blood},
  volume = {141},
  number = {12},
  pages = {1389--1401},
  issn = {0006-4971, 1528-0020},
  doi = {10.1182/blood.2021015111},
  urldate = {2026-07-13},
  abstract = {Abstract             Graft-versus-host disease (GVHD) is a major cause of morbidity and mortality following allogeneic hematopoietic transplantation. In experimental models, interleukin-22 promotes epithelial regeneration and induces innate antimicrobial molecules. We conducted a multicenter single-arm phase 2 study evaluating the safety and efficacy of a novel recombinant human interleukin-22 dimer, F-652, used in combination with systemic corticosteroids for treatment of newly diagnosed lower gastrointestinal acute GVHD. The most common adverse events were cytopenias and electrolyte abnormalities, and there were no dose-limiting toxicities. Out of 27 patients, 19 (70\%; 80\% confidence interval, 56\%-79\%) achieved a day-28 treatment response, meeting the prespecified primary endpoint. Responders exhibited a distinct fecal microbiota composition characterized by expansion of commensal anaerobes, which correlated with increased overall microbial {$\alpha$}-diversity, suggesting improvement of GVHD-associated dysbiosis. This work demonstrates a potential approach for combining immunosuppression with tissue-supportive strategies to enhance recovery of damaged mucosa and promote microbial health in patients with gastrointestinal GVHD. This trial was registered at www.clinicaltrials.gov as NCT02406651.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

