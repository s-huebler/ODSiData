@article{LeBlanc_2004,
  title = {Treatment of Severe Acute Graft-versus-Host Disease with Third Party Haploidentical Mesenchymal Stem Cells},
  author = {Le Blanc, Katarina and Rasmusson, Ida and Sundberg, Berit and G{\"o}therstr{\"o}m, Cecilia and Hassan, Moustapha and Uzunel, Mehmet and Ringd{\'e}n, Olle},
  year = 2004,
  month = may,
