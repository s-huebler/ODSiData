@article{Girardin_2003,
  title = {Nod1 {{Detects}} a {{Unique Muropeptide}} from {{Gram-Negative Bacterial Peptidoglycan}}},
  author = {Girardin, Stephen E. and Boneca, Ivo G. and Carneiro, Leticia A. M. and Antignac, Aude and J{\'e}hanno, Muguette and Viala, J{\'e}r{\^o}me and Tedin, Karsten and Taha, Muhamed-Kheir and Labigne, Agn{\`e}s and Z{\"a}thringer, Ulrich and Coyle, Anthony J. and DiStefano, Peter S. and Bertin, John and Sansonetti, Philippe J. and Philpott, Dana J.},
