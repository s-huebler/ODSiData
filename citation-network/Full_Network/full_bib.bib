@article{Constantin_2024,
  title = {Microbiome and Cancer: From Mechanistic Implications in Disease Progression and Treatment to Development of Novel Antitumoral Strategies},
  shorttitle = {Microbiome and Cancer},
  author = {Constantin, Marian and Chifiriuc, Mariana Carmen and Mihaescu, Grigore and Corcionivoschi, Nicolae and Burlibasa, Liliana and Bleotu, Coralia and Tudorache, Sorin and Mitache, Magda Mihaela and Filip, Roxana and Munteanu, Simona-Gloria and Gradisteanu Pircalabioru, Gratiela},
  year = 2024,
  month = apr,
  journal = {Frontiers in Immunology},
  volume = {15},
  pages = {1373504},
  issn = {1664-3224},
  doi = {10.3389/fimmu.2024.1373504},
  urldate = {2026-07-13},
  abstract = {Cancer is a very aggressive disease and one of mankind's most important health problems, causing numerous deaths each year. Its etiology is complex, including genetic, gender-related, infectious diseases, dysbiosis, immunological imbalances, lifestyle, including dietary factors, pollution etc. Cancer patients also become immunosuppressed, frequently as side effects of chemotherapy and radiotherapy, and prone to infections, which further promote the proliferation of tumor cells. In recent decades, the role and importance of the microbiota in cancer has become a hot spot in human biology research, bringing together oncology and human microbiology. In addition to their roles in the etiology of different cancers, microorganisms interact with tumor cells and may be involved in modulating their response to treatment and in the toxicity of anti-tumor therapies. In this review, we present an update on the roles of microbiota in cancer with a focus on interference with anticancer treatments and anticancer potential.},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/XCCS5YID/Constantin et al. - 2024 - Microbiome and cancer from mechanistic implications in disease progression and treatment to develop.pdf}
}

