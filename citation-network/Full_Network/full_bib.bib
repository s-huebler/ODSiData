@article{Wu_2013,
  title = {Thymic {{Damage}}, {{Impaired Negative Selection}}, and {{Development}} of {{Chronic Graft-versus-Host Disease Caused}} by {{Donor CD4}}+ and {{CD8}}+ {{T Cells}}},
  author = {Wu, Tao and Young, James S and Johnston, Heather and Ni, Xiong and Deng, Ruishu and Racine, Jeremy and Wang, Miao and Wang, Audrey and Todorov, Ivan and Wang, Jianmin and Zeng, Defu},
  year = 2013,
  month = jul,
  journal = {The Journal of Immunology},
  volume = {191},
  number = {1},
  pages = {488--499},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.1300657},
  urldate = {2026-07-13},
  abstract = {Abstract             Prevention of chronic graft-versus-host disease (cGVHD) remains a major challenge in allogeneic hematopoietic cell transplantation (HCT) owing to limited understanding of cGVHD pathogenesis and lack of appropriate animal models. In this study, we report that, in classical acute GVHD models with C57BL/6 donors and MHC-mismatched BALB/c recipients and with C3H.SW donors and MHC-matched C57BL/6 recipients, GVHD recipients surviving for \&gt;60 d after HCT developed cGVHD characterized by cutaneous fibrosis, tissue damage in the salivary gland, and the presence of serum autoantibodies. Donor CD8+ T cells were more potent than CD4+ T cells for inducing cGVHD. The recipient thymus and de novo--generated, donor-derived CD4+ T cells were required for induction of cGVHD by donor CD8+ T cells but not by donor CD4+ T cells. Donor CD8+ T cells preferentially damaged recipient medullary thymic epithelial cells and impaired negative selection, resulting in production of autoreactive CD4+ T cells that perpetuated damage to the thymus and augmented the development of cGVHD. Short-term anti-CD4 mAb treatment early after HCT enabled recovery from thymic damage and prevented cGVHD. These results demonstrate that donor CD8+ T cells cause cGVHD solely through thymic-dependent mechanisms, whereas CD4+ T cells can cause cGVHD through either thymic-dependent or independent mechanisms.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

