  issn = {0006-4971, 1528-0020},
  doi = {10.1182/blood-2009-06-204669},
  urldate = {2026-07-13},
  abstract = {Abstract             During the past decade, progress in basic immunology has been impressive. In parallel, whereas our understanding of the pathophysiology of acute graft-versus-host disease (GVHD) has greatly improved, so has our knowledge of the complexities of the immune system. Much of the immunobiology of acute GVHD has been gleaned from preclinical models and far less from correlations with clinical observations or therapeutic interventions. In this review, we summarize some of the major advances in GVHD pathophysiology, including the translation of these from the bench to the bedside, and discuss preclinical approaches that warrant further exploration in the clinic.},
