@article{Lee_2014a,
  title = {Aldehyde Dehydrogenase--Bright Cells Correlated with the Colony-forming Unit--Granulocyte-macrophage Assay of Thawed Cord Blood Units},
  author = {Lee, Hye Ryun and Shin, Sue and Yoon, Jong Hyun and Roh, Eun Youn and Kim, Byoung Jae and Song, Eun Young},
