@article{Lakkaraja_2022,
  title = {Antithymocyte Globulin Exposure in {{CD34}}+ {{T-cell}}--Depleted Allogeneic Hematopoietic Cell Transplantation},
  author = {Lakkaraja, Madhavi and Scordo, Michael and Mauguen, Audrey and Cho, Christina and Devlin, Sean and Ruiz, Josel D. and Klein, Elizabeth and Avecilla, Scott T. and Boulad, Farid and Cancio, Maria I. and Curran, Kevin J. and Jakubowski, Ann A. and Kernan, Nancy A. and Kung, Andrew L. and O'Reilly, Richard J. and Papadopoulos, Esperanza B. and Prockop, Susan and Van Roessel, Ichelle and Scaradavou, Andromachi and Shaffer, Brian C. and Shah, Gunjan and Spitzer, Barbara and Tamari, Roni and Giralt, Sergio A. and Perales, Miguel-Angel and Boelens, Jaap Jan},
  year = 2022,
  month = feb,
  journal = {Blood Advances},
  volume = {6},
  number = {3},
  pages = {1054--1063},
  issn = {2473-9529, 2473-9537},
  doi = {10.1182/bloodadvances.2021005584},
  urldate = {2026-07-13},
  abstract = {Abstract             Traditional weight-based dosing results in variable rabbit antithymocyte globulin (rATG) clearance that can delay CD4+ T-cell immune reconstitution (CD4+ IR) leading to higher mortality. In a retrospective pharmacokinetic/pharmacodynamic (PK/PD) analysis of patients undergoing their first CD34+ T-cell--depleted (TCD) allogeneic hematopoietic cell transplantation (HCT) after myeloablative conditioning with rATG, we estimated post-HCT rATG exposure as area under the curve (arbitrary unit per day/milliliter [AU \texttimes{} day/mL]) using a validated population PK model. We related rATG exposure to nonrelapse mortality (NRM), CD4+ IR (CD4+ {$\geq$}50 cells per \textmu L at 2 consecutive measures within 100 days after HCT), overall survival, relapse, and acute graft-versus-host disease (aGVHD) to define an optimal rATG exposure. We used Cox proportional hazard models and multistate competing risk models for analysis. In all, 554 patients were included (age range, 0.1-73 years). Median post-HCT rATG exposure was 47 AU \texttimes{} day/mL (range, 0-101 AU \texttimes{} day/mL). Low post-HCT area under the curve (\&lt;30 AU \texttimes{} day/mL) was associated with lower risk of NRM (P \&lt; .01) and higher probability of achieving CD4+ IR (P \&lt; .001). Patients who attained CD4+ IR had a sevenfold lower 5-year NRM (P \&lt; .0001). The probability of achieving CD4+ IR was 2.5-fold higher in the \&lt;30 AU \texttimes{} day/mL group compared with 30-55 AU \texttimes{} day/mL and threefold higher in the \&lt;30 AU \texttimes{} day/mL group compared with the {$\geq$}55 AU \texttimes{} day/mL group. In multivariable analyses, post-HCT rATG exposure {$\geq$}55 AU \texttimes{} day/mL was associated with an increased risk of NRM (hazard ratio, 3.42; 95\% confidence interval, 1.26-9.30). In the malignancy subgroup (n = 515), a tenfold increased NRM was observed in the {$\geq$}55 AU \texttimes{} day/mL group, and a sevenfold increased NRM was observed in the 30-55 AU \texttimes{} day/mL group compared with the \&lt;30 AU \texttimes{} day/mL group. Post-HCT rATG exposure {$\geq$}55 AU \texttimes{} day/mL was associated with higher risk of a GVHD (hazard ratio, 2.28; 95\% confidence interval, 1.01-5.16). High post-HCT rATG exposure is associated with higher NRM secondary to poor CD4+ IR after TCD HCT. Using personalized PK-directed rATG dosing to achieve optimal exposure may improve survival after HCT.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/6PHQS9B5/Lakkaraja et al. - 2022 - Antithymocyte globulin exposure in CD34+ T-cell–depleted allogeneic hematopoietic cell transplantati.pdf}
}

@article{Lakshmanan_2023,
  title = {The {{Promise}} of {{Precision Nutrition}} for {{Modulation}} of the {{Gut Microbiota}} as a {{Novel Therapeutic Approach}} to {{Acute Graft-versus-host Disease}}},
  author = {Lakshmanan, Arun Prasath and Deola, Sara and Terranegra, Annalisa},
  year = 2023,
  month = dec,
  journal = {Transplantation},
  volume = {107},
  number = {12},
  pages = {2497--2509},
  issn = {0041-1337},
  doi = {10.1097/TP.0000000000004629},
  urldate = {2026-07-13},
  abstract = {Acute graft-versus-host disease (aGVHD) is a severe side effect of allogeneic hematopoietic stem cell transplantation (aHSCT) that has complex phenotypes and often unpredictable outcomes. The current management is not always able to prevent aGVHD. A neglected actor in the management of aGVHD is the gut microbiota. Gut microbiota dysbiosis after aHSCT is caused by many factors and may contribute to the development of aGVHD. Diet and nutritional status modify the gut microbiota and a wide range of products are now available to manipulate the gut microbiota (pro-, pre-, and postbiotics). New investigations are testing the effect of probiotics and nutritional supplements in both animal models and human studies, with encouraging results. In this review, we summarize the most recent literature about the probiotics and nutritional factors able to modulate the gut microbiota and we discuss the future perspective in developing new integrative therapeutic approaches to reducing the risk of graft-versus-host disease in patients undergoing aHSCT.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

