@article{Saad_2020,
  title = {Hematopoietic {{Cell Transplantation}}, {{Version}} 2.2020, {{NCCN Clinical Practice Guidelines}} in {{Oncology}}},
  author = {Saad, Ayman and De Lima, Marcos and Anand, Sarah and Bhatt, Vijaya Raj and Bookout, Ryan and Chen, George and Couriel, Daniel and Di Stasi, Antonio and {El-Jawahri}, Areej and Giralt, Sergio and Gutman, Jonathan and Ho, Vincent and Horwitz, Mitchell and Hsu, Joe and Juckett, Mark and Dabaja, Mohamed Kharfan and Loren, Alison W. and MSCE and Meade, Javier and Mielcarek, Marco and Moreira, Jonathan and Nakamura, Ryotaro and Nieto, Yago and Roddy, Julianna and Satyanarayana, Gowri and Schroeder, Mark and Tan, Carlyn Rose and Tzachanis, Dimitrios and Burns, Jennifer L. and Pluchino, Lenora A.},
  year = 2020,
  month = may,
  journal = {Journal of the National Comprehensive Cancer Network},
  volume = {18},
  number = {5},
  pages = {599--634},
  issn = {1540-1405, 1540-1413},
  doi = {10.6004/jnccn.2020.0021},
  urldate = {2026-07-13},
  abstract = {Hematopoietic cell transplantation (HCT) involves the infusion of hematopoietic progenitor cells into patients with hematologic disorders with the goal of re-establishing normal hematopoietic and immune function. HCT is classified as autologous or allogeneic based on the origin of hematopoietic cells. Autologous HCT uses the patient's own cells while allogeneic HCT uses hematopoietic cells from a human leukocyte antigen-compatible donor. Allogeneic HCT is a potentially curative treatment option for patients with certain types of hematologic malignancies, and autologous HCT is primarily used to support patients undergoing high-dose chemotherapy. Advances in HCT methods and supportive care in recent decades have led to improved survival after HCT; however, disease relapse and posttransplant complications still commonly occur in both autologous and allogeneic HCT recipients. Allogeneic HCT recipients may also develop acute and/or chronic graft-versus-host disease (GVHD), which results in immune-mediated cellular injury of several organs. The NCCN Guidelines for Hematopoietic Cell Transplantation focus on recommendations for pretransplant recipient evaluation and the management of GVHD in adult patients with malignant disease.},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/H8I22NM3/Saad et al. - 2020 - Hematopoietic Cell Transplantation, Version 2.2020, NCCN Clinical Practice Guidelines in Oncology.pdf}
}

@article{Saada_2006,
  title = {Subepithelial {{Myofibroblasts}} Are {{Novel Nonprofessional APCs}} in the {{Human Colonic Mucosa}}},
  author = {Saada, Jamal I and Pinchuk, Irina V and Barrera, Carlos A and Adegboyega, Patrick A and Suarez, Giovanni and Mifflin, Randy C and Di Mari, John F and Reyes, Victor E and Powell, Don W},
  year = 2006,
  month = nov,
  journal = {The Journal of Immunology},
  volume = {177},
  number = {9},
  pages = {5968--5979},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.177.9.5968},
  urldate = {2026-07-13},
  abstract = {Abstract             The human gastrointestinal mucosa is exposed to a diverse normal microflora and dietary Ags and is a common site of entry for pathogens. The mucosal immune system must respond to these diverse signals with either the initiation of immunity or tolerance. APCs are important accessory cells that modulate T cell responses which initiate and maintain adaptive immunity. The ability of APCs to communicate with CD4+ T cells is largely dependent on the expression of class II MHC molecules by the APCs. Using immunohistochemistry, confocal microscopy, and flow cytometry, we demonstrate that {$\alpha$}-smooth muscle actin+, CD90+ subepithelial myofibroblasts (stromal cells) constitutively express class II MHC molecules in normal colonic mucosa and that they are distinct from professional APCs such as macrophages and dendritic cells. Primary isolates of human colonic myofibroblasts (CMFs) cultured in vitro were able to stimulate allogeneic CD4+ T cell proliferation. This process was dependent on class II MHC and CD80/86 costimulatory molecule expression by the myofibroblasts. We also demonstrate that CMFs, engineered to express a specific DR4 allele, can process and present human serum albumin to a human serum albumin-specific and DR4 allele-restricted T cell hybridoma. These studies characterize a novel cell phenotype which, due to its strategic location and class II MHC expression, may be involved in capture of Ags that cross the epithelial barrier and present them to lamina propria CD4+ T cells. Thus, human CMFs may be important in regulating local immunity in the colon.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/8BB8RFNH/Saada et al. - 2006 - Subepithelial Myofibroblasts are Novel Nonprofessional APCs in the Human Colonic Mucosa.pdf}
}

