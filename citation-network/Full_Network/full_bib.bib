@article{Masenga_2022,
  title = {Recent Advances in Modulation of Cardiovascular Diseases by the Gut Microbiota},
  author = {Masenga, Sepiso K. and Hamooya, Benson and Hangoma, Joy and Hayumbu, Valerie and Ertuglu, Lale A. and Ishimwe, Jeanne and Rahman, Sharla and Saleem, Mohammad and Laffer, Cheryl L. and Elijovich, Fernando and Kirabo, Annet},
