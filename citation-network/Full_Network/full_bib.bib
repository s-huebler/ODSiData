@article{Sonnenberg_2016,
  title = {Group 3 Innate Lymphoid Cells Mediate Intestinal Selection of Commensal Bacteria-Specific {{CD4}}+ {{T}} Cells.},
  author = {Sonnenberg, Gregory F and Fung, Thomas C and Goc, Jeremy and Wang, Xinxin and Hepworth, Matthew R},
  year = 2016,
  month = may,
  journal = {The Journal of Immunology},
  volume = {196},
  number = {1\_Supplement},
  pages = {67.2-67.2},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.196.Supp.67.2},
  urldate = {2026-07-13},
  abstract = {Abstract             Inflammatory CD4+ T cell responses to self or commensal bacteria underlie the pathogenesis of autoimmunity and inflammatory bowel disease (IBD), respectively. While selection of self-specific T cells in the thymus limits responses to mammalian tissue antigens, the mechanisms that control selection of commensal bacteria-specific T cells remain poorly understood. Here we demonstrate that group 3 innate lymphoid cell (ILC3)-intrinsic expression of major histocompatibility complex class II (MHCII) is regulated similarly to thymic epithelial cells, and that MHCII+ ILC3s directly induce cell death of activated commensal bacteria-specific T cells. Further, MHCII on colonic ILC3s was reduced in pediatric IBD patients. Collectively, these results define a selection pathway for commensal bacteria-specific CD4+ T cells in the intestine and suggest that this process is dysregulated in human IBD. On going studies are interrogating the role and regulation of MHCII+ ILC3s in the context of allergy, autoimmunity and tumorigenesis.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

