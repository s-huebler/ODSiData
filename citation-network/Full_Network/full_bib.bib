  shorttitle = {Optimisation of Empirical Antimicrobial Therapy in Patients with Haematological Malignancies and Febrile Neutropenia ({{How Long}} Study)},
  author = {{Aguilar-Guisado}, Manuela and Espigado, Ildefonso and {Mart{\'i}n-Pe{\~n}a}, Almudena and Gudiol, Carlota and {Royo-Cebrecos}, Cristina and Falantes, Jos{\'e} and {V{\'a}zquez-L{\'o}pez}, Lourdes and Montero, Mar{\'i}a Isabel and {Rosso-Fern{\'a}ndez}, Clara and De La Luz Martino, Mar{\'i}a and Parody, Roc{\'i}o and {Gonz{\'a}lez-Campos}, Jos{\'e} and {Garz{\'o}n-L{\'o}pez}, Sebasti{\'a}n and {Calder{\'o}n-Cabrera}, Cristina and Barba, Pere and Rodr{\'i}guez, Nancy and Rovira, Montserrat and {Montero-Mateos}, Enrique and Carratal{\'a}, Jordi and {P{\'e}rez-Sim{\'o}n}, Jos{\'e} Antonio and Cisneros, Jos{\'e} Miguel},
  year = 2017,
