  issn = {1386-6346, 1872-034X},
  doi = {10.1111/j.1872-034X.2007.00297.x},
  urldate = {2026-07-13},
  abstract = {Ursodeoxycholic acid (UDCA) is used in the treatment of cholestatic liver diseases, gallstone dissolution, and for patients with hepatitis C virus infection to ameliorate elevated alanine aminotransferase levels. The efficacy of UDCA treatment has been debated and the mechanisms of action in humans have still not defined. Suggested mechanisms include the improvement of bile acid transport and/or detoxification, cytoprotection, and anti-apoptotic effects. In this review, we summarize the proposed molecular mechanisms for the action of UDCA, especially in hepatocytes, and also discuss the putative future clinical usage of this unique drug.},
