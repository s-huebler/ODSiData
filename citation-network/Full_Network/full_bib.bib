  author = {Loren, Alison W. and Mielcarek, Marco and {Bola{\~n}os-Meade}, Javier and Brammer, Jonathan and Cowden, Meredith and Di Stasi, Antonio and {El-Jawahri}, Areej and Elmariah, Hany and Gundabolu, Krishna and Gutman, Jonathan and Ho, Vincent and Hoeg, Rasmus T. and Horwitz, Mitchell and Jamy, Omer and Kassim, Adetola and Dabaja, Mohamed Kharfan and Lee, Lauren and Logan, Aaron and Luszcak, Christina and Magenau, John M. and Martin, Thomas G. and Mittal, Varun and Moreira, Jonathan and Muffly, Lori and Nakamura, Ryotaro and Nawas, Mariam and Nieto, Yago and Ninos, Cameron and Oliai, Caspian and Papanicolaou, Genovefa and Pidala, Joseph and Randolph, Brion and Schroeder, Mark A. and Tessier, Jeffrey and Topal, Jeffrey and Tzachanis, Dimitrios and {Varshavsky-Yanovsky}, Asya Nina and Jones, Frankie and Stehman, Katie},
