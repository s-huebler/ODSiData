@article{Hauri-Hohl_2007,
  title = {Donor {{T-cell}} Alloreactivity against Host Thymic Epithelium Limits {{T-cell}} Development after Bone Marrow Transplantation},
  author = {{Hauri-Hohl}, Mathias M. and Keller, Marcel P. and Gill, Jason and Hafen, Katrin and Pachlatko, Esther and Boulay, Thomas and Peter, Annick and Holl{\"a}nder, Georg A. and Krenger, Werner},
  year = 2007,
  month = may,
  journal = {Blood},
  volume = {109},
  number = {9},
  pages = {4080--4088},
  issn = {0006-4971, 1528-0020},
  doi = {10.1182/blood-2006-07-034157},
  urldate = {2026-07-13},
  abstract = {Abstract             Acute graft-versus-host disease (aGVHD) impairs thymus-dependent T-cell regeneration in recipients of allogeneic bone marrow transplants through yet to be defined mechanisms. Here, we demonstrate in mice that MHC-mismatched donor T cells home into the thymus of unconditioned recipients. There, activated donor T cells secrete IFN-{$\gamma$}, which in turn stimulates the programmed cell death of thymic epithelial cells (TECs). Because TECs themselves are competent and sufficient to prime naive allospecific T cells and to elicit their effector function, the elimination of host-type professional antigen-presenting cells (APCs) does not prevent donor T-cell activation and TEC apoptosis, thus precluding normal thymopoiesis in transplant recipients. Hence, strategies that protect TECs may be necessary to improve immune reconstitution following allogeneic bone marrow transplantation.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/T4TF8MSX/Hauri-Hohl et al. - 2007 - Donor T-cell alloreactivity against host thymic epithelium limits T-cell development after bone marr.pdf}
}

@article{Haverkos_2017,
