@article{Teshima_2002a,
  title = {Flt3 Ligand Therapy for Recipients of Allogeneic Bone Marrow Transplants Expands Host {{CD8$\alpha$}}+ Dendritic Cells and Reduces Experimental Acute Graft-versus-Host Disease},
  author = {Teshima, Takanori and Reddy, Pavan and Lowler, Kathleen P. and KuKuruga, Mark A. and Liu, Chen and Cooke, Kenneth R. and Ferrara, James L. M.},
  year = 2002,
  month = mar,
  journal = {Blood},
  volume = {99},
  number = {5},
  pages = {1825--1832},
  issn = {1528-0020, 0006-4971},
  doi = {10.1182/blood.V99.5.1825},
  urldate = {2026-07-13},
  abstract = {Recent evidence suggests that dendritic cells (DCs) can regulate and amplify immune responses. Flt3 ligand (FL)--derived DC function was tested as a stimulator of allogeneic lymphocytes in vitro and in vivo. Treatment of mice with FL dramatically expanded DC number, but DCs isolated from FL-treated mice (FL DCs) were poor stimulators of allogeneic T-cell responses in vitro. Further activation of FL DCs did not restore their stimulatory ability, and FL DCs did not suppress the stimulation of the allogeneic T cells by normal DCs. FL treatment significantly increased the CD8{$\alpha$}+ DC subset, which appeared to be the reason for their poor stimulatory capacity. These observations were confirmed in vivo using a mouse model of acute graft-versus-host disease (GVHD) wherein host DCs play a critical role. FL treatment of recipients before allogeneic bone marrow transplantation dramatically suppressed donor T-cell responses to host antigens, thereby reducing GVHD mortality (P\,\&lt;\,.01). These data represent a novel strategy that alters host DCs and reduces acute GVHD.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/NZS6RFDW/Teshima et al. - 2002 - Flt3 ligand therapy for recipients of allogeneic bone marrow transplants expands host CD8α+ dendriti.pdf}
}

