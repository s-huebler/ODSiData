@article{Andersen_2020,
  title = {Pilot Study Investigating the Effect of Enteral and Parenteral Nutrition on the Gastrointestinal Microbiome Post-allogeneic Transplantation},
  author = {Andersen, Sarah and Staudacher, Heidi and Weber, Nicholas and Kennedy, Glen and Varelias, Antiopi and Banks, Merrilyn and Bauer, Judy},
  year = 2020,
  month = feb,
  journal = {British Journal of Haematology},
  volume = {188},
  number = {4},
  pages = {570--581},
  issn = {0007-1048, 1365-2141},
  doi = {10.1111/bjh.16218},
  urldate = {2026-07-13},
  abstract = {Summary                            Nutrition support is frequently required post-allogeneic haematopoietic progenitor cell transplantation (HPCT); however, the impact of mode of feeding on the gastrointestinal microbiome has not been explored. This study aimed to determine if there is a difference in the microbiome between patients receiving enteral nutrition (EN) and parenteral nutrition (PN) post-allogeneic HPCT. Twenty-three patients received either early EN or PN when required. Stool samples were collected at 30~days post-transplant and analysed with shotgun metagenomic sequencing. There was no difference in microbial diversity between patients who received predominantly EN (               n               ~=~13) vs. PN (               n               ~=~10) however patients who received predominantly EN had greater abundance of               Faecalibacterium               (               P               ~{$<~$}0{$\cdot$}001) and               ruminococcus E bromii               (               P               ~=~0{$\cdot$}026). Patients who had minimal oral intake for a longer duration during provision of nutrition support had a different overall microbial profile (               P               ~=~0{$\cdot$}044), lower microbial diversity (               P               ~=~0{$\cdot$}004) and lower abundance of               faecalibacterium prausnitzii\_C               (               P               ~=~0{$\cdot$}030) and               Blautia               (               P               ~=~0{$\cdot$}007) compared to patients with greater oral intake. Lower microbial diversity was found in patients who received additional beta lactam antibiotics (               P               ~=~0{$\cdot$}042) or had a longer length of hospital stay (               P               ~=~0{$\cdot$}019). Post-HPCT oral intake should be encouraged to maintain microbiota diversity and, if nutrition support is required, EN may promote a more optimal microbiota profile.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/JK87RHP9/Andersen et al. - 2020 - Pilot study investigating the effect of enteral and parenteral nutrition on the gastrointestinal mic.pdf}
}

