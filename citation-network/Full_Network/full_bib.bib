@article{Hippen_2012,
  title = {Blocking {{IL-21}} Signaling Ameliorates Xenogeneic {{GVHD}} Induced by Human Lymphocytes},
  author = {Hippen, Keli L. and Bucher, Christoph and Schirm, Dawn K. and Bearl, Amanda M. and Brender, Ty and Mink, Kathy A. and Waggie, Kimberly S. and Peffault De Latour, Regis and Janin, Anne and Curtsinger, Julie M. and Dillon, Stacey R. and Miller, Jeffrey S. and Socie, Gerard and Blazar, Bruce R.},
  year = 2012,
  month = jan,
  journal = {Blood},
  volume = {119},
  number = {2},
  pages = {619--628},
  issn = {0006-4971, 1528-0020},
  doi = {10.1182/blood-2011-07-368027},
  urldate = {2026-07-13},
  abstract = {Abstract             In rodent graft-versus-host disease (GVHD) models, anti--IL-21 neutralizing mAb treatment ameliorates lethality and is associated with decreases in Th1 cytokine production and gastrointestinal tract injury. GVHD prevention was dependent on the in vivo generation of donor-inducible regulatory T cells (Tregs). To determine whether the IL-21 pathway might be targeted for GVHD prevention, skin and colon samples obtained from patients with no GVHD or grade 2 to 4 GVHD were analyzed for IL-21 protein expression. By immunohistochemistry staining, IL-21 protein-producing cells were present in all gastrointestinal tract samples and 54\% of skin samples obtained from GVHD patients but not GVHD-free controls. In a human xenogeneic GVHD model, human IL-21--secreting cells were present in the colon of GVHD recipients and were associated with elevated serum IL-21 levels. A neutralizing anti--human IL-21 mAb given prophylactically significantly reduced GVHD-associated weight loss and mortality, resulting in a concomitant increase in Tregs and a decrease in T cells secreting IFN-{$\gamma$} or granzyme B. Based on these findings, anti--IL-21 mAb could be considered for GVHD prevention in the clinic.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/FDZ3ARH6/Hippen et al. - 2012 - Blocking IL-21 signaling ameliorates xenogeneic GVHD induced by human lymphocytes.pdf}
}

