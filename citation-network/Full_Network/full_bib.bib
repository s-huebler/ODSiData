@article{Liu_2024d,
  title = {Role of Short-chain Fatty Acids in Host Physiology},
  author = {Liu, Mingyue and Lu, Yubo and Xue, Guoyu and Han, Le and Jia, Hanbing and Wang, Zi and Zhang, Jia and Liu, Peng and Yang, Chaojuan and Zhou, Yingjie},
