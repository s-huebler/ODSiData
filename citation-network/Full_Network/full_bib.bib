@article{Hubbard_2015a,
  title = {Adaptation of the Human Aryl Hydrocarbon Receptor to Sense Microbiota-Derived Indoles},
  author = {Hubbard, Troy D. and Murray, Iain A. and Bisson, William H. and Lahoti, Tejas S. and Gowda, Krishne and Amin, Shantu G. and Patterson, Andrew D. and Perdew, Gary H.},
  year = 2015,
  month = aug,
  journal = {Scientific Reports},
  volume = {5},
  number = {1},
  pages = {12689},
  issn = {2045-2322},
  doi = {10.1038/srep12689},
  urldate = {2026-07-13},
  abstract = {Abstract                            Ligand activation of the aryl hydrocarbon (AHR) has profound effects upon the immunological status of the gastrointestinal tract, establishing and maintaining signaling networks, which facilitate host-microbe homeostasis at the mucosal interface. However, the identity of the ligand(s) responsible for such AHR-mediated activation within the gut remains to be firmly established. Here, we combine               in vitro               ligand binding, quantitative gene expression, protein-DNA interaction and ligand structure activity analyses together with in silico modeling of the AHR ligand binding domain to identify indole, a microbial tryptophan metabolite, as a human-AHR selective agonist. Human AHR, acting as a host indole receptor may exhibit a unique bimolecular (2:1) binding stoichiometry not observed with typical AHR ligands. Such bimolecular indole-mediated activation of the human AHR within the gastrointestinal tract may provide a foundation for inter-kingdom signaling between the enteric microflora and the immune system to promote commensalism within the gut.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/ADKGUKRK/Hubbard et al. - 2015 - Adaptation of the human aryl hydrocarbon receptor to sense microbiota-derived indoles.pdf}
}

