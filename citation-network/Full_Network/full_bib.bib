@article{Veltman_2010,
  title = {{{COX-2}} Inhibition Improves Immunotherapy and Is Associated with Decreased Numbers of Myeloid-Derived Suppressor Cells in Mesothelioma. {{Celecoxib}} Influences {{MDSC}} Function},
  author = {Veltman, Joris D and Lambers, Margaretha Eh and Van Nimwegen, Menno and Hendriks, Rudi W and Hoogsteden, Henk C and Aerts, Joachim Gjv and Hegmans, Joost Pjj},
  year = 2010,
  month = dec,
  journal = {BMC Cancer},
  volume = {10},
  number = {1},
  pages = {464},
  issn = {1471-2407},
  doi = {10.1186/1471-2407-10-464},
  urldate = {2026-07-13},
  abstract = {Abstract                            Background                                Myeloid-derived suppressor cells (MDSC) are a heterogeneous population of immature cells that accumulates in tumour-bearing hosts. These cells are induced by tumour-derived factors (e.g. prostaglandins) and have a critical role in immune suppression. MDSC suppress T and NK cell function via increased expression of arginase I and production of reactive oxygen species (ROS) and nitric oxide (NO). Immune suppression by MDSC was found to be one of the main factors for immunotherapy insufficiency. Here we investigate if the                 in vivo                 immunoregulatory function of MDSC can be reversed by inhibiting prostaglandin synthesis by specific COX-2 inhibition focussing on ROS production by MDSC subtypes. In addition, we determined if dietary celecoxib treatment leads to refinement of immunotherapeutic strategies.                                                        Methods               MDSC numbers and function were analysed during tumour progression in a murine model for mesothelioma. Mice were inoculated with mesothelioma tumour cells and treated with cyclooxygenase-2 (COX-2) inhibitor celecoxib, either as single agent or in combination with dendritic cell-based immunotherapy.                                         Results                                We found that large numbers of infiltrating MDSC co-localise with COX-2 expression in those areas where tumour growth takes place. Celecoxib reduced prostaglandin E2 levels                 in vitro                 and                 in vivo                 . Treatment of tumour-bearing mice with dietary celecoxib prevented the local and systemic expansion of all MDSC subtypes. The function of MDSC was impaired as was noticed by reduced levels of ROS and NO and reversal of T cell tolerance; resulting in refinement of immunotherapy.                                                        Conclusions               We conclude that celecoxib is a powerful tool to improve dendritic cell-based immunotherapy and is associated with a reduction in the numbers and suppressive function of MDSC. These data suggest that immunotherapy approaches benefit from simultaneously blocking cyclooxygenase-2 activity.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/HKT3TSBZ/Veltman et al. - 2010 - COX-2 inhibition improves immunotherapy and is associated with decreased numbers of myeloid-derived.pdf}
}

