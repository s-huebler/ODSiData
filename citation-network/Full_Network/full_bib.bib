@article{Zelepukin_2024,
  title = {Rediscovery of Mononuclear Phagocyte System Blockade for Nanoparticle Drug Delivery},
  author = {Zelepukin, Ivan V. and Shevchenko, Konstantin G. and Deyev, Sergey M.},
  year = 2024,
