@article{Mathe_1965,
  title = {Successful {{Allogenic Bone Marrow Transplantation}} in {{Man}}: {{Chimerism}}, {{Induced Specific Tolerance}} and {{Possible Anti-Leukemic Effects}}},
  shorttitle = {Successful {{Allogenic Bone Marrow Transplantation}} in {{Man}}},
  author = {Math{\'e}, G. and Amiel, J. L. and Schwarzenberg, L. and Cattan, A. and Schneider, M. and De Vries, M. J. and Tubiana, M. and Lalanne, C. and Binet, J. L. and Papiernik, M. and Seman, G. and Matsukura, M. and Mery, A. M. and Schwarzmann, V. and Flaisler, A.},
  year = 1965,
