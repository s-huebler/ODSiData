@article{Arai_2016,
  title = {A {{Randomized Phase II Crossover Study}} of {{Imatinib}} or {{Rituximab}} for {{Cutaneous Sclerosis}} after {{Hematopoietic Cell Transplantation}}},
  author = {Arai, Sally and Pidala, Joseph and Pusic, Iskra and Chai, Xiaoyu and Jaglowski, Samantha and Khera, Nandita and Palmer, Jeanne and Chen, George L. and Jagasia, Madan H. and Mayer, Sebastian A. and Wood, William A. and Green, Michael and Hyun, Teresa S. and Inamoto, Yoshihiro and Storer, Barry E. and Miklos, David B. and Shulman, Howard M. and Martin, Paul J. and Sarantopoulos, Stefanie and Lee, Stephanie J. and Flowers, Mary E.D.},
  year = 2016,
  month = jan,
  journal = {Clinical Cancer Research},
  volume = {22},
  number = {2},
  pages = {319--327},
  issn = {1078-0432, 1557-3265},
  doi = {10.1158/1078-0432.CCR-15-1443},
  urldate = {2026-07-13},
  abstract = {Abstract             Purpose: Cutaneous sclerosis occurs in 20\% of patients with chronic graft-versus-host disease (GVHD) and can compromise mobility and quality of life.             Experimental design: We conducted a prospective, multicenter, randomized, two-arm phase II crossover trial of imatinib (200 mg daily) or rituximab (375 mg/m2 i.v. weekly \texttimes{} 4 doses, repeatable after 3 months) for treatment of cutaneous sclerosis diagnosed within 18 months (NCT01309997). The primary endpoint was significant clinical response (SCR) at 6 months, defined as quantitative improvement in skin sclerosis or joint range of motion. Treatment success was defined as SCR at 6 months without crossover, recurrent malignancy or death. Secondary endpoints included changes of B-cell profiles in blood (BAFF levels and cellular subsets), patient-reported outcomes, and histopathology between responders and nonresponders with each therapy.             Results: SCR was observed in 9 of 35 [26\%; 95\% confidence interval (CI); 13\%--43\%] participants randomized to imatinib and 10 of 37 (27\%; 95\% CI, 14\%--44\%) randomized to rituximab. Six (17\%; 95\% CI, 7\%--34\%) patients in the imatinib arm and 5 (14\%; 95\% CI, 5\%--29\%) in the rituximab arm had treatment success. Higher percentages of activated B cells (CD27+) were seen at enrollment in rituximab-treated patients who had treatment success (P = 0.01), but not in imatinib-treated patients.             Conclusions: These results support the need for more effective therapies for cutaneous sclerosis and suggest that activated B cells define a subgroup of patients with cutaneous sclerosis who are more likely to respond to rituximab. Clin Cancer Res; 22(2); 319--27. \copyright 2015 AACR.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

