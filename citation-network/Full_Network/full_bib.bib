@article{Rabinovich_2003,
  title = {Activated, {{But Not Resting}}, {{T Cells Can Be Recognized}} and {{Killed}} by {{Syngeneic NK Cells}}},
  author = {Rabinovich, Brian A and Li, Jennifer and Shannon, John and Hurren, Rose and Chalupny, Jan and Cosman, David and Miller, Richard G},
  year = 2003,
  month = apr,
  journal = {The Journal of Immunology},
  volume = {170},
  number = {7},
  pages = {3572--3576},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.170.7.3572},
  urldate = {2026-07-13},
  abstract = {Abstract             We demonstrate that IL-2-activated NK cells or lymphokine-activated killer cells recognize and kill syngeneic CD4+ and CD8+ T cells that have been activated by APCs. Induction with APC required TCR-specific Ag, and lysis was perforin mediated. Brefeldin A, which disrupts protein transport, inhibited the sensitivity induced by activation. In BALB/c, expression of NKG2D ligands correlated with lysis and could be inhibited by brefeldin A. As well, addition of anti-NKG2D mAb to a killing assay completely abrogated lysis. Transduction of mouse NKG2D into a human NK cell line, YTSeco, conferred upon it the ability to kill activated BALB/c T cells, indicating that NKG2D is necessary for recognition. Our data provide a basis for studying a role for NK cells in T cell regulation.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/MJZFSPBV/Rabinovich et al. - 2003 - Activated, But Not Resting, T Cells Can Be Recognized and Killed by Syngeneic NK Cells.pdf}
}

