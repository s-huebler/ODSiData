@article{Metafuni_2023,
  title = {The {{Role}} of {{Fecal Microbiota Transplantation}} in the {{Allogeneic Stem Cell Transplant Setting}}},
  author = {Metafuni, Elisabetta and Di Marino, Luca and Giammarco, Sabrina and Bellesi, Silvia and Limongiello, Maria Assunta and Sor{\`a}, Federica and Frioni, Filippo and Maggi, Roberto and Chiusolo, Patrizia and Sica, Simona},
  year = 2023,
