@article{Tesio_2011,
  title = {Enhanced C-{{Met}} Activity Promotes {{G-CSF}}--Induced Mobilization of Hematopoietic Progenitor Cells via {{ROS}} Signaling},
  author = {Tesio, Melania and Golan, Karin and Corso, Simona and Giordano, Silvia and Schajnovitz, Amir and Vagima, Yaron and Shivtiel, Shoham and Kalinkovich, Alexander and Caione, Luisa and Gammaitoni, Loretta and Laurenti, Elisa and Buss, Eike C. and Shezen, Elias and Itkin, Tomer and Kollet, Orit and Petit, Isabelle and Trumpp, Andreas and Christensen, James and Aglietta, Massimo and Piacibello, Wanda and Lapidot, Tsvee},
  year = 2011,
  month = jan,
  journal = {Blood},
  volume = {117},
  number = {2},
  pages = {419--428},
  issn = {0006-4971, 1528-0020},
  doi = {10.1182/blood-2009-06-230359},
  urldate = {2026-07-13},
  abstract = {Abstract             Mechanisms governing stress-induced hematopoietic progenitor cell mobilization are not fully deciphered. We report that during granulocyte colony-stimulating factor--induced mobilization c-Met expression and signaling are up-regulated on immature bone marrow progenitors. Interestingly, stromal cell--derived factor 1/CXC chemokine receptor-4 signaling induced hepatocyte growth factor production and c-Met activation. We found that c-Met inhibition reduced mobilization of both immature progenitors and the more primitive Sca-1+/c-Kit+/Lin- cells and interfered with their enhanced chemotactic migration to stromal cell--derived factor 1. c-Met activation resulted in cellular accumulation of reactive oxygen species by mammalian target of rapamycin inhibition of Forkhead Box, subclass O3a. Blockage of mammalian target of rapamycin inhibition or reactive oxygen species signaling impaired c-Met--mediated mobilization. Our data show dynamic c-Met expression and function in the bone marrow and show that enhanced c-Met signaling is crucial to facilitate stress-induced mobilization of progenitor cells as part of host defense and repair mechanisms.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/MRZWTWAV/Tesio et al. - 2011 - Enhanced c-Met activity promotes G-CSF–induced mobilization of hematopoietic progenitor cells via RO.pdf}
}

