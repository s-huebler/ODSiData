@article{Rashidi_2018a,
  title = {Recipient Single Nucleotide Polymorphisms in {{Paneth}} Cell Antimicrobial Peptide Genes and Acute Graft-versus-host Disease: Analysis of {{BMT CTN}}-0201 and -0901 Samples},
  shorttitle = {Recipient Single Nucleotide Polymorphisms in {{Paneth}} Cell Antimicrobial Peptide Genes and Acute Graft-versus-host Disease},
  author = {Rashidi, Armin and Shanley, Ryan and Yohe, Sophia L. and Thyagarajan, Bharat and Curtsinger, Julie and Anasetti, Claudio and Waller, Edmund K. and Scott, Bart L. and Blazar, Bruce R. and Weisdorf, Daniel J.},
  year = 2018,
  month = sep,
  journal = {British Journal of Haematology},
  volume = {182},
  number = {6},
  pages = {887--894},
  issn = {0007-1048, 1365-2141},
  doi = {10.1111/bjh.15492},
  urldate = {2026-07-13},
  abstract = {Summary                            Host genetics shape the gut microbiota, and gut dysbiosis increases the risk of acute graft-versus-host disease (aGVHD). Paneth cells and microbiota have interactions that contribute to immune regulation. {$\alpha$}-defensin-5 (HD5) and regenerating islet-derived protein 3 alpha (Reg3A) are the most abundant Paneth cell antimicrobial peptides (AMPs). We hypothesized that single nucleotide polymorphisms (SNPs) in the genes for HD5 (               DEFA5               ) and Reg3A (               REG3A               ) predict aGVHD risk. We analysed pre-transplant recipient peripheral blood mononuclear cell samples from randomized Blood and Marrow Transplant Clinical Trials Network (BMT CTN) studies 0201 (94 patients with bone marrow and 93 with peripheral blood grafts) and 0901 (86 patients with myeloablative and 77 with reduced-intensity conditioning; all using peripheral blood grafts). In multivariable analysis (with a SNP~\texttimes ~graft source interaction term in CTN-0201 and a SNP~\texttimes ~conditioning intensity term in CTN-0901),               DEFA5               rs4415345 and rs4610776 were associated with altered incidence of aGVHD grade II--IV [rs4415345 G vs. C: hazard ratio (HR) 0{$\cdot$}58, 95\% confidence interval (95\% CI) 0{$\cdot$}37--0{$\cdot$}92,               P               ~=~0{$\cdot$}02; rs4610776 T vs. A: HR 1{$\cdot$}53, 95\% CI 1{$\cdot$}01--2{$\cdot$}32,               P               ~=~0{$\cdot$}05] in CTN-0201, but not CTN-0901, suggesting a stronger effect in bone marrow allografts.               REG3A               SNP was not associated with aGVHD. Host genetics may influence aGVHD risk by modulating Paneth cell function.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/YMXYUDNH/Rashidi et al. - 2018 - Recipient single nucleotide polymorphisms in Paneth cell antimicrobial peptide genes and acute graft.pdf}
}

@article{Rashidi_2019,
  title = {Dysbiosis Patterns during Re-Induction/Salvage versus Induction Chemotherapy for Acute Leukemia},
  author = {Rashidi, Armin and Kaiser, Thomas and {Shields-Cutler}, Robin and Graiziger, Carolyn and Holtan, Shernan G. and Rehman, Tauseef Ur and Wasko, Justin and Weisdorf, Daniel J. and Dunny, Gary and Khoruts, Alexander and Staley, Christopher},
  year = 2019,
  month = apr,
  journal = {Scientific Reports},
  volume = {9},
  number = {1},
  pages = {6083},
  issn = {2045-2322},
  doi = {10.1038/s41598-019-42652-6},
  urldate = {2026-07-13},
  abstract = {Abstract                            Acute leukemia (AL) patients undergoing intensive induction chemotherapy develop severe gut dysbiosis, placing them at heightened risk for infectious complications. Some AL patients will undergo ``repeat therapy'' (re-induction or salvage) due to persistent or relapsed disease. We hypothesized that prior injury to the microbiome during induction may influence dysbiosis patterns during repeat therapy. To test this hypothesis, we analyzed the bacterial microbiome profiles of thrice-weekly stool samples from 20 intensively treated AL patients (first induction: 13, repeat therapy: 7) by 16S rRNA sequencing. In mixed-effects modeling, repeat therapy was a significant predictor of               Enterococcus               expansion (               P               \,=\,0.006), independently of antibiotic exposure, disease type, feeding mode, and week of chemotherapy. Bayesian analysis of longitudinal data demonstrated larger departures of microbial communities from the pre-chemotherapy baseline during repeat therapy compared to induction. This increased ecosystem instability during repeat therapy possibly impairs colonization resistance and increases vulnerability to               Enterococcus               outgrowth. Microbiota restoration therapies at the end of induction or before starting subsequent therapy warrant investigation.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/KGLDBGBA/Rashidi et al. - 2019 - Dysbiosis patterns during re-inductionsalvage versus induction chemotherapy for acute leukemia.pdf}
}

