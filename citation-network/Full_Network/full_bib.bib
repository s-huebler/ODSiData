@article{Cao_2018,
  title = {Impairment of Bone Marrow Endothelial Progenitor Cells in Acute Graft-versus-host Disease Patients after Allotransplant},
  author = {Cao, Xie-Na and Kong, Yuan and Song, Yang and Shi, Min-Min and Zhao, Hong-Yan and Wen, Qi and Lyu, Zhong-Shi and Duan, Cai-Wen and Wang, Yu and Xu, Lan-Ping and Zhang, Xiao-Hui and Huang, Xiao-Jun},
  year = 2018,
  month = sep,
  journal = {British Journal of Haematology},
  volume = {182},
  number = {6},
  pages = {870--886},
  issn = {0007-1048, 1365-2141},
  doi = {10.1111/bjh.15456},
  urldate = {2026-07-13},
  abstract = {Summary                            Graft-versus-host disease (               GVHD               ) is a major complication after allogeneic haematopoietic stem cell transplantation (allo-               HSCT               ) that is frequently associated with bone marrow (               BM               ) suppression, and clinical management is challenging.               BM               endothelial progenitor cells (               EPC               s) play crucial roles in the regulation of haematopoiesis and thrombopoiesis. However, little is known regarding the functional roles of               BM EPC               s in acute               GVHD               (               aGVHD               ) patients. In the current prospective case-control study, reduced and dysfunctional               BM EPC               s, characterized by decreased migration and angiogenesis capacities and increased levels of reactive oxygen species (               ROS               ) and apoptosis, were found in               aGVHD               patients compared with those without               aGVHD               . Moreover, lower frequency and increased levels of               ROS               , apoptosis and               DNA               damage, but reduced colony-forming unit-plating efficiency were found in               BM CD               34               +               cells of               aGVHD               patients compared with those without               aGVHD               . The severity of               aGVHD               and               GVHD               -mediated cytopenia was associated with               BM EPC               impairment in               aGVHD               patients. In addition, the               EPC               impairment positively correlated with               ROS               level. Taken together, our results suggest that reduced and dysfunctional               BM EPC               s may be involved in the pathogenesis of               aGVHD               . Although these findings require validation, our data indicate that improvement of               BM EPC               s may represent a promising therapeutic approach for               aGVHD               patients.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/3IW528MV/Cao et al. - 2018 - Impairment of bone marrow endothelial progenitor cells in acute graft‐versus‐host disease patients a.pdf}
}

