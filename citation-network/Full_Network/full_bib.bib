@article{Koutsokostas_2024,
  title = {Gut {{Microbes Associated}} with {{Neurodegenerative Disorders}}: {{A Comprehensive Review}} of the {{Literature}}},
  shorttitle = {Gut {{Microbes Associated}} with {{Neurodegenerative Disorders}}},
  author = {Koutsokostas, Christos and Merkouris, Ermis and Goulas, Apostolos and Aidinopoulou, Konstantina and Sini, Niki and Dimaras, Theofanis and Tsiptsios, Dimitrios and Mueller, Christoph and Nystazaki, Maria and Tsamakis, Konstantinos},
  year = 2024,
  month = aug,
  journal = {Microorganisms},
  volume = {12},
  number = {8},
  pages = {1735},
  issn = {2076-2607},
  doi = {10.3390/microorganisms12081735},
  urldate = {2026-07-13},
  abstract = {Evidence shows that neurodegenerative and neuropsychiatric disorders are influenced by alterations in the gut microbiome. Various diseases have been linked to microbiome dysbiosis, yet there are inconclusive data regarding which microorganisms are associated with each disorder. The aim of our study is to systematically review the recent literature of the past decade to clarify whether the gut microbiome contributes to the understanding of pathogenesis and progression of neurodegenerative disorders. Most included studies showed a strong correlation between the relative abundance of certain microorganisms, mainly species of the phyla Firmicutes and Bacteroidetes, and disorders such as Parkinson's disease (PD) and Alzheimer's disease (AD). It is speculated that the microorganisms and their byproducts have a significant role in brain protein accumulation, neuro-inflammation, and gut permeability. The estimation of microbial populations could potentially improve clinical outcomes and hinder the progression of the disease. However, further research is needed to include more diseases and larger patient samples and identify specific species and subspecies associated with these disorders.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

