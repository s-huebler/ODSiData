@article{MendelianRandomizationofDairyConsumptionWorkingGroup_2018,
  title = {Dairy {{Consumption}} and {{Body Mass Index Among Adults}}: {{Mendelian Randomization Analysis}} of 184802 {{Individuals}} from 25 {{Studies}}},
  shorttitle = {Dairy {{Consumption}} and {{Body Mass Index Among Adults}}},
  author = {{Mendelian Randomization of Dairy Consumption Working Group} and Huang, Tao and Ding, Ming and Bergholdt Helle, K M and Wang, Tiange and Heianza, Yoriko and Sun, Dianjianyi and {Frazier-Wood Alexis}, C and Aslibekyan, Stella and North Kari, E and Voortman, Trudy and Graff, Mariaelisa and Smith Caren, E and Lai, Chao-Qiang and Varbo, Anette and Lemaitre, Rozenn N and De Jonge, M Ester A L and Fumeron, Fr{\'e}d{\'e}ric and Corella, Dolores and Wang, Carol A and Tj{\o}nneland, Anne and Overvad, Kim and S{\o}rensen, Thorkild I A and Feitosa, Mary F and Wojczynski, Mary K and K{\"a}h{\"o}nen, Mika and Renstr{\"o}m, Frida and Psaty, Bruce M and Siscovick, David S and Barroso, In{\^e}s and Johansson, Ingegerd and Hernandez, Dena and Ferrucci, Luigi and Bandinelli, Stefania and Linneberg, Allan and Zillikens, M Carola and Sandholt, Camilla Helene and Pedersen, Oluf and Hansen, Torben and Schulz, Christina-Alexandra and Sonestedt, Emily and {Orho-Melander}, Marju and Chen, Tzu-An and Rotter, Jerome I and Allison, Mathew A and Rich, Stephen S and Sorl{\'i}, Jose V and Coltell, Oscar and Pennell, Craig E and Eastwood, Peter and Hofman, Albert and Uitterlinden, Andre G and Van Rooij, Frank J A and Chu, Audrey Y and Rose, Lynda M and Ridker, Paul M and Viikari, Jorma and Raitakari, Olli and Lehtim{\"a}ki, Terho and Mikkil{\"a}, Vera and Willett, Walter C and Wang, Yujie and Tucker, Katherine L and Ordovas, Jose M and Kilpel{\"a}inen, Tuomas O and Province, Michael A and Franks, Paul W and Arnett, Donna K and Tanaka, Toshiko and Toft, Ulla and Ericson, Ulrika and Franco, Oscar H and Mozaffarian, Dariush and Hu, Frank B and Chasman, Daniel I and Nordestgaard, B{\o}rge G and Ellervik, Christina and Qi, Lu},
  year = 2018,
  month = jan,
  journal = {Clinical Chemistry},
  volume = {64},
  number = {1},
  pages = {183--191},
  issn = {0009-9147, 1530-8561},
  doi = {10.1373/clinchem.2017.280701},
  urldate = {2026-07-13},
  abstract = {Abstract                            BACKGROUND               Associations between dairy intake and body mass index (BMI) have been inconsistently observed in epidemiological studies, and the causal relationship remains ill defined.                                         METHODS               We performed Mendelian randomization (MR) analysis using an established dairy intake-associated genetic polymorphism located upstream of the lactase gene (LCT-13910 C/T, rs4988235) as an instrumental variable (IV). Linear regression models were fitted to analyze associations between (a) dairy intake and BMI, (b) rs4988235 and dairy intake, and (c) rs4988235 and BMI in each study. The causal effect of dairy intake on BMI was quantified by IV estimators among 184802 participants from 25 studies.                                         RESULTS               Higher dairy intake was associated with higher BMI ({$\beta$} = 0.03 kg/m2 per serving/day; 95\% CI, 0.00--0.06; P = 0.04), whereas the LCT genotype with 1 or 2 T allele was significantly associated with 0.20 (95\% CI, 0.14--0.25) serving/day higher dairy intake (P = 3.15 \texttimes{} 10-12) and 0.12 (95\% CI, 0.06--0.17) kg/m2 higher BMI (P = 2.11 \texttimes{} 10-5). MR analysis showed that the genetically determined higher dairy intake was significantly associated with higher BMI ({$\beta$} = 0.60 kg/m2 per serving/day; 95\% CI, 0.27--0.92; P = 3.0 \texttimes{} 10-4).                                         CONCLUSIONS               The present study provides strong evidence to support a causal effect of higher dairy intake on increased BMI among adults.},
  copyright = {https://academic.oup.com/journals/pages/open\_access/funder\_policies/chorus/standard\_publication\_model},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/UWYNR649/Mendelian Randomization of Dairy Consumption Working Group et al. - 2018 - Dairy Consumption and Body Mass Index Among Adults Mendelian Randomization Analysis of 184802 Indiv.pdf}
}

@article{Mendt_2021,
  title = {Metabolic {{Reprogramming}} of {{GMP Grade Cord Tissue Derived Mesenchymal Stem Cells Enhances Their Suppressive Potential}} in {{GVHD}}},
  author = {Mendt, Mayela and Daher, May and Basar, Rafet and Shanley, Mayra and Kumar, Bijender and Wei Inng, Francesca Lim and Acharya, Sunil and Shaim, Hila and Fowlkes, Natalie and Tran, Jamie P. and Gokdemir, Elif and Uprety, Nadima and {Nunez-Cortes}, Ana K. and Ensley, Emily and Mai, Thao and Kerbauy, Lucila N. and {Melo-Garcia}, Luciana and Lin, Paul and Shen, Yifei and Mohanty, Vakul and Lu, JunJun and Li, Sufang and Nandivada, Vandana and Wang, Jing and Banerjee, Pinaki and {Reyes-Silva}, Francia and Liu, Enli and Ang, Sonny and Gilbert, April and Li, Ye and Wan, Xinhai and Gu, Jun and Zhao, Ming and Baran, Natalia and {Muniz-Feliciano}, Luis and Wilson, Jeffrey and Kaur, Indreshpal and Gagea, Mihai and Konopleva, Marina and Marin, David and Tang, Guilin and Chen, Ken and Champlin, Richard and Rezvani, Katayoun and Shpall, Elizabeth J.},
  year = 2021,
  month = may,
  journal = {Frontiers in Immunology},
  volume = {12},
  pages = {631353},
  issn = {1664-3224},
  doi = {10.3389/fimmu.2021.631353},
  urldate = {2026-07-13},
  abstract = {Acute graft-vs.-host (GVHD) disease remains a common complication of allogeneic stem cell transplantation with very poor outcomes once the disease becomes steroid refractory. Mesenchymal stem cells (MSCs) represent a promising therapeutic approach for the treatment of GVHD, but so far this strategy has had equivocal clinical efficacy. Therapies using MSCs require optimization taking advantage of the plasticity of these cells in response to different microenvironments. In this study, we aimed to optimize cord blood tissue derived MSCs (CBti MSCs) by priming them using a regimen of inflammatory cytokines. This approach led to their metabolic reprogramming with enhancement of their glycolytic capacity. Metabolically reprogrammed CBti MSCs displayed a boosted immunosuppressive potential, with superior immunomodulatory and homing properties, even after cryopreservation and thawing. Mechanistically, primed CBti MSCs significantly interfered with glycolytic switching and mTOR signaling in T cells, suppressing T cell proliferation and ensuing polarizing toward T regulatory cells. Based on these data, we generated a Good Manufacturing Process (GMP) Laboratory protocol for the production and cryopreservation of primed CBti MSCs for clinical use. Following thawing, these cryopreserved GMP-compliant primed CBti MSCs significantly improved outcomes in a xenogenic mouse model of GVHD. Our data support the concept that metabolic profiling of MSCs can be used as a surrogate for their suppressive potential in conjunction with conventional functional methods to support their therapeutic use in GVHD or other autoimmune disorders.},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/LXLCYPR7/Mendt et al. - 2021 - Metabolic Reprogramming of GMP Grade Cord Tissue Derived Mesenchymal Stem Cells Enhances Their Suppr.pdf}
}

@article{Meng_2018,
  title = {Hypoxia-Inducible Factor-1{$\alpha$} Is a Critical Transcription Factor for {{IL-10-producing B}} Cells in Autoimmune Disease},
  author = {Meng, Xianyi and Gr{\"o}tsch, Bettina and Luo, Yubin and Knaup, Karl Xaver and Wiesener, Michael Sean and Chen, Xiao-Xiang and Jantsch, Jonathan and Fillatreau, Simon and Schett, Georg and Bozec, Aline},
  year = 2018,
  month = jan,
  journal = {Nature Communications},
  volume = {9},
  number = {1},
  pages = {251},
  issn = {2041-1723},
  doi = {10.1038/s41467-017-02683-x},
  urldate = {2026-07-13},
  abstract = {Abstract                            Hypoxia-inducible factors (HIFs) are key elements for controlling immune cell metabolism and functions. While HIFs are known to be involved in T cells and macrophages activation, their functions in B lymphocytes are poorly defined. Here, we show that hypoxia-inducible factor-1{$\alpha$} (HIF-1{$\alpha$}) contributes to IL-10 production by B cells. HIF-1{$\alpha$} regulates IL-10 expression, and HIF-1{$\alpha$}-dependent glycolysis facilitates CD1d               hi               CD5               +               B cells expansion. Mice with B cell-specific deletion of               Hif1a               have reduced number of IL-10-producing B cells, which result in exacerbated collagen-induced arthritis and experimental autoimmune encephalomyelitis. Wild-type CD1d               hi               CD5               +               B cells, but not               Hif1a               -deficient CD1d               hi               CD5               +               B cells, protect recipient mice from autoimmune disease, while the protective function of               Hif1a               -deficient CD1d               hi               CD5               +               B cells is restored when their defective IL-10 expression is genetically corrected. Taken together, this study demonstrates the key function of the hypoxia-associated transcription factor HIF-1{$\alpha$} in driving IL-10 expression in CD1d               hi               CD5               +               B cells, and in controlling their protective activity in autoimmune disease.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/FV7GRHA6/Meng et al. - 2018 - Hypoxia-inducible factor-1α is a critical transcription factor for IL-10-producing B cells in autoim.pdf}
}

@article{Meng_2024,
  title = {Metabolic Rewiring Controlled by {{HIF-1$\alpha$}} Tunes {{IgA-producing B-cell}} Differentiation and Intestinal Inflammation},
  author = {Meng, Xianyi and {Asadi-Asadabad}, Sahar and Cao, Shan and Song, Rui and Lin, Zhen and Safhi, Mohammed and Qin, Yi and Tcheumi Tactoum, Estelle and Taudte, Verena and Ekici, Arif and Mielenz, Dirk and Wirtz, Stefan and Schett, Georg and Bozec, Aline},
  year = 2024,
  month = nov,
  journal = {Cellular \& Molecular Immunology},
  volume = {22},
  number = {1},
  pages = {54--67},
  issn = {2042-0226},
  doi = {10.1038/s41423-024-01233-y},
  urldate = {2026-07-13},
  abstract = {Abstract                            Germinal centers where B cells undergo clonal expansion and antibody affinity maturation are hypoxic microenvironments. However, the function of hypoxia-inducible factor (HIF)-1{$\alpha$} in immunoglobulin production remains incompletely characterized. Here, we demonstrated that B cells lacking HIF-1{$\alpha$} exhibited significantly lower glycolytic metabolism and impaired IgA production. Loss of HIF-1{$\alpha$} in B cells affects IgA-producing B-cell differentiation and exacerbates dextran sodium sulfate (DSS)-induced colitis. Conversely, promoting HIF-1{$\alpha$} stabilization via a PHD inhibitor roxadustat~enhances IgA class switching and alleviates intestinal inflammation. Mechanistically, HIF-1{$\alpha$} facilitates IgA class switching through acetyl-coenzyme A (acetyl-CoA) accumulation, which is essential for histone H3K27 acetylation at the S{$\alpha$} region. Consequently, supplementation with acetyl-CoA improved defective IgA production in               Hif1a               -deficient B cells and limited experimental colitis. Collectively, these findings highlight the critical importance of HIF-1{$\alpha$} in IgA class switching and the potential for targeting the HIF-1{$\alpha$}-dependent metabolic-epigenetic axis to treat inflammatory bowel diseases and other inflammatory disorders.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/RTGYS78P/Meng et al. - 2024 - Metabolic rewiring controlled by HIF-1α tunes IgA-producing B-cell differentiation and intestinal in.pdf}
}

