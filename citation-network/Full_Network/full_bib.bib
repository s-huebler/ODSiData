@article{Toubai_2020,
  title = {Immunopathology and Biology-Based Treatment of Steroid-Refractory Graft-versus-Host Disease},
  author = {Toubai, Tomomi and Magenau, John},
  year = 2020,
  month = jul,
  journal = {Blood},
  volume = {136},
  number = {4},
  pages = {429--440},
  issn = {0006-4971, 1528-0020},
  doi = {10.1182/blood.2019000953},
  urldate = {2026-07-13},
  abstract = {Abstract             Acute graft-versus-host disease (GVHD) is 1 of the major life-threating complications after allogeneic cell transplantation. Although steroids remain first-line treatment, roughly one-half of patients will develop steroid-refractory GVHD (SR-GVHD), which portends an extremely poor prognosis. Many agents that have shown encouraging response rates in early phase 1/2 trials for prevention and treatment have been unsuccessful in demonstrating a survival advantage when applied in the setting of SR-GVHD. The discovery of novel treatments has been further complicated by the absence of clinically informative animal models that address what may reflect a distinct pathophysiology. Nonetheless, the combined knowledge of established bone marrow transplantation models and recent human trials in SR-GVHD patients are beginning to illuminate novel mechanisms for inhibiting T-cell signaling and promoting tissue tolerance that provide an increased understanding of the underlying biology of SR-GVHD. Here, we discuss recent findings of newly appreciated cellular and molecular mechanisms and provide novel translational opportunities for advancing the effectiveness of treatment in SR-GVHD.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/XD328VMJ/Toubai and Magenau - 2020 - Immunopathology and biology-based treatment of steroid-refractory graft-versus-host disease.pdf}
}

@article{Touch_2022,
  title = {Human {{CD4}}+{{CD8$\alpha$}}+ {{Tregs}} Induced by {{Faecalibacterium}} Prausnitzii Protect against Intestinal Inflammation},
  author = {Touch, Sothea and Godefroy, Emmanuelle and Rolhion, Nathalie and Danne, Camille and Oeuvray, Cyriane and Straube, Marjol{\`e}ne and Galbert, Chlo{\'e} and Brot, Lo{\"i}c and Alonso Salgueiro, Iria and Chadi, Sead and Ledent, Tatiana and Chatel, Jean-Marc and Langella, Philippe and Jotereau, Francine and Altare, Fr{\'e}d{\'e}ric and Sokol, Harry},
  year = 2022,
  month = jun,
  journal = {JCI Insight},
  volume = {7},
  number = {12},
  pages = {e154722},
  issn = {2379-3708},
  doi = {10.1172/jci.insight.154722},
  urldate = {2026-07-13},
  abstract = {Abundance of               Faecalibacterium prausnitzii               , a dominant bacterium of the human microbiota that exhibits antiinflammatory effects, is decreased in patients with inflammatory bowel diseases (IBD). In humans, colonic lamina propria contains IL-10--secreting, Foxp3               --               Tregs characterized by a double expression of CD4 and CD8{$\alpha$} (DP8{$\alpha$}) and a specificity for               F. prausnitzii               . This Treg subset is decreased in IBD. The in vivo effect of DP8{$\alpha$} cells has not been evaluated yet to our knowledge. Here, using a humanized model of a NSG immunodeficient mouse strain that expresses the HLA D--related allele HLA-DR*0401 but not murine class II (NSG-Ab{$^\circ$} DR4) molecules, we demonstrated a protective effect of a HLA-DR*0401--restricted DP8{$\alpha$} Treg clone combined with               F. prausnitzii               administration in a colitis model. In a cohort of patients with IBD, we showed an independent association between the frequency of circulating DP8{$\alpha$} cells and disease activity. Finally, we pointed out a positive correlation between               F. prausnitzii               --specific DP8{$\alpha$} Tregs and the amount of               F. prausnitzii               in fecal microbiota in healthy individuals and patients with ileal Crohn's disease.                        ,},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/DMSU43QU/Touch et al. - 2022 - Human CD4+CD8α+ Tregs induced by Faecalibacterium prausnitzii protect against intestinal inflammatio.pdf}
}

