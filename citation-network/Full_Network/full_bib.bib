@article{Poltorak_1998,
  title = {Defective {{LPS Signaling}} in {{C3H}}/{{HeJ}} and {{C57BL}}/{{10ScCr Mice}}: {{Mutations}} in {{{\emph{Tlr4}}}} {{Gene}}},
  shorttitle = {Defective {{LPS Signaling}} in {{C3H}}/{{HeJ}} and {{C57BL}}/{{10ScCr Mice}}},
  author = {Poltorak, Alexander and He, Xiaolong and Smirnova, Irina and Liu, Mu-Ya and Huffel, Christophe Van and Du, Xin and Birdwell, Dale and Alejos, Erica and Silva, Maria and Galanos, Chris and Freudenberg, Marina and {Ricciardi-Castagnoli}, Paola and Layton, Betsy and Beutler, Bruce},
  year = 1998,
  month = dec,
  journal = {Science},
  volume = {282},
  number = {5396},
  pages = {2085--2088},
  issn = {0036-8075, 1095-9203},
  doi = {10.1126/science.282.5396.2085},
  urldate = {2026-07-13},
  abstract = {Mutations of the gene               Lps               selectively impede lipopolysaccharide (LPS) signal transduction in C3H/HeJ and C57BL/10ScCr mice, rendering them resistant to endotoxin yet highly susceptible to Gram-negative infection. The codominant               Lps                                d                              allele of C3H/HeJ mice was shown to correspond to a missense mutation in the third exon of the Toll-like receptor-4 gene (               Tlr4               ), predicted to replace proline with histidine at position 712 of the polypeptide chain. C57BL/10ScCr mice are homozygous for a null mutation of               Tlr4               . Thus, the mammalian Tlr4 protein has been adapted primarily to subserve the recognition of LPS and presumably transduces the LPS signal across the plasma membrane. Destructive mutations of               Tlr4               predispose to the development of Gram-negative sepsis, leaving most aspects of immune function intact.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

