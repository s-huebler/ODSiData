@article{Fletcher_2010,
  title = {Lymph Node Fibroblastic Reticular Cells Directly Present Peripheral Tissue Antigen under Steady-State and Inflammatory Conditions},
  author = {Fletcher, Anne L. and {Lukacs-Kornek}, Veronika and Reynoso, Erika D. and Pinner, Sophie E. and {Bellemare-Pelletier}, Angelique and Curry, Mark S. and Collier, Ai-Ris and Boyd, Richard L. and Turley, Shannon J.},
  year = 2010,
  month = apr,
  journal = {Journal of Experimental Medicine},
  volume = {207},
  number = {4},
  pages = {689--697},
  issn = {1540-9538, 0022-1007},
  doi = {10.1084/jem.20092642},
  urldate = {2026-07-13},
  abstract = {Lymph node stromal cells (LNSCs) can induce potent, antigen-specific T cell tolerance under steady-state conditions. Although expression of various peripheral tissue--restricted antigens (PTAs) and presentation to naive CD8+ T cells has been demonstrated, the stromal subsets responsible have not been identified. We report that fibroblastic reticular cells (FRCs), which reside in the T cell zone of the LN, ectopically express and directly present a model PTA to naive T cells, inducing their proliferation. However, we found that no single LNSC subset was responsible for PTA expression; rather, each subset had its own characteristic antigen display. Studies to date have concentrated on PTA presentation under steady-state conditions; however, because LNs are frequently inflammatory sites, we assessed whether inflammation altered stromal cell--T cell interactions. Strikingly, FRCs showed reduced stimulation of T cells after Toll-like receptor 3 ligation. We also characterize an LNSC subset expressing the highest levels of autoimmune regulator, which responds potently to bystander inflammation by up-regulating PTA expression. Collectively, these data show that diverse stromal cell types have evolved to constitutively express PTAs, and that exposure to viral products alters the interaction between T cells and LNSCs.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

@article{Flies_2015,
  title = {Mechanistic {{Assessment}} of {{PD-1H Coinhibitory Receptor}}--{{Induced T Cell Tolerance}} to {{Allogeneic Antigens}}},
  author = {Flies, Dallas B and Higuchi, Tomoe and Chen, Lieping},
  year = 2015,
  month = jun,
  journal = {The Journal of Immunology},
  volume = {194},
  number = {11},
  pages = {5294--5304},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.1402648},
  urldate = {2026-07-13},
  abstract = {Abstract             PD-1H is a recently identified cell surface coinhibitory molecule of the B7/CD28 immune modulatory gene family. We showed previously that single injection of a PD-1H agonistic mAb protected mice from graft-versus-host disease (GVHD). In this study, we report two distinct mechanisms operate in PD-1H--induced T cell tolerance. First, signaling via PD-1H coinhibitory receptor potently arrests alloreactive donor T cells from activation and expansion in the initiation phase. Second, donor regulatory T cells are subsequently expanded to maintain long-term tolerance and GVHD suppression. Our study reveals the crucial function of PD-1H as a coinhibitory receptor on alloreactive T cells and its function in the regulation of T cell tolerance. Therefore, PD-1H may be a target for the modulation of alloreactive T cells in GVHD and transplantation.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/KG7LSJCW/Flies et al. - 2015 - Mechanistic Assessment of PD-1H Coinhibitory Receptor–Induced T Cell Tolerance to Allogeneic Antigen.pdf}
}

