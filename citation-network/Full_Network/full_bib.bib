@article{Dominietto_2001,
  title = {Factors Influencing Haematological Recovery after Allogeneic Haemopoietic Stem Cell Transplants: Graft-versus-host Disease, Donor Type, Cytomegalovirus Infections and Cell Dose},
  shorttitle = {Factors Influencing Haematological Recovery after Allogeneic Haemopoietic Stem Cell Transplants},
  author = {Dominietto, Alida and Raiola, Anna Maria and Van Lint, Maria Teresa and Lamparelli, Teresa and Gualandi, Francesca and Berisso, Giovanni and Bregante, Stefania and Frassoni, Francesco and Casarino, Lucia and Verdiani, Simonetta and Bacigalupo, Andrea},
  year = 2001,
  month = jan,
  journal = {British Journal of Haematology},
  volume = {112},
  number = {1},
  pages = {219--227},
  issn = {0007-1048, 1365-2141},
  doi = {10.1046/j.1365-2141.2001.02468.x},
  urldate = {2026-07-13},
  abstract = {Platelet recovery after allogeneic haemopoietic stem cell transplant (HSCT) and predictive factors were analysed in 342 patients with haematological malignancies. All patients were prepared with cyclophosphamide plus total body irradiation, and received an unmanipulated HSCT from an HLA-identical sibling (               n               {$\quad$}={$\quad$}270), a matched unrelated donor (               n               {$\quad$}={$\quad$}67) or an identical twin (               n               {$\quad$}={$\quad$}5). The source of stem cells was peripheral blood (               n               {$\quad$}={$\quad$}15) or bone marrow (               n               {$\quad$}={$\quad$}327). Graft-vs.-host disease (GvHD) prophylaxis consisted of cyclosporin A with or without methotrexate. The proportion of patients with {$<\mkern1mu$}50{$\quad\times\quad$}10               9               /l platelets on d{$\quad$}+50, d{$\quad$}+100, d{$\quad$}+200 and d{$\quad$}+365 after HSCT was 26\%, 27\%, 14\% and 11\% respectively. Thrombocytopenia was independent of the degree of complete donor chimaerism. Four variables were predictive of platelet recovery: donor type, acute GvHD, cytomegalovirus (CMV) infection and number of cells infused at transplant. Recipients of an unrelated graft had lower platelet counts (49{$\quad\times\quad$}10               9               /l) on d{$\quad$}+50 than identical sibling grafts (108{$\quad\times\quad$}10               9               /l) (               P               {$\quad<\quad$}0{$\cdot$}001) and twin grafts (149{$\quad\times\quad$}10               9               /l) (               P               {$\quad<\quad$}0{$\cdot$}001). Patients with GvHD grades 0, I, II, III and IV had significantly different platelet counts on d{$\quad$}+50 (153{$\quad\times\quad$}10               9               /l, 102{$\quad\times\quad$}10               9               /l, 85{$\quad\times\quad$}10               9               /l, 32{$\quad\times\quad$}10               9               /l and 22{$\quad\times\quad$}10               9               /l;               P               {$\quad<\quad$}0{$\cdot$}001) and thereafter. Thrombocytopenia was more frequent in patients with high-level CMV antigenaemia ({$>\quad$}four positive cells/2{$\quad\times\quad$}10               5               ) (               P               {$\quad<\quad$}0{$\cdot$}0001) and in patients who received a low cell dose at transplant ({$\leq\quad$}4{$\cdot$}1{$\quad\times\quad$}10               8               /kg) (               P               {$\quad$}={$\quad$}0{$\cdot$}009). Platelet counts predicted transplant-related mortality (TRM) and were higher at all time intervals in patients surviving the transplant. Patients with grade II GvHD and {$>\mkern1mu$}50{$\quad\times\quad$}10               9               /l platelets had a lower TRM than patients with grade II GvHD and {$\leq\mkern1mu$}50{$\quad\times\quad$}10               9               /l platelets (14\% vs. 40\%,               P               {$\quad<\quad$}0{$\cdot$}0001).                          In conclusion, (i) a significant proportion of allogeneic HSCT recipients are thrombocytopenic long-term, irrespective of complete donor chimaerism, (ii) thrombocytopenia identifies patients at greater risk of lethal complications, and (iii) platelet recovery is influenced by GvHD, donor type, CMV infections and cell dose, not by stem cell source or other patient--disease-related variables.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

