@article{Li_2012,
  title = {Profound {{Depletion}} of {{Host Conventional Dendritic Cells}}, {{Plasmacytoid Dendritic Cells}}, and {{B Cells Does Not Prevent Graft-versus-Host Disease Induction}}},
  author = {Li, Hongmei and Demetris, Anthony J and McNiff, Jennifer and {Matte-Martone}, Catherine and Tan, Hung Sheng and Rothstein, David M and Lakkis, Fadi G and Shlomchik, Warren D},
  year = 2012,
  month = apr,
  journal = {The Journal of Immunology},
  volume = {188},
  number = {8},
  pages = {3804--3811},
  issn = {0022-1767, 1550-6606},
  doi = {10.4049/jimmunol.1102795},
  urldate = {2026-07-13},
  abstract = {Abstract             The efficacy of allogeneic hematopoietic stem cell transplantation is limited by graft-versus-host disease (GVHD). Host hematopoietic APCs are important initiators of GVHD, making them logical targets for GVHD prevention. Conventional dendritic cells (DCs) are key APCs for T cell responses in other models of T cell immunity, and they are sufficient for GVHD induction. However, we report in this article that in two polyclonal GVHD models in which host hematopoietic APCs are essential, GVHD was not decreased when recipient conventional DCs were inducibly or constitutively deleted. Additional profound depletion of plasmacytoid DCs and B cells, with or without partial depletion of CD11b+ cells, also did not ameliorate GVHD. These data indicate that, in contrast with pathogen models, there is a surprising redundancy as to which host cells can initiate GVHD. Alternatively, very low numbers of targeted APCs were sufficient. We hypothesize the difference in APC requirements in pathogen and GVHD models relates to the availability of target Ags. In antipathogen responses, specialized APCs are uniquely equipped to acquire and present exogenous Ags, whereas in GVHD, all host cells directly present alloantigens. These studies make it unlikely that reagent-based host APC depletion will prevent GVHD in the clinic.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/YLFEYUUF/Li et al. - 2012 - Profound Depletion of Host Conventional Dendritic Cells, Plasmacytoid Dendritic Cells, and B Cells D.pdf}
}

