@article{Gong_2019,
  title = {The Gut Microbiome and Response to Immune Checkpoint Inhibitors: Preclinical and Clinical Strategies},
  shorttitle = {The Gut Microbiome and Response to Immune Checkpoint Inhibitors},
  author = {Gong, Jun and Chehrazi-Raffle, Alexander and Placencio-Hickok, Veronica and Guan, Michelle and Hendifar, Andrew and Salgia, Ravi},
  year = 2019,
  month = dec,
  journal = {Clinical and Translational Medicine},
  volume = {8},
  number = {1},
  pages = {e9},
  issn = {2001-1326, 2001-1326},
  doi = {10.1186/s40169-019-0225-x},
  urldate = {2026-07-13},
  abstract = {Abstract             There is growing interest in identifying predictive biomarkers for inhibitors of programmed cell death protein 1 receptor (PD-1), programmed death ligand 1 (PD-L1), and cytotoxic T-lymphocyte associated protein 4 (CTLA-4). Given the links between the stool microbiota, anticancer immunosurveillance, and general health, the composition of the gut microbiome has recently undergone investigation as a biomarker for immunotherapy. In this review, we highlight published results from preclinical and clinical studies to date supporting a relationship between the gut microbiome and antitumor efficacy of immune checkpoint inhibitors. Despite the promising and hypothesis-generating findings that have been produced in this arena to date, there remain some inconsistencies amongst present data that may need to be resolved to contribute to further development. Among these, a better understanding of the immunomodulatory function of the microbiome, standardization in sampling, sequencing techniques, and data analysis, and ensuring uniformity across various aspects of study design are warranted in conducting future prospective studies seeking to validate the gut microbiome as a potential biomarker of response to checkpoint blockade.},
  copyright = {http://creativecommons.org/licenses/by/4.0/},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/K3926W2Y/Gong et al. - 2019 - The gut microbiome and response to immune checkpoint inhibitors preclinical and clinical strategies.pdf}
}

