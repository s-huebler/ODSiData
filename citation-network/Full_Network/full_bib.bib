@article{Perezpaya_2024,
  title = {Molecular Screening of Transitional {{B}} Cells as a Prognostic Marker of Improved Graft Outcome and Reduced Rejection Risk in Kidney Transplant},
  author = {Perezpay{\'a}, In{\'e}s and Garcia, Sergio G. and {Clos-Sansalvador}, Marta and {Sanroque-Mu{\~n}oz}, Marta and {Font-Mor{\'o}n}, Miriam and {Rodr{\'i}guez-Mart{\'i}nez}, Paula and {Vila-Santandreu}, Anna and Bover, Jordi and Borr{\`a}s, Francesc E. and Ca{\~n}as, Laura and Franquesa, Marcella},
  year = 2024,
  month = aug,
  journal = {Frontiers in Immunology},
  volume = {15},
  pages = {1433832},
  issn = {1664-3224},
  doi = {10.3389/fimmu.2024.1433832},
  urldate = {2026-07-13},
  abstract = {Introduction               Understanding immune cell dynamics in kidney transplantation may provide insight into the mechanisms of rejection and improve patient management. B cells have gained interest with a special relevance of the ``regulatory'' subsets and their graft outcome prognostic value. In this study, we aimed to prove that the direct immunophenotyping and target gene expression analysis of kidney transplant patients' fresh whole blood will help to identify graft rejection risk and assist in the monitoring of kidney transplanted patients.                                         Methods                                We employed flow cytometry and qPCR techniques to characterize B and T cell subsets within fresh whole blood samples, with particular emphasis on transitional B cells (TrB) identified as CD19                 +                 CD24                 hi                 CD38                 hi                 . TrB are a relevant population in the context of kidney transplantation and are closely associated with regulatory B cells (Bregs) in humans. Patients were monitored, tracking pertinent clinical parameters and kidney-related events, including alterations in graft function and episodes of biopsy proven rejection.                                                        Results               Higher percentages of TrB cells at 3 months after transplantation were positively associated with better graft outcomes and lower biopsy-proven acute rejection risk. Furthermore, a novel panel of B cell regulatory associated genes was validated at 3 months post-transplantation by qPCR analysis of peripheral blood mononuclear cell (PBMC) mRNA, showing high predictive power of graft events and prognostic value.                                         Discussion               These findings suggest that monitoring TrB may provide interesting patient management information, improve transplant outcomes, and allow for personalized drug regimens to minimize clinical complications.},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/PY9ZC9MB/Perezpayá et al. - 2024 - Molecular screening of transitional B cells as a prognostic marker of improved graft outcome and red.pdf}
}

