@article{Jagasia_2012,
  title = {Risk Factors for Acute {{GVHD}} and Survival after Hematopoietic Cell Transplantation},
  author = {Jagasia, Madan and Arora, Mukta and Flowers, Mary E. D. and Chao, Nelson J. and McCarthy, Philip L. and Cutler, Corey S. and {Urbano-Ispizua}, Alvaro and Pavletic, Steven Z. and Haagenson, Michael D. and Zhang, Mei-Jie and Antin, Joseph H. and Bolwell, Brian J. and Bredeson, Christopher and Cahn, Jean-Yves and Cairo, Mitchell and Gale, Robert Peter and Gupta, Vikas and Lee, Stephanie J. and Litzow, Mark and Weisdorf, Daniel J. and Horowitz, Mary M. and Hahn, Theresa},
  year = 2012,
  month = jan,
  journal = {Blood},
  volume = {119},
  number = {1},
  pages = {296--307},
  issn = {0006-4971, 1528-0020},
  doi = {10.1182/blood-2011-06-364265},
  urldate = {2026-07-13},
  abstract = {Abstract             Risk factors for acute GVHD (AGVHD), overall survival, and transplant-related mortality were evaluated in adults receiving allogeneic hematopoietic cell transplants (1999-2005) from HLA-identical sibling donors (SDs; n = 3191) or unrelated donors (URDs; n = 2370) and reported to the Center for International Blood and Marrow Transplant Research, Minneapolis, MN. To understand the impact of transplant regimen on AGVHD risk, 6 treatment categories were evaluated: (1) myeloablative conditioning (MA) with total body irradiation (TBI) + PBSCs, (2) MA + TBI + BM, (3) MA + nonTBI + PBSCs, (4) MA + nonTBI + BM, (5) reduced intensity conditioning (RIC) + PBSCs, and (6) RIC + BM. The cumulative incidences of grades B-D AGVHD were 39\% (95\% confidence interval [CI], 37\%-41\%) in the SD cohort and 59\% (95\% CI, 57\%-61\%) in the URD cohort. Patients receiving SD transplants with MA + nonTBI + BM and RIC + PBSCs had significantly lower risks of grades B-D AGVHD than patients in other treatment categories. Those receiving URD transplants with MA + TBI + BM, MA + nonTBI + BM, RIC + BM, or RIC + PBSCs had lower risks of grades B-D AGVHD than those in other treatment categories. The 5-year probabilities of survival were 46\% (95\% CI, 44\%-49\%) with SD transplants and 33\% (95\% CI, 31\%-35\%) with URD transplants. Conditioning intensity, TBI and graft source have a combined effect on risk of AGVHD that must be considered in deciding on a treatment strategy for individual patients.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

