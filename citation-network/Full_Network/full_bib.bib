@article{Dambuza_2017,
  title = {{{IL-12p35}} Induces Expansion of {{IL-10}} and {{IL-35-expressing}} Regulatory {{B}} Cells and Ameliorates Autoimmune Disease},
  author = {Dambuza, Ivy M. and He, Chang and Choi, Jin Kyeong and Yu, Cheng-Rong and Wang, Renxi and Mattapallil, Mary J. and Wingfield, Paul T. and Caspi, Rachel R. and Egwuagu, Charles E.},
  year = 2017,
  month = sep,
  journal = {Nature Communications},
  volume = {8},
  number = {1},
  pages = {719},
  issn = {2041-1723},
  doi = {10.1038/s41467-017-00838-4},
  urldate = {2026-07-13},
  abstract = {Abstract             Interleukin 35 (IL-35) is a heterodimeric cytokine composed of IL-12p35 and Ebi3 subunits. IL-35 suppresses autoimmune diseases while preventing host defense to infection and promoting tumor growth and metastasis by converting resting B and T cells into IL-10-producing and IL-35-producing regulatory B (Breg)~and T (Treg)~cells. Despite sharing the IL-12p35 subunit, IL-12 (IL-12p35/IL-12p40) promotes inflammatory responses whereas IL-35 (IL-12p35/Ebi3) induces regulatory responses, suggesting that IL-12p35 may have unknown intrinsic immune-regulatory functions regulated by its heterodimeric partner. Here we show that the IL-12p35 subunit has immunoregulatory functions hitherto attributed to IL-35. IL-12p35 suppresses lymphocyte proliferation, induces expansion of IL-10-expressing and IL-35-expressing B cells and ameliorates autoimmune uveitis in mice by antagonizing pathogenic Th17 responses. Recapitulation of essential immunosuppressive activities of IL-35 indicates that IL-12p35 may be utilized for in vivo expansion of Breg cells and autologous Breg cell immunotherapy. Furthermore, our uveitis data suggest that intrinsic immunoregulatory activities of other single chain IL-12 subunits might be exploited to treat other autoimmune diseases.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/WSE8LWSJ/Dambuza et al. - 2017 - IL-12p35 induces expansion of IL-10 and IL-35-expressing regulatory B cells and ameliorates autoimmu.pdf}
}

