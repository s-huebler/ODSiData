@article{Cryan_2019,
  title = {The {{Microbiota-Gut-Brain Axis}}},
  author = {Cryan, John F. and O'Riordan, Kenneth J. and Cowan, Caitlin S. M. and Sandhu, Kiran V. and Bastiaanssen, Thomaz F. S. and Boehme, Marcus and Codagnone, Martin G. and Cussotto, Sofia and Fulling, Christine and Golubeva, Anna V. and Guzzetta, Katherine E. and Jaggar, Minal and {Long-Smith}, Caitriona M. and Lyte, Joshua M. and Martin, Jason A. and {Molinero-Perez}, Alicia and Moloney, Gerard and Morelli, Emanuela and Morillas, Enrique and O'Connor, Rory and {Cruz-Pereira}, Joana S. and Peterson, Veronica L. and Rea, Kieran and Ritz, Nathaniel L. and Sherwin, Eoin and Spichak, Simon and Teichman, Emily M. and Van De Wouw, Marcel and {Ventura-Silva}, Ana Paula and {Wallace-Fitzsimons}, Shauna E. and Hyland, Niall and Clarke, Gerard and Dinan, Timothy G.},
  year = 2019,
  month = oct,
  journal = {Physiological Reviews},
  volume = {99},
  number = {4},
  pages = {1877--2013},
  issn = {0031-9333, 1522-1210},
  doi = {10.1152/physrev.00018.2018},
  urldate = {2026-07-13},
  abstract = {The importance of the gut-brain axis in maintaining homeostasis has long been appreciated. However, the past 15 yr have seen the emergence of the microbiota (the trillions of microorganisms within and on our bodies) as one of the key regulators of gut-brain function and has led to the appreciation of the importance of a distinct microbiota-gut-brain axis. This axis is gaining ever more traction in fields investigating the biological and physiological basis of psychiatric, neurodevelopmental, age-related, and neurodegenerative disorders. The microbiota and the brain communicate with each other via various routes including the immune system, tryptophan metabolism, the vagus nerve and the enteric nervous system, involving microbial metabolites such as short-chain fatty acids, branched chain amino acids, and peptidoglycans. Many factors can influence microbiota composition in early life, including infection, mode of birth delivery, use of antibiotic medications, the nature of nutritional provision, environmental stressors, and host genetics. At the other extreme of life, microbial diversity diminishes with aging. Stress, in particular, can significantly impact the microbiota-gut-brain axis at all stages of life. Much recent work has implicated the gut microbiota in many conditions including autism, anxiety, obesity, schizophrenia, Parkinson's disease, and Alzheimer's disease. Animal models have been paramount in linking the regulation of fundamental neural processes, such as neurogenesis and myelination, to microbiome activation of microglia. Moreover, translational human studies are ongoing and will greatly enhance the field. Future studies will focus on understanding the mechanisms underlying the microbiota-gut-brain axis and attempt to elucidate microbial-based intervention and therapeutic strategies for neuropsychiatric disorders.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/PA8W6B9Y/Cryan et al. - 2019 - The Microbiota-Gut-Brain Axis.pdf}
}

