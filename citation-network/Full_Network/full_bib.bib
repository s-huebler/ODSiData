@article{Lappas_2009,
  title = {Adenosine {{A2A}} Receptor Activation Limits Graft-versus-Host Disease after Allogenic Hematopoietic Stem Cell Transplantation},
  author = {Lappas, Courtney M and Liu, Po-Ching and Linden, Joel and Kang, Elizabeth M and Malech, Harry L},
  year = 2009,
  month = nov,
  journal = {Journal of Leukocyte Biology},
  volume = {87},
  number = {2},
  pages = {345--354},
  issn = {1938-3673, 0741-5400},
  doi = {10.1189/jlb.0609388},
  urldate = {2026-07-13},
  abstract = {Abstract             The selective activation of the A2A has therapeutic potential in both the prevention and treatment of acute GVHD.             GVHD is a major barrier to broader use of allogenic HSCT for nonmalignancy clinical applications such as the treatment of primary immunodeficiencies and hemoglobinopathies. We show in a murine model of C57BL/6J (H2-kb) {$\rightarrow$} B6D2F1/J (H2-kb/d) acute GVHD that when initiated 2 days before transplant, the activation of the adenosine A2AR with the selective agonist ATL146e inhibits the weight loss and mortality associated with disease progression. Furthermore, circulating levels of proinflammatory cytokines and chemokines, including IFN-{$\gamma$}, IL-6, CCL2, KC, and G-CSF, are reduced significantly by 14-day ATL146e treatment. The up-regulation of CD25, CD69, and CD40L expression by donor CD4+ and CD8+ T cells is inhibited by A2AR activation; fewer CD3+ T cells are found in the liver, skin, and colon of ATL146e-treated mice as compared with vehicle-treated controls; and associated tissue injury is lessened. The delayed administration of ATL146e, beginning 9 days after HSCT, reverses GVHD-associated body weight loss successfully, and improvement is sustained for the duration of treatment. We conclude that the selective activation of the A2AR has therapeutic potential in the prevention and treatment of acute GVHD.},
  copyright = {https://academic.oup.com/pages/standard-publication-reuse-rights},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/HWFX5FGW/Lappas et al. - 2009 - Adenosine A2A receptor activation limits graft-versus-host disease after allogenic hematopoietic ste.pdf}
}

