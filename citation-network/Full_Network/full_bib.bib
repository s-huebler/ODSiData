@article{Cutler_2021,
  title = {Belumosudil for Chronic Graft-versus-Host Disease after 2 or More Prior Lines of Therapy: The {{ROCKstar Study}}},
  shorttitle = {Belumosudil for Chronic Graft-versus-Host Disease after 2 or More Prior Lines of Therapy},
  author = {Cutler, Corey and Lee, Stephanie J. and Arai, Sally and Rotta, Marcello and Zoghi, Behyar and Lazaryan, Aleksandr and Ramakrishnan, Aravind and DeFilipp, Zachariah and Salhotra, Amandeep and {Chai-Ho}, Wanxing and Mehta, Rohtesh and Wang, Trent and Arora, Mukta and Pusic, Iskra and Saad, Ayman and Shah, Nirav N. and Abhyankar, Sunil and Bachier, Carlos and Galvin, John and Im, Annie and Langston, Amelia and Liesveld, Jane and Juckett, Mark and Logan, Aaron and Schachter, Levanto and Alavi, Asif and Howard, Dianna and Waksal, Harlan W. and Ryan, John and Eiznhamer, David and Aggarwal, Sanjay K. and Ieyoub, Jonathan and Schueller, Olivier and Green, Laurie and Yang, Zhongming and Krenz, Heidi and Jagasia, Madan and Blazar, Bruce R. and Pavletic, Steven},
  year = 2021,
  month = dec,
  journal = {Blood},
  volume = {138},
  number = {22},
  pages = {2278--2289},
  issn = {0006-4971, 1528-0020},
  doi = {10.1182/blood.2021012021},
  urldate = {2026-07-13},
  abstract = {Abstract             Belumosudil, an investigational oral selective inhibitor of Rho-associated coiled-coil--containing protein kinase 2 (ROCK2), reduces type 17 and follicular T helper cells via downregulation of STAT3 and enhances regulatory T cells via upregulation of STAT5. Belumosudil may effectively treat patients with chronic graft-versus-host disease (cGVHD), a major cause of morbidity and late nonrelapse mortality after an allogeneic hematopoietic cell transplant. This phase 2 randomized multicenter registration study evaluated belumosudil 200 mg daily (n = 66) and 200 mg twice daily (n = 66) in subjects with cGVHD who had received 2 to 5 prior lines of therapy. The primary end point was best overall response rate (ORR). Duration of response (DOR), changes in Lee Symptom Scale score, failure-free survival, corticosteroid dose reductions, and overall survival were also evaluated. Overall median follow-up was 14 months. The best ORR for belumosudil 200 mg daily and 200 mg twice daily was 74\% (95\% confidence interval [CI], 62-84) and 77\% (95\% CI, 65-87), respectively, with high response rates observed in all subgroups. All affected organs demonstrated complete responses. The median DOR was 54 weeks; 44\% of subjects have remained on therapy for {$\geq$}1 year. Symptom reduction with belumosudil 200 mg daily and 200 mg twice daily was reported in 59\% and 62\% of subjects, respectively. Adverse events (AEs) were consistent with those expected in patients with cGVHD receiving corticosteroids and other immunosuppressants. Sixteen subjects (12\%) discontinued belumosudil because of possible drug-related AEs. Belumosudil, a promising therapy for cGVHD, was well tolerated with clinically meaningful responses. This trial was registered at www.clinicaltrials.gov as \#NCT03640481.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/GNZ7BPTA/Cutler et al. - 2021 - Belumosudil for chronic graft-versus-host disease after 2 or more prior lines of therapy the ROCKst.pdf}
}

