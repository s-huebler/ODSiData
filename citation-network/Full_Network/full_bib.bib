@article{Benichou_1992,
  title = {Donor Major Histocompatibility Complex ({{MHC}}) Peptides Are Presented by Recipient {{MHC}} Molecules during Graft Rejection.},
  author = {Benichou, G and Takizawa, P A and Olson, C A and McMillan, M and Sercarz, E E},
  year = 1992,
