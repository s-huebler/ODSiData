@article{Carpenter_2024,
  title = {Decreasing Chronic Graft-versus-Host Disease Rates in All Populations},
  author = {Carpenter, Paul A. and Gooley, Ted A. and Boiko, Julie and Lee, Catherine J. and Burroughs, Lauri M. and Mehta, Rohtesh and Salit, Rachel B. and Bhatt, Neel S. and Krakow, Elizabeth and Dahlberg, Ann E. and Yeh, Albert C. and Summers, Corinne N. and Ueda Oshima, Masumi and Petersdorf, Effie W. and Vo, Phuong and {Connelly-Smith}, Laura and Lee, Stephanie J.},
  year = 2024,
  month = nov,
  journal = {Blood Advances},
  volume = {8},
  number = {22},
  pages = {5829--5837},
  issn = {2473-9529, 2473-9537},
  doi = {10.1182/bloodadvances.2024012722},
  urldate = {2026-07-13},
  abstract = {Abstract               Since 2005, there has been a steady decline in chronic graft-versus-host disease (cGVHD) at the Fred Hutchinson Cancer Center. To better understand this phenomenon, we studied the risk of cGVHD requiring systemic immunosuppression (cGVHD-IS) as a function of hematopoietic cell transplantation (HCT) date in 3066 survivors from 2005 through 2019. Cox regression models were fit to assess associations of HCT date (as a continuous linear variable) with cause-specific hazards of cGVHD using unadjusted and adjusted models. Median follow-up for study subjects was 7.0 years (range, 1.0-17.2). Two-year probabilities of cGVHD-IS declined among all survivors from 45\% to 52\% (2005-2007) to {$\sim$}40\% (2008-2012) and then further to {$\sim$}26\% by 2017. A decline was also observed when the analysis was restricted to 502 pediatric survivors, with cGVHD-IS probabilities \&lt;10\% since 2013. Among 305 adult and pediatric survivors who underwent transplantation for nonmalignant diseases, cGVHD rates showed greater fluctuation but remained \&lt;20\% after 2016. Each 5-year increase in HCT date was associated with a 27\% decrease in the cause-specific hazard of cGVHD (unadjusted hazard ratio [HR], 0.73; 95\% confidence interval [CI], 0.68-0.78; P~\&lt;~.0001); the HR was 0.81 (95\%~CI, 0.75-0.87; P~\&lt; .0001) even after adjusting for various factors (age, donor/stem-cell source, race, sex, conditioning intensity, GVHD prophylaxis, among others) that could lead to cGVHD reduction. The decline in cGVHD was not fully explained by demographic shifts and greater use of HCT approaches that are generally associated with lower cGVHD rates. This observation underscores that single-cohort cGVHD prevention studies should use contemporaneous and not historical controls for comparison.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/C8ETW7LW/Carpenter et al. - 2024 - Decreasing chronic graft-versus-host disease rates in all populations.pdf}
}

@article{Carr_2020,
  title = {Patients {{Undergoing Myeloablative Chemotherapy}} and {{Hematopoietic Stem Cell Transplantation Exhibit Depleted Vitamin C Status}} in {{Association}} with {{Febrile Neutropenia}}},
  author = {Carr, Anitra C. and Spencer, Emma and Das, Andrew and Meijer, Natalie and Lauren, Carolyn and MacPherson, Sean and Chambers, Stephen T.},
  year = 2020,
  month = jun,
  journal = {Nutrients},
  volume = {12},
  number = {6},
  pages = {1879},
  issn = {2072-6643},
  doi = {10.3390/nu12061879},
  urldate = {2026-07-13},
  abstract = {Patients undergoing myeloablative chemotherapy and hematopoietic stem cell transplantation (HSCT) experience profound neutropenia and vulnerability to infection. Previous research has indicated that patients with infections have depleted vitamin C status. In this study, we recruited 38 patients with hematopoietic cancer who were undergoing conditioning chemotherapy and HSCT. Blood samples were collected prior to transplantation, at one week, two weeks and four weeks following transplantation. Vitamin C status and biomarkers of inflammation (C-reactive protein) and oxidative stress (protein carbonyls and thiobarbituric acid reactive substances) were assessed in association with febrile neutropenia. The vitamin C status of the study participants decreased from 44 \textpm{} 7 \textmu mol/L to 29 \textpm{} 5 \textmu mol/L by week one (p = 0.001) and 19 \textpm{} 6 \textmu mol/L by week two (p {$<$} 0.001), by which time all of the participants had undergone a febrile episode. By week four, vitamin C status had increased to 37 \textpm{} 10 \textmu mol/L (p = 0.1). Pre-transplantation, the cohort comprised 19\% with hypovitaminosis C (i.e., {$<$}23 \textmu mol/L) and 8\% with deficiency (i.e., {$<$}11 \textmu mol/L). At week one, those with hypovitaminosis C had increased to 38\%, and at week two, 72\% had hypovitaminosis C, and 34\% had outright deficiency. C-reactive protein concentrations increased from 3.5 \textpm{} 1.8 mg/L to 20 \textpm{} 11 mg/L at week one (p = 0.002), and 119 \textpm{} 25 mg/L at week two (p {$<$} 0.001), corresponding to the development of febrile neutropenia in the patients. By week four, these values had dropped to 17 \textpm{} 8 mg/L (p {$<$} 0.001). There was a significant inverse correlation between C-reactive protein concentrations and vitamin C status (r = -0.424, p {$<$} 0.001). Lipid oxidation (thiobarbituric acid reactive substances (TBARS)) increased significantly from 2.0 \textpm{} 0.3 \textmu mol/L at baseline to 3.3 \textpm{} 0.6 \textmu mol/L by week one (p {$<$} 0.001), and remained elevated at week two (p = 0.003), returning to baseline concentrations by week four (p = 0.3). Overall, the lowest mean vitamin C values (recorded at week two) corresponded with the highest mean C-reactive protein values and lowest mean neutrophil counts. Thus, depleted vitamin C status in the HSCT patients coincides with febrile neutropenia and elevated inflammation and oxidative stress.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator}
}

