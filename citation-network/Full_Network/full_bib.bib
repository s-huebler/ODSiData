@article{Pluznick_2013,
  title = {Olfactory Receptor Responding to Gut Microbiota-Derived Signals Plays a Role in Renin Secretion and Blood Pressure Regulation},
  author = {Pluznick, Jennifer L. and Protzko, Ryan J. and Gevorgyan, Haykanush and Peterlin, Zita and Sipos, Arnold and Han, Jinah and Brunet, Isabelle and Wan, La-Xiang and Rey, Federico and Wang, Tong and Firestein, Stuart J. and Yanagisawa, Masashi and Gordon, Jeffrey I. and Eichmann, Anne and {Peti-Peterdi}, Janos and Caplan, Michael J.},
