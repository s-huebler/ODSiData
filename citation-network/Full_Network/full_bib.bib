  author = {Sun, Jing and Shi, Le and Xiao, Tian and Xue, Junchao and Li, Junjie and Wang, Peiwen and Wu, Lu and Dai, Xiangyu and Ni, Xinye and Liu, Qizhan},
  year = 2021,
  month = mar,
  journal = {Chemosphere},
  volume = {266},
