@article{Stohs_2024,
  title = {Approach to Febrile Neutropenia in Patients Undergoing Treatments for Hematologic Malignancies},
  author = {Stohs, Erica J. and Abbas, Anum and Freifeld, Alison},
  year = 2024,
  month = apr,
  journal = {Transplant Infectious Disease},
  volume = {26},
  number = {2},
  pages = {e14236},
  issn = {1398-2273, 1399-3062},
  doi = {10.1111/tid.14236},
  urldate = {2026-07-13},
  abstract = {Abstract             Febrile neutropenia (FN) is common among hematologic malignancy patients, including recipients of hematopoietic cell transplantation (HCT) and cellular therapies such as chimeric antigen receptor (CAR)-T-cell therapy. Prompt empiric antibiotic use has been the mainstay for decades but a ``one-size-fits-all'' approach is no longer broadly accepted, as treatment-related infectious risk are more understood. Growing antimicrobial resistance is an increasing clinical challenge. Evolving strategies on de-escalation of broad-spectrum antibiotics in FN without identified infection are areas of particular interest.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/UL6L93LU/Stohs et al. - 2024 - Approach to febrile neutropenia in patients undergoing treatments for hematologic malignancies.pdf}
}

