  doi = {10.1084/jem.20190295},
  urldate = {2026-07-13},
  abstract = {Type III IFNs, or IFN-{$\lambda$}, are the newest members of the IFN family and were long believed to play roles that were redundant with those of type I IFNs. However, IFN-{$\lambda$} displays unique traits that delineate them as primary protectors of barrier integrity at mucosal sites. This unique role stems both from the restricted expression of IFN-{$\lambda$} receptor, confined to epithelial cells and to a limited pool of immune cells, and from unique immunomodulatory properties of IFN-{$\lambda$}. Here, we discuss recent findings that establish the unique capacity of IFN-{$\lambda$} to act at the barriers of the host to balance tissue tolerance and immune resistance against viral and bacterial challenges.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/5567YP5B/Broggi et al. - 2020 - Type III interferons Balancing tissue tolerance and resistance to pathogen invasion.pdf}
}

