@article{Zama_2020,
  title = {Insights into the Role of Intestinal Microbiota in Hematopoietic Stem-Cell Transplantation},
  author = {Zama, Daniele and Boss{\`u}, Gianluca and Leardini, Davide and Muratore, Edoardo and Biagi, Elena and Prete, Arcangelo and Pession, Andrea and Masetti, Riccardo},
