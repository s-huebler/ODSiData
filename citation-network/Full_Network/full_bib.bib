@article{Xiong_2022,
  title = {Health {{Benefits}} and {{Side Effects}} of {{Short-Chain Fatty Acids}}},
  author = {Xiong, Ruo-Gu and Zhou, Dan-Dan and Wu, Si-Xia and Huang, Si-Yu and Saimaiti, Adila and Yang, Zhi-Jun and Shang, Ao and Zhao, Cai-Ning and Gan, Ren-You and Li, Hua-Bin},
