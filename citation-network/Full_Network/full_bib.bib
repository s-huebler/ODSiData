@article{Ianiro_2016,
  title = {Antibiotics as Deep Modulators of Gut Microbiota: Between Good and Evil},
  shorttitle = {Antibiotics as Deep Modulators of Gut Microbiota},
  author = {Ianiro, Gianluca and Tilg, Herbert and Gasbarrini, Antonio},
  year = 2016,
  month = nov,
  journal = {Gut},
  volume = {65},
  number = {11},
  pages = {1906--1915},
  issn = {0017-5749, 1468-3288},
  doi = {10.1136/gutjnl-2016-312297},
  urldate = {2026-07-13},
  abstract = {The recent increase in our knowledge of human gut microbiota has changed our view on antibiotics. Antibiotics are, indeed, no longer considered only beneficial, but also potentially harmful drugs, as their abuse appears to play a role in the pathogenesis of several disorders associated with microbiota impairment (eg,               Clostridium difficile               infection or metabolic disorders). Both drug-related factors (such as antibiotic class, timing of exposure or route of administration) and host-related factors appear to influence the alterations of human gut microbiota produced by antibiotics. Nevertheless, antibiotics are nowadays considered a reliable therapy for some non-communicable disorders, including IBS or hepatic encephalopathy. Moreover, some antibiotics can also act positively on gut microbiota, providing a so-called `eubiotic' effect, by increasing abundance of beneficial bacteria. Therefore, antibiotics appear to change, for better or worse, the nature of several disorders, including IBS, IBD, metabolic disorders or liver disease. This reviews aims to address the potential of antibiotics in the development of major non-communicable disorders associated with the alteration of gut microbiota and on newly discovered therapeutic avenues of antibiotics beyond the cure of infectious diseases.},
  langid = {english},
  keywords = {Metadata Updated,Via Zotero Translator},
  file = {/Users/sophiehuebler/Zotero/storage/3VAMII22/Ianiro et al. - 2016 - Antibiotics as deep modulators of gut microbiota between good and evil.pdf}
}

